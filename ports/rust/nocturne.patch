diff --git a/library/std/src/sys/stdio/nocturne.rs b/library/std/src/sys/stdio/nocturne.rs
new file mode 100644
index 0000000..e53295a
--- /dev/null
+++ b/library/std/src/sys/stdio/nocturne.rs
@@ -0,0 +1,193 @@
+//! Standard streams on Nocturne.
+//!
+//! Output goes through the C library's `stdout`/`stderr` streams, which know
+//! whether the launcher gave a channel (a terminal or pipe: one message per
+//! write) or a document (appended to). Input reads handle 0 directly: a
+//! message channel is read a message at a time, with the rest of a message
+//! larger than the caller's buffer kept for the next read; a document is read
+//! from a position std keeps itself (there is no shared cursor).
+
+use crate::io::{self, IoSlice};
+use crate::sync::Mutex;
+use crate::sys::pal::abi;
+
+pub struct Stdin;
+pub struct Stdout;
+pub struct Stderr;
+
+struct StdinState {
+    /// 0: not asked yet, otherwise `N_KIND_*` of handle 0 (u32::MAX: no handle).
+    kind: u32,
+    pos: u64,
+    /// The unread part of a message that did not fit the reader's buffer.
+    carry: Vec<u8>,
+    carry_pos: usize,
+}
+
+static STDIN: Mutex<StdinState> =
+    Mutex::new(StdinState { kind: 0, pos: 0, carry: Vec::new(), carry_pos: 0 });
+
+impl Stdin {
+    pub const fn new() -> Stdin {
+        Stdin
+    }
+}
+
+impl io::Read for Stdin {
+    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
+        if buf.is_empty() {
+            return Ok(0);
+        }
+        // Whatever was written to the terminal should be visible before waiting for input.
+        unsafe { abi::fflush(abi::stdout) };
+        let mut st = STDIN.lock().unwrap_or_else(|e| e.into_inner());
+        if st.carry_pos < st.carry.len() {
+            let n = buf.len().min(st.carry.len() - st.carry_pos);
+            buf[..n].copy_from_slice(&st.carry[st.carry_pos..st.carry_pos + n]);
+            st.carry_pos += n;
+            if st.carry_pos == st.carry.len() {
+                st.carry.clear();
+                st.carry_pos = 0;
+            }
+            return Ok(n);
+        }
+        if st.kind == 0 {
+            let k = unsafe { abi::n_handle_kind(0) };
+            st.kind = if k < 0 { u32::MAX } else { k as u32 };
+        }
+        match st.kind {
+            abi::N_KIND_DOCUMENT => {
+                let r = unsafe {
+                    abi::n_document_read_at(0, st.pos, buf.as_mut_ptr().cast(), buf.len())
+                };
+                let n = crate::sys::cvt(r)? as usize;
+                st.pos += n as u64;
+                Ok(n)
+            }
+            u32::MAX => Ok(0),
+            _ => loop {
+                let r = unsafe {
+                    abi::n_channel_receive(
+                        0,
+                        buf.as_mut_ptr().cast(),
+                        buf.len(),
+                        abi::N_CHANNEL_WAIT,
+                        crate::ptr::null_mut(),
+                    )
+                };
+                if r == -(abi::N_ERR_CLOSED as i64) {
+                    return Ok(0);
+                }
+                if r == -(abi::N_ERR_TOO_LARGE as i64) {
+                    // Take the whole message and hand it out in pieces.
+                    let size = crate::sys::cvt(unsafe {
+                        abi::n_channel_receive(
+                            0,
+                            crate::ptr::null_mut(),
+                            0,
+                            abi::N_CHANNEL_WAIT | abi::N_CHANNEL_PEEK,
+                            crate::ptr::null_mut(),
+                        )
+                    })? as usize;
+                    let mut whole = vec![0u8; size];
+                    let got = crate::sys::cvt(unsafe {
+                        abi::n_channel_receive(
+                            0,
+                            whole.as_mut_ptr().cast(),
+                            size,
+                            abi::N_CHANNEL_WAIT,
+                            crate::ptr::null_mut(),
+                        )
+                    })? as usize;
+                    whole.truncate(got);
+                    let n = buf.len().min(whole.len());
+                    buf[..n].copy_from_slice(&whole[..n]);
+                    st.carry = whole;
+                    st.carry_pos = n;
+                    return Ok(n);
+                }
+                let n = crate::sys::cvt(r)? as usize;
+                // An empty message carries no bytes: wait for the next one.
+                if n != 0 {
+                    return Ok(n);
+                }
+            },
+        }
+    }
+
+}
+
+impl Stdout {
+    pub const fn new() -> Stdout {
+        Stdout
+    }
+}
+
+fn write_stream(stream: *mut crate::ffi::c_void, buf: &[u8]) -> io::Result<usize> {
+    if buf.is_empty() {
+        return Ok(0);
+    }
+    // SAFETY: `stream` is the C library's stdout/stderr and `buf` is valid.
+    let n = unsafe { abi::fwrite(buf.as_ptr().cast(), 1, buf.len(), stream) };
+    if n == 0 {
+        Err(io::Error::last_os_error())
+    } else {
+        Ok(n)
+    }
+}
+
+impl io::Write for Stdout {
+    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
+        write_stream(unsafe { abi::stdout }, buf)
+    }
+
+    fn write_vectored(&mut self, bufs: &[IoSlice<'_>]) -> io::Result<usize> {
+        io::default_write_vectored(|b| self.write(b), bufs)
+    }
+
+    #[inline]
+    fn is_write_vectored(&self) -> bool {
+        false
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        unsafe { abi::fflush(abi::stdout) };
+        Ok(())
+    }
+}
+
+impl Stderr {
+    pub const fn new() -> Stderr {
+        Stderr
+    }
+}
+
+impl io::Write for Stderr {
+    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
+        write_stream(unsafe { abi::stderr }, buf)
+    }
+
+    fn write_vectored(&mut self, bufs: &[IoSlice<'_>]) -> io::Result<usize> {
+        io::default_write_vectored(|b| self.write(b), bufs)
+    }
+
+    #[inline]
+    fn is_write_vectored(&self) -> bool {
+        false
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        unsafe { abi::fflush(abi::stderr) };
+        Ok(())
+    }
+}
+
+pub const STDIN_BUF_SIZE: usize = crate::sys::io::DEFAULT_BUF_SIZE;
+
+pub fn is_ebadf(err: &io::Error) -> bool {
+    err.raw_os_error() == Some(abi::N_ERR_NO_HANDLE)
+}
+
+pub fn panic_output() -> Option<impl io::Write> {
+    Some(Stderr::new())
+}
