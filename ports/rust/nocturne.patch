+//! Processes on Nocturne.
+//!
+//! Apps are started with `n_app_launch` and not with `fork`/`exec`, and there
+//! are no pipes between them (channels are message based), so `Command` is not
+//! supported yet; only the app's own id is available.
+
+pub use super::unsupported::*;
+
+pub fn getpid() -> u32 {
+    // SAFETY: plain system call.
+    let id = unsafe { crate::sys::pal::abi::n_app_self() };
+    if id > 0 { id as u32 } else { 0 }
+}
