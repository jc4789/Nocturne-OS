diff --git a/library/std/src/sys/path/nocturne.rs b/library/std/src/sys/path/nocturne.rs
new file mode 100644
index 0000000..b4f9e45
--- /dev/null
+++ b/library/std/src/sys/path/nocturne.rs
@@ -0,0 +1,39 @@
+//! Nocturne paths: one drive, `C:`, with `\` and `/` as separators.
+//!
+//! A path is complete when it has a root (`C:\a`, `\a`, `/a`). A drive
+//! without a root (`C:`, `C:a`) names the current folder, like a relative
+//! path. The C library completes paths (`n_path_complete`).
+
+use crate::ffi::OsStr;
+use crate::io;
+use crate::path::{Path, PathBuf, Prefix};
+use crate::sys::pal::{c_path, with_complete_path};
+
+path_separator_bytes!(b'\\', b'/');
+
+#[inline]
+pub const fn is_verbatim_sep(b: u8) -> bool {
+    is_sep_byte(b)
+}
+
+/// The only prefix is a drive, `X:`: there are no UNC or verbatim paths.
+pub fn parse_prefix(path: &OsStr) -> Option<Prefix<'_>> {
+    match path.as_encoded_bytes() {
+        [drive, b':', ..] if drive.is_ascii_alphabetic() => {
+            Some(Prefix::Disk(drive.to_ascii_uppercase()))
+        }
+        _ => None,
+    }
+}
+
+pub const HAS_PREFIXES: bool = true;
+
+/// `C:\...` inside the `FOLDER` setting, with `.` and `..` resolved.
+pub(crate) fn absolute(path: &Path) -> io::Result<PathBuf> {
+    // SAFETY: `with_complete_path` gives a NUL-terminated path.
+    with_complete_path(path, &|full| Ok(unsafe { c_path(full) }))
+}
+
+pub(crate) fn is_absolute(path: &Path) -> bool {
+    path.has_root()
+}
