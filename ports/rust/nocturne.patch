diff --git a/library/std/src/sys/alloc/nocturne.rs b/library/std/src/sys/alloc/nocturne.rs
new file mode 100644
index 0000000..4fe9170
--- /dev/null
+++ b/library/std/src/sys/alloc/nocturne.rs
@@ -0,0 +1,73 @@
+//! The system allocator on Nocturne: the C library's `malloc` family.
+//!
+//! The C library's heap hands out blocks that are 16-byte aligned (a 16-byte
+//! block header, 16-byte size classes, page-aligned regions), which is the
+//! `MIN_ALIGN` of x86-64. The C library has no aligned allocator, so a larger
+//! alignment over-allocates and keeps the pointer `malloc` returned in the
+//! word just before the aligned block.
+
+use super::{MIN_ALIGN, realloc_fallback};
+use crate::alloc::{GlobalAlloc, Layout, System};
+use crate::ptr;
+use crate::sys::abi;
+
+#[stable(feature = "alloc_system_type", since = "1.28.0")]
+unsafe impl GlobalAlloc for System {
+    #[inline]
+    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+        if layout.align() <= MIN_ALIGN {
+            unsafe { abi::malloc(layout.size()) as *mut u8 }
+        } else {
+            unsafe { aligned_malloc(&layout) }
+        }
+    }
+
+    #[inline]
+    unsafe fn alloc_zeroed(&self, layout: Layout) -> *mut u8 {
+        if layout.align() <= MIN_ALIGN {
+            unsafe { abi::calloc(layout.size(), 1) as *mut u8 }
+        } else {
+            let ptr = unsafe { self.alloc(layout) };
+            if !ptr.is_null() {
+                unsafe { ptr::write_bytes(ptr, 0, layout.size()) };
+            }
+            ptr
+        }
+    }
+
+    #[inline]
+    unsafe fn dealloc(&self, ptr: *mut u8, layout: Layout) {
+        if layout.align() <= MIN_ALIGN {
+            unsafe { abi::free(ptr as *mut _) }
+        } else {
+            // The block `malloc` returned is recorded just before ours.
+            unsafe { abi::free(ptr.cast::<*mut u8>().sub(1).read().cast()) }
+        }
+    }
+
+    #[inline]
+    unsafe fn realloc(&self, ptr: *mut u8, layout: Layout, new_size: usize) -> *mut u8 {
+        if layout.align() <= MIN_ALIGN {
+            unsafe { abi::realloc(ptr as *mut _, new_size) as *mut u8 }
+        } else {
+            unsafe { realloc_fallback(self, ptr, layout, new_size) }
+        }
+    }
+}
+
+#[inline]
+unsafe fn aligned_malloc(layout: &Layout) -> *mut u8 {
+    let align = layout.align();
+    // Room for the alignment slack and for the word that remembers the block.
+    let Some(total) = layout.size().checked_add(align + size_of::<*mut u8>()) else {
+        return ptr::null_mut();
+    };
+    let raw = unsafe { abi::malloc(total) } as *mut u8;
+    if raw.is_null() {
+        return raw;
+    }
+    let start = raw.addr() + size_of::<*mut u8>();
+    let aligned = raw.with_addr((start + align - 1) & !(align - 1));
+    unsafe { aligned.cast::<*mut u8>().sub(1).write(raw) };
+    aligned
+}
