diff --git a/library/std/src/sys/time/nocturne.rs b/library/std/src/sys/time/nocturne.rs
new file mode 100644
index 0000000..0b7d8d1
--- /dev/null
+++ b/library/std/src/sys/time/nocturne.rs
@@ -0,0 +1,73 @@
+//! Clocks on Nocturne.
+//!
+//! Both clocks come from the C library's `timespec_get`: `TIME_MONOTONIC` is
+//! the uptime counter and `TIME_UTC` the wall clock. The C library's
+//! resolution is one millisecond.
+
+use crate::io;
+use crate::sys::pal::abi;
+use crate::time::Duration;
+
+fn now(base: crate::ffi::c_int) -> Duration {
+    let mut ts = abi::timespec { tv_sec: 0, tv_nsec: 0 };
+    // SAFETY: `ts` is a valid out pointer.
+    if unsafe { abi::timespec_get(&mut ts, base) } == 0 {
+        return Duration::ZERO;
+    }
+    Duration::new(ts.tv_sec.max(0) as u64, ts.tv_nsec.clamp(0, 999_999_999) as u32)
+}
+
+#[derive(Copy, Clone, PartialEq, Eq, PartialOrd, Ord, Debug, Hash)]
+pub struct Instant(Duration);
+
+#[derive(Copy, Clone, PartialEq, Eq, PartialOrd, Ord, Debug, Hash)]
+pub struct SystemTime(Duration);
+
+pub const UNIX_EPOCH: SystemTime = SystemTime(Duration::from_secs(0));
+
+impl Instant {
+    pub fn now() -> Instant {
+        Instant(now(abi::TIME_MONOTONIC))
+    }
+
+    pub fn checked_sub_instant(&self, other: &Instant) -> Option<Duration> {
+        self.0.checked_sub(other.0)
+    }
+
+    pub fn checked_add_duration(&self, other: &Duration) -> Option<Instant> {
+        Some(Instant(self.0.checked_add(*other)?))
+    }
+
+    pub fn checked_sub_duration(&self, other: &Duration) -> Option<Instant> {
+        Some(Instant(self.0.checked_sub(*other)?))
+    }
+}
+
+impl SystemTime {
+    pub const MAX: SystemTime = SystemTime(Duration::MAX);
+
+    pub const MIN: SystemTime = SystemTime(Duration::ZERO);
+
+    pub fn new(tv_sec: i64, tv_nsec: i64) -> Result<SystemTime, io::Error> {
+        if tv_sec < 0 || !(0..1_000_000_000).contains(&tv_nsec) {
+            return Err(io::const_error!(io::ErrorKind::InvalidData, "invalid time"));
+        }
+        Ok(SystemTime(Duration::new(tv_sec as u64, tv_nsec as u32)))
+    }
+
+    pub fn now() -> SystemTime {
+        SystemTime(now(abi::TIME_UTC))
+    }
+
+    pub fn sub_time(&self, other: &SystemTime) -> Result<Duration, Duration> {
+        self.0.checked_sub(other.0).ok_or_else(|| other.0 - self.0)
+    }
+
+    pub fn checked_add_duration(&self, other: &Duration) -> Option<SystemTime> {
+        Some(SystemTime(self.0.checked_add(*other)?))
+    }
+
+    pub fn checked_sub_duration(&self, other: &Duration) -> Option<SystemTime> {
+        Some(SystemTime(self.0.checked_sub(*other)?))
+    }
+}
