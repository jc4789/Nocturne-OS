new file mode 100644
index 0000000..caaef18
--- /dev/null
+++ b/library/std/src/sys/thread/nocturne.rs
@@ -0,0 +1,91 @@
+//! Threads on Nocturne: the native `thread_create` / `thread_join`.
+//!
+//! The kernel gives every thread a fixed-size stack (256 KiB) and a process at
+//! most 128 threads, so the stack size asked for in `thread::Builder` is not
+//! honoured. The C library sets up the new thread's TLS block (`#[thread_local]`
+//! statics) before the entry function runs.
+
+use crate::ffi::{CStr, c_void};
+use crate::num::NonZero;
+use crate::sys::pal::abi;
+use crate::thread::ThreadInit;
+use crate::time::Duration;
+use crate::io;
+
+pub const DEFAULT_MIN_STACK_SIZE: usize = 256 * 1024;
+
+pub struct Thread {
+    tid: i32,
+}
+
+unsafe impl Send for Thread {}
+unsafe impl Sync for Thread {}
+
+impl Thread {
+    // unsafe: see thread::Builder::spawn_unchecked for safety requirements
+    pub unsafe fn new(_stack: usize, init: Box<ThreadInit>) -> io::Result<Thread> {
+        extern "C" fn thread_start(data: *mut c_void) {
+            // SAFETY: recreates the box leaked below.
+            let init = unsafe { Box::from_raw(data.cast::<ThreadInit>()) };
+            let rust_start = init.init();
+            rust_start();
+
+            // Run the thread-local destructors, then leave.
+            unsafe { crate::sys::thread_local::destructors::run() };
+            crate::rt::thread_cleanup();
+        }
+
+        let data = Box::into_raw(init);
+        let tid = unsafe { abi::thread_create(thread_start, data.cast()) };
+        if tid < 0 {
+            // The thread never started, so the init was not consumed.
+            drop(unsafe { Box::from_raw(data) });
+            return Err(io::Error::from_raw_os_error(abi::code(tid)));
+        }
+        Ok(Thread { tid: tid as i32 })
+    }
+
+    pub fn join(self) {
+        unsafe { abi::thread_join(self.tid) };
+    }
+}
+
+pub fn available_parallelism() -> io::Result<NonZero<usize>> {
+    let mut info = abi::n_cpuinfo {
+        version: 0,
+        detected_cpus: 0,
+        online_cpus: 0,
+        worker_cpus: 0,
+        scheduler_cpus: 0,
+        flags: 0,
+        parallel_jobs: 0,
+        worker_chunks: 0,
+    };
+    // SAFETY: `info` is a valid out structure.
+    let r = unsafe { abi::cpu_info(&mut info) };
+    let n = if r < 0 { 0 } else { info.online_cpus.max(info.scheduler_cpus) as usize };
+    NonZero::new(n).ok_or(io::Error::UNKNOWN_THREAD_COUNT)
+}
+
+pub fn current_os_id() -> Option<u64> {
+    let id = unsafe { abi::thread_id() };
+    if id >= 0 { Some(id as u64) } else { None }
+}
+
+pub fn yield_now() {
+    unsafe { abi::yield_now() }
+}
+
+pub fn set_name(_name: &CStr) {
+    // The kernel keeps no thread names.
+}
+
+pub fn sleep(dur: Duration) {
+    // Whole milliseconds, rounded up so it never returns early.
+    let mut ms = dur.as_millis() + u128::from(dur.subsec_nanos() % 1_000_000 != 0);
+    while ms > 0 {
+        let step = ms.min(u64::MAX as u128) as u64;
+        unsafe { abi::n_sleep_ms(step) };
+        ms -= step as u128;
+    }
+}
