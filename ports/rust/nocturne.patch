diff --git a/library/std/src/sys/paths/nocturne.rs b/library/std/src/sys/paths/nocturne.rs
new file mode 100644
index 0000000..70f07d6
--- /dev/null
+++ b/library/std/src/sys/paths/nocturne.rs
@@ -0,0 +1,101 @@
+//! Folders and paths on Nocturne.
+//!
+//! There is no kernel working directory: an app's current folder is its
+//! `FOLDER` setting, which `n_path_complete` uses to complete relative names
+//! and which is passed on to the apps it launches. The user's folder and the
+//! temporary folder are the settings `USERFOLDER` and `TEMP`, which the C
+//! library reads. Path lists are separated by `;`.
+
+use crate::ffi::{OsStr, OsString};
+use crate::io;
+use crate::marker::PhantomData;
+use crate::path::{Path, PathBuf};
+use crate::sys::pal::{abi, c_path};
+use crate::{fmt, vec};
+
+pub fn getcwd() -> io::Result<PathBuf> {
+    // `FOLDER` completed, or "C:\" when it is missing or not complete.
+    crate::sys::path::absolute(Path::new("."))
+}
+
+pub fn chdir(p: &Path) -> io::Result<()> {
+    crate::sys::helpers::run_path_with_cstr(p, &|name| {
+        crate::sys::cvt(unsafe { abi::n_folder_set(name.as_ptr()) })?;
+        Ok(())
+    })?;
+    // `n_folder_set` changed the C library's table; bring std's copy along.
+    let cwd = getcwd()?;
+    unsafe { crate::sys::env::setenv(OsStr::new("FOLDER"), cwd.as_os_str()) }
+}
+
+pub struct SplitPaths<'a> {
+    iter: vec::IntoIter<PathBuf>,
+    _marker: PhantomData<&'a OsStr>,
+}
+
+pub fn split_paths(unparsed: &OsStr) -> SplitPaths<'_> {
+    let parts: Vec<PathBuf> = unparsed
+        .as_encoded_bytes()
+        .split(|&b| b == b';')
+        .map(|part| {
+            // SAFETY: a piece between ASCII separators of an encoded OsStr.
+            PathBuf::from(unsafe { OsStr::from_encoded_bytes_unchecked(part) })
+        })
+        .collect();
+    SplitPaths { iter: parts.into_iter(), _marker: PhantomData }
+}
+
+impl<'a> Iterator for SplitPaths<'a> {
+    type Item = PathBuf;
+    fn next(&mut self) -> Option<PathBuf> {
+        self.iter.next()
+    }
+    fn size_hint(&self) -> (usize, Option<usize>) {
+        self.iter.size_hint()
+    }
+}
+
+#[derive(Debug)]
+pub struct JoinPathsError;
+
+pub fn join_paths<I, T>(paths: I) -> Result<OsString, JoinPathsError>
+where
+    I: Iterator<Item = T>,
+    T: AsRef<OsStr>,
+{
+    let mut joined = Vec::new();
+    for (i, path) in paths.enumerate() {
+        let path = path.as_ref().as_encoded_bytes();
+        if i > 0 {
+            joined.push(b';')
+        }
+        if path.contains(&b';') {
+            return Err(JoinPathsError);
+        }
+        joined.extend_from_slice(path);
+    }
+    // SAFETY: made of encoded bytes of OsStrs and ASCII separators.
+    Ok(unsafe { OsString::from_encoded_bytes_unchecked(joined) })
+}
+
+impl fmt::Display for JoinPathsError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        "path segment contains separator `;`".fmt(f)
+    }
+}
+
+impl crate::error::Error for JoinPathsError {}
+
+pub fn current_exe() -> io::Result<PathBuf> {
+    crate::sys::unsupported()
+}
+
+pub fn temp_dir() -> PathBuf {
+    // SAFETY: a NUL-terminated path ("C:\" without a complete `TEMP`).
+    unsafe { c_path(abi::n_temp_folder()) }
+}
+
+pub fn home_dir() -> Option<PathBuf> {
+    // SAFETY: a NUL-terminated path ("C:\" without a complete `USERFOLDER`).
+    Some(unsafe { c_path(abi::n_user_folder()) })
+}
