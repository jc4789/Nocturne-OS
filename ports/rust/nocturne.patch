index 0000000..9a23e24
--- /dev/null
+++ b/library/std/src/sys/args/nocturne.rs
@@ -0,0 +1,41 @@
+//! Command line arguments on Nocturne: the C library passes the program's
+//! `argc`/`argv` (the launcher's argument list) to `main`.
+
+#![allow(dead_code)] // runtime init functions not used during testing
+
+pub use super::common::Args;
+use crate::ffi::{CStr, OsString};
+use crate::ptr;
+use crate::sync::atomic::{Atomic, AtomicIsize, AtomicPtr, Ordering};
+
+static ARGC: Atomic<isize> = AtomicIsize::new(0);
+static ARGV: Atomic<*mut *const u8> = AtomicPtr::new(ptr::null_mut());
+
+/// One-time global initialization.
+pub unsafe fn init(argc: isize, argv: *const *const u8) {
+    // Only the unmodified system-provided argv/argc are stored, so these
+    // need no ordering with other stores.
+    ARGC.store(argc, Ordering::Relaxed);
+    ARGV.store(argv as *mut _, Ordering::Relaxed);
+}
+
+/// Returns the command line arguments
+pub fn args() -> Args {
+    let argv = ARGV.load(Ordering::Relaxed);
+    let argc = if argv.is_null() { 0 } else { ARGC.load(Ordering::Relaxed) };
+
+    let mut vec = Vec::with_capacity(argc as usize);
+    for i in 0..argc {
+        // SAFETY: `argv` is non-null if `argc` is positive, and it is
+        // guaranteed to be at least as long as `argc`.
+        let ptr = unsafe { argv.offset(i).read() };
+        if ptr.is_null() {
+            break;
+        }
+        // SAFETY: arguments are NUL-terminated C strings.
+        let cstr = unsafe { CStr::from_ptr(ptr.cast()) };
+        // SAFETY: Nocturne arguments are plain bytes, like the encoded bytes of an OsString.
+        vec.push(unsafe { OsString::from_encoded_bytes_unchecked(cstr.to_bytes().to_vec()) });
+    }
+    Args::new(vec)
+}
