diff --git a/library/std/src/sys/pal/nocturne/abi.rs b/library/std/src/sys/pal/nocturne/abi.rs
new file mode 100644
index 0000000..305ba59
--- /dev/null
+++ b/library/std/src/sys/pal/nocturne/abi.rs
@@ -0,0 +1,181 @@
+//! Declarations of the Nocturne native ABI as the C library exports it
+//! (`user/include/nocturne.h`, `common/abi.h`, `docs/nocturne-native-abi.md`).
+//!
+//! Nocturne is not UNIX or POSIX, so this deliberately does not use the `libc`
+//! crate: there are no file descriptors, no `errno` names and no signals here.
+//! Results are negative `n_result` values (`-N_ERR_*`); the C library keeps the
+//! positive `N_ERR_*` number in `errno` for the ISO C functions.
+
+#![allow(non_camel_case_types, dead_code)]
+
+use crate::ffi::{c_char, c_int, c_long, c_uint, c_void};
+
+pub type n_handle = i32;
+pub type n_result = i64;
+
+// ---- results (common/abi.h) ----
+pub const N_ERR_NOT_FOUND: i32 = 1;
+pub const N_ERR_EXISTS: i32 = 2;
+pub const N_ERR_DENIED: i32 = 3;
+pub const N_ERR_NO_MEMORY: i32 = 4;
+pub const N_ERR_INVALID: i32 = 5;
+pub const N_ERR_WRONG_KIND: i32 = 6;
+pub const N_ERR_NO_HANDLE: i32 = 7;
+pub const N_ERR_BUSY: i32 = 8;
+pub const N_ERR_NOT_READY: i32 = 9;
+pub const N_ERR_CLOSED: i32 = 10;
+pub const N_ERR_TIMEOUT: i32 = 11;
+pub const N_ERR_CANCELLED: i32 = 12;
+pub const N_ERR_TOO_LARGE: i32 = 13;
+pub const N_ERR_NOT_EMPTY: i32 = 14;
+pub const N_ERR_IO: i32 = 15;
+pub const N_ERR_UNSUPPORTED: i32 = 16;
+pub const N_ERR_BAD_ADDRESS: i32 = 17;
+pub const N_ERR_STOPPED: i32 = 18;
+pub const N_ERR_NOT_FOLDER: i32 = 19;
+pub const N_ERR_IS_FOLDER: i32 = 20;
+pub const N_ERR_READ_ONLY: i32 = 21;
+pub const N_ERR_NO_SPACE: i32 = 22;
+pub const N_ERR_NOT_PROGRAM: i32 = 23;
+pub const N_ERR_NAME_TOO_LONG: i32 = 24;
+pub const N_ERR_NO_APP: i32 = 25;
+pub const N_ERR_TOO_MANY_ARGUMENTS: i32 = 26;
+pub const N_ERR_CONNECTION_RESET: i32 = 27;
+pub const N_ERR_CONNECTION_REFUSED: i32 = 28;
+pub const N_ERR_ADDRESS_IN_USE: i32 = 29;
+pub const N_ERR_NETWORK_DOWN: i32 = 30;
+pub const N_ERR_NOT_CONNECTED: i32 = 31;
+pub const N_ERR_UNREACHABLE: i32 = 32;
+pub const N_ERR_PROTOCOL: i32 = 33;
+
+// ---- handle kinds ----
+pub const N_KIND_DOCUMENT: u32 = 1;
+pub const N_KIND_FOLDER: u32 = 2;
+pub const N_KIND_CHANNEL: u32 = 3;
+pub const N_KIND_DEVICE: u32 = 8;
+
+// ---- n_document_open access (an enumeration, not a bit set) ----
+pub const N_DOCUMENT_READ: c_int = 1;
+pub const N_DOCUMENT_EDIT: c_int = 2;
+pub const N_DOCUMENT_CREATE: c_int = 3;
+pub const N_DOCUMENT_REPLACE: c_int = 4;
+
+// ---- n_document_commit ----
+pub const N_COMMIT_WAIT: c_int = 1;
+
+// ---- n_channel_receive flags ----
+pub const N_CHANNEL_WAIT: c_int = 1;
+pub const N_CHANNEL_PEEK: c_int = 2;
+
+pub const NAME_MAX: usize = 255;
+
+/// `struct n_entry`
+#[repr(C)]
+pub struct n_entry {
+    pub name: [c_char; 256],
+    pub kind: u32,
+    pub modified_ns: u32,
+    pub size: u64,
+    pub modified: i64,
+    pub id: u64,
+}
+
+impl n_entry {
+    pub const fn zeroed() -> n_entry {
+        n_entry { name: [0; 256], kind: 0, modified_ns: 0, size: 0, modified: 0, id: 0 }
+    }
+}
+
+/// `struct n_cpuinfo`
+#[repr(C)]
+pub struct n_cpuinfo {
+    pub version: u32,
+    pub detected_cpus: u32,
+    pub online_cpus: u32,
+    pub worker_cpus: u32,
+    pub scheduler_cpus: u32,
+    pub flags: u32,
+    pub parallel_jobs: u64,
+    pub worker_chunks: u64,
+}
+
+/// ISO C `struct timespec` of the Nocturne C library (`time_t` is 64 bits).
+#[repr(C)]
+pub struct timespec {
+    pub tv_sec: i64,
+    pub tv_nsec: c_long,
+}
+
+/// ISO C `timespec_get` bases.
+pub const TIME_UTC: c_int = 1;
+pub const TIME_MONOTONIC: c_int = 2;
+
+unsafe extern "C" {
+    // ---- ISO C ----
+    pub fn malloc(size: usize) -> *mut c_void;
+    pub fn calloc(count: usize, size: usize) -> *mut c_void;
+    pub fn realloc(ptr: *mut c_void, size: usize) -> *mut c_void;
+    pub fn free(ptr: *mut c_void);
+    pub fn rename(from: *const c_char, to: *const c_char) -> c_int;
+    pub fn abort() -> !;
+    pub fn exit(code: c_int) -> !;
+    pub fn getenv(name: *const c_char) -> *mut c_char;
+    pub fn setenv(name: *const c_char, value: *const c_char, overwrite: c_int) -> c_int;
+    pub fn unsetenv(name: *const c_char) -> c_int;
+    pub fn fwrite(buf: *const c_void, size: usize, count: usize, file: *mut c_void) -> usize;
+    pub fn fflush(file: *mut c_void) -> c_int;
+    pub fn timespec_get(ts: *mut timespec, base: c_int) -> c_int;
+    pub fn __errno_location() -> *mut c_int;
+    pub static mut stdout: *mut c_void;
+    pub static mut stderr: *mut c_void;
+
+    // ---- Nocturne native ABI ----
+    pub fn n_result_text(r: n_result) -> *const c_char;
+    pub fn n_handle_close(h: n_handle) -> n_result;
+    pub fn n_handle_kind(h: n_handle) -> n_result;
+    pub fn n_document_open(path: *const c_char, access: c_int) -> n_handle;
+    pub fn n_document_read_at(h: n_handle, offset: u64, buf: *mut c_void, n: usize) -> n_result;
+    pub fn n_document_write_at(h: n_handle, offset: u64, buf: *const c_void, n: usize) -> n_result;
+    pub fn n_document_size(h: n_handle) -> n_result;
+    pub fn n_document_set_size(h: n_handle, size: u64) -> n_result;
+    pub fn n_document_claim(h: n_handle, wait: bool) -> n_result;
+    pub fn n_document_release(h: n_handle) -> n_result;
+    pub fn n_document_commit(h: n_handle, how: c_int) -> n_result;
+    pub fn n_document_save(path: *const c_char, data: *const c_void, size: usize) -> n_result;
+    pub fn n_entry_info(path: *const c_char, out: *mut n_entry) -> n_result;
+    pub fn n_entry_remove(path: *const c_char) -> n_result;
+    pub fn n_entry_move(from: *const c_char, to: *const c_char) -> n_result;
+    pub fn n_folder_create(path: *const c_char) -> n_result;
+    pub fn n_folder_list(path: *const c_char, out: *mut n_entry, max: usize, start: u64) -> n_result;
+    pub fn n_channel_receive(
+        h: n_handle,
+        buf: *mut c_void,
+        cap: usize,
+        flags: c_int,
+        attached: *mut n_handle,
+    ) -> n_result;
+    pub fn n_path_complete(name: *const c_char, out: *mut c_char, cap: usize) -> n_result;
+    pub fn n_folder_set(name: *const c_char) -> n_result;
+    pub fn n_user_folder() -> *const c_char;
+    pub fn n_temp_folder() -> *const c_char;
+    pub fn n_random(buf: *mut c_void, n: usize) -> n_result;
+    pub fn n_app_self() -> n_result;
+    pub fn n_terminal(h: n_handle) -> bool;
+    pub static n_settings: *const *mut c_char;
+
+    pub fn n_sleep_ms(ms: u64);
+    #[link_name = "yield"]
+    pub fn yield_now() -> ();
+    pub fn thread_create(f: extern "C" fn(*mut c_void), arg: *mut c_void) -> n_result;
+    pub fn thread_join(tid: c_int) -> n_result;
+    pub fn thread_id() -> c_int;
+    pub fn cpu_info(info: *mut n_cpuinfo) -> n_result;
+    pub fn wait_on_address(address: *const u32, expected: u32, timeout_ms: c_uint) -> n_result;
+    pub fn wake_address(address: *const u32, count: c_uint) -> n_result;
+}
+
+/// The positive `N_ERR_*` code a negative `n_result` stands for.
+#[inline]
+pub fn code(r: n_result) -> i32 {
+    (-r).clamp(1, i32::MAX as i64) as i32
+}
diff --git a/library/std/src/sys/pal/nocturne/futex.rs b/library/std/src/sys/pal/nocturne/futex.rs
new file mode 100644
index 0000000..f4b3799
--- /dev/null
+++ b/library/std/src/sys/pal/nocturne/futex.rs
@@ -0,0 +1,65 @@
+//! Futex-style waits on Nocturne's address waits (`wait_on_address` /
+//! `wake_address`, docs/nocturne-native-abi.md §7), which std's futex-based
+//! `Mutex`, `Condvar`, `RwLock`, `Once` and thread parker are built on.
+
+use super::abi;
+use crate::sync::atomic::Atomic;
+use crate::time::Duration;
+
+/// An atomic for use as a futex that is at least 32-bits but may be larger
+pub type Futex = Atomic<Primitive>;
+/// Must be the underlying type of Futex
+pub type Primitive = u32;
+
+/// An atomic for use as a futex that is at least 8-bits but may be larger.
+pub type SmallFutex = Atomic<SmallPrimitive>;
+/// Must be the underlying type of SmallFutex
+pub type SmallPrimitive = u32;
+
+/// Waits for a `futex_wake` operation to wake us.
+///
+/// Returns directly if the futex doesn't hold the expected value.
+///
+/// Returns false on timeout, and true in all other cases (a woken wait, a
+/// value that no longer matches, or a spurious return).
+pub fn futex_wait(futex: &Atomic<u32>, expected: u32, timeout: Option<Duration>) -> bool {
+    // The kernel counts whole milliseconds in a u32; u32::MAX waits forever.
+    // A longer timeout waits as long as one call can, then returns early like
+    // a spurious wake-up (every caller re-checks its condition and clock).
+    let ms: u32 = match timeout {
+        None => u32::MAX,
+        Some(dur) => {
+            let ms = dur.as_millis() + u128::from(dur.subsec_nanos() % 1_000_000 != 0);
+            if ms >= (u32::MAX - 1) as u128 { u32::MAX - 1 } else { ms as u32 }
+        }
+    };
+    let r = unsafe { abi::wait_on_address(futex.as_ptr(), expected, ms) };
+    if r == -(abi::N_ERR_TIMEOUT as i64) {
+        // Only a real timeout counts as one; the clamped wait above is spurious.
+        return match timeout {
+            Some(d) => d.as_millis() >= (u32::MAX - 1) as u128,
+            None => true,
+        };
+    }
+    if r == -(abi::N_ERR_STOPPED as i64) {
+        // The app is being stopped; do not spin the CPU until it ends.
+        unsafe { abi::yield_now() };
+    }
+    true
+}
+
+/// Wakes up one thread that's blocked on `futex_wait` on this futex.
+///
+/// Returns true if this actually woke up a thread, false if no thread was
+/// waiting on this futex.
+#[inline]
+pub fn futex_wake(futex: &Atomic<u32>) -> bool {
+    unsafe { abi::wake_address(futex.as_ptr(), 1) > 0 }
+}
+
+/// Wakes up all threads that are waiting on `futex_wait` on this futex.
+#[inline]
+pub fn futex_wake_all(futex: &Atomic<u32>) {
+    // A count of zero wakes everybody.
+    unsafe { abi::wake_address(futex.as_ptr(), 0) };
+}
diff --git a/library/std/src/sys/pal/nocturne/mod.rs b/library/std/src/sys/pal/nocturne/mod.rs
new file mode 100644
index 0000000..ad549ff
--- /dev/null
+++ b/library/std/src/sys/pal/nocturne/mod.rs
@@ -0,0 +1,89 @@
+//! System bindings for Nocturne OS.
+//!
+//! Nocturne is its own operating system, not UNIX and not POSIX. This target
+//! therefore does not set `target_family = "unix"` and std does not use the
+//! `libc` crate here: it calls the Nocturne C library's ISO C functions
+//! (allocation, `exit`, `getenv`, `timespec_get`, stdio) and the native ABI
+//! (`n_*`: documents, folders, handles, `wait_on_address`, threads) through
+//! the declarations in [`abi`].
+
+#![deny(unsafe_op_in_unsafe_fn)]
+#![allow(missing_docs, nonstandard_style)]
+
+use crate::ffi::{CStr, OsStr, c_char};
+use crate::io as std_io;
+use crate::path::PathBuf;
+
+pub mod abi;
+pub mod futex;
+
+// SAFETY: must be called only once during runtime initialization.
+// NOTE: this is not guaranteed to run, for example when Rust code is called externally.
+pub unsafe fn init(argc: isize, argv: *const *const u8, _sigpipe: u8) {
+    // The C library's start-up (`__libc_start`) already set up the main
+    // thread's TLS block, stdio and the launch settings before `main`.
+    unsafe {
+        crate::sys::args::init(argc, argv);
+        crate::sys::env::init();
+    }
+}
+
+// SAFETY: must be called only once during runtime cleanup.
+// NOTE: this is not guaranteed to run, for example when the program aborts.
+pub unsafe fn cleanup() {}
+
+pub fn unsupported<T>() -> std_io::Result<T> {
+    Err(unsupported_err())
+}
+
+pub fn unsupported_err() -> std_io::Error {
+    std_io::Error::from_raw_os_error(abi::N_ERR_UNSUPPORTED)
+}
+
+pub fn abort_internal() -> ! {
+    unsafe { abi::abort() }
+}
+
+/// Turns a native result (negative `-N_ERR_*`, otherwise a value) into an
+/// `io::Result`. The error is the positive `N_ERR_*` code as an OS error.
+#[inline]
+pub fn cvt(r: abi::n_result) -> std_io::Result<abi::n_result> {
+    if r < 0 { Err(std_io::Error::from_raw_os_error(abi::code(r))) } else { Ok(r) }
+}
+
+/// Runs `f` with the complete, normalised form of `path` (`n_path_complete`:
+/// `C:\...`, relative names are taken inside the `FOLDER` setting, `.` and
+/// `..` are resolved by name). Every call that names a document or folder goes
+/// through here because the kernel only accepts complete paths.
+pub fn with_complete_path<T>(
+    path: &crate::path::Path,
+    f: &dyn Fn(*const c_char) -> std_io::Result<T>,
+) -> std_io::Result<T> {
+    crate::sys::helpers::run_path_with_cstr(path, &|name| {
+        let mut stack = [0 as c_char; 4096];
+        let mut heap: Vec<c_char> = Vec::new();
+        let mut full: &mut [c_char] = &mut stack;
+        loop {
+            let r = unsafe { abi::n_path_complete(name.as_ptr(), full.as_mut_ptr(), full.len()) };
+            if r != -(abi::N_ERR_TOO_LARGE as abi::n_result) {
+                cvt(r)?;
+                return f(full.as_ptr());
+            }
+            // Paths have no length limit: try again with more room.
+            let len = full.len() * 2;
+            heap.resize(len, 0);
+            full = &mut heap[..];
+        }
+    })
+}
+
+/// The path in a string the C library gives.
+///
+/// # Safety
+///
+/// `p` must point to a NUL-terminated string.
+pub unsafe fn c_path(p: *const c_char) -> PathBuf {
+    let bytes = unsafe { CStr::from_ptr(p) }.to_bytes();
+    // SAFETY: Nocturne paths are plain bytes, like the encoded bytes of an OsStr.
+    PathBuf::from(unsafe { OsStr::from_encoded_bytes_unchecked(bytes) })
+}
