diff --git a/library/std/src/sys/env/nocturne.rs b/library/std/src/sys/env/nocturne.rs
new file mode 100644
index 0000000..3f449a3
--- /dev/null
+++ b/library/std/src/sys/env/nocturne.rs
@@ -0,0 +1,105 @@
+//! Environment variables on Nocturne.
+//!
+//! There is no `environ`: a program's environment is the launcher's list of
+//! settings (`"NAME=value"`, `n_settings`), which the C library's `getenv`
+//! reads. std keeps its own copy, filled from `n_settings` on first use, so
+//! that `std::env::vars()` can enumerate it. `set_var`/`remove_var` change
+//! std's copy and are mirrored into the C library's table, so C code in the
+//! same program (and apps launched later) see them; changes made only by C
+//! code afterwards are not seen by std.
+
+use core::slice::memchr;
+
+pub use super::common::Env;
+use crate::ffi::{CStr, OsStr, OsString, c_char};
+use crate::io;
+use crate::sync::Mutex;
+use crate::sys::abi;
+use crate::sys::cvt;
+use crate::sys::helpers::run_with_cstr;
+
+static ENV: Mutex<Option<Vec<(OsString, OsString)>>> = Mutex::new(None);
+
+fn parse(input: &[u8]) -> Option<(OsString, OsString)> {
+    // Variable name and value are separated by an ASCII equals sign '='. A
+    // variable name must not be empty, so a leading '=' belongs to the name.
+    if input.is_empty() {
+        return None;
+    }
+    let pos = memchr::memchr(b'=', &input[1..]).map(|p| p + 1)?;
+    // SAFETY: Nocturne settings are plain bytes, like the encoded bytes of an OsString.
+    unsafe {
+        Some((
+            OsString::from_encoded_bytes_unchecked(input[..pos].to_vec()),
+            OsString::from_encoded_bytes_unchecked(input[pos + 1..].to_vec()),
+        ))
+    }
+}
+
+fn load() -> Vec<(OsString, OsString)> {
+    let mut vars = Vec::new();
+    // SAFETY: `n_settings` is a NULL-terminated array of C strings set up by
+    // the C library's start-up code and never freed.
+    unsafe {
+        let mut p: *const *mut c_char = abi::n_settings;
+        if !p.is_null() {
+            while !(*p).is_null() {
+                if let Some(kv) = parse(CStr::from_ptr(*p).to_bytes()) {
+                    vars.push(kv);
+                }
+                p = p.add(1);
+            }
+        }
+    }
+    vars
+}
+
+fn with_env<T>(f: impl FnOnce(&mut Vec<(OsString, OsString)>) -> T) -> T {
+    let mut guard = ENV.lock().unwrap_or_else(|e| e.into_inner());
+    f(guard.get_or_insert_with(load))
+}
+
+/// Reads the launch settings now rather than at the first access.
+pub fn init() {
+    with_env(|_| ());
+}
+
+/// All the environment variables of the current process.
+pub fn env() -> Env {
+    Env::new(with_env(|vars| vars.clone()))
+}
+
+pub fn getenv(k: &OsStr) -> Option<OsString> {
+    with_env(|vars| vars.iter().find(|(name, _)| name == k).map(|(_, v)| v.clone()))
+}
+
+pub unsafe fn setenv(k: &OsStr, v: &OsStr) -> io::Result<()> {
+    run_with_cstr(k.as_encoded_bytes(), &|kc| {
+        run_with_cstr(v.as_encoded_bytes(), &|vc| {
+            with_env(|vars| {
+                // Keep the C library's table (what `getenv` and the apps this
+                // program launches read) in step.
+                cvt(if unsafe { abi::setenv(kc.as_ptr(), vc.as_ptr(), 1) } < 0 {
+                    -(abi::N_ERR_NO_MEMORY as i64)
+                } else {
+                    0
+                })?;
+                match vars.iter_mut().find(|(name, _)| name == k) {
+                    Some((_, value)) => *value = v.to_os_string(),
+                    None => vars.push((k.to_os_string(), v.to_os_string())),
+                }
+                Ok(())
+            })
+        })
+    })
+}
+
+pub unsafe fn unsetenv(k: &OsStr) -> io::Result<()> {
+    run_with_cstr(k.as_encoded_bytes(), &|kc| {
+        with_env(|vars| {
+            unsafe { abi::unsetenv(kc.as_ptr()) };
+            vars.retain(|(name, _)| name != k);
+            Ok(())
+        })
+    })
+}
