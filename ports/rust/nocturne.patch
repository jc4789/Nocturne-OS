diff --git a/library/std/src/sys/fs/nocturne.rs b/library/std/src/sys/fs/nocturne.rs
new file mode 100644
index 0000000..ba61989
--- /dev/null
+++ b/library/std/src/sys/fs/nocturne.rs
@@ -0,0 +1,562 @@
+//! Documents and folders on Nocturne.
+//!
+//! A file is a document handle (`n_document_open`). The kernel has no shared
+//! cursor, so `File` keeps its own position; append-style files claim the
+//! document and write at its end each time. Paths are completed against the
+//! app's `FOLDER` setting before they reach the kernel. There are no
+//! permissions, symbolic links or hard links: permissions are always writable
+//! and links are unsupported; timestamps are whole wall seconds.
+
+use crate::ffi::{CStr, OsString, c_char};
+use crate::fmt;
+use crate::fs::TryLockError;
+use crate::hash::Hash;
+use crate::io::{self, BorrowedCursor, IoSlice, IoSliceMut, SeekFrom};
+use crate::path::{Path, PathBuf};
+use crate::sync::atomic::{AtomicU64, Ordering};
+pub use crate::sys::fs::common::{Dir, copy, exists, remove_dir_all};
+use crate::sys::pal::abi::{self, n_entry};
+use crate::sys::pal::{c_path, cvt, unsupported, with_complete_path};
+use crate::sys::time::SystemTime;
+
+/// Entries asked of `n_folder_list` at a time.
+const LIST_PAGE: usize = 64;
+
+pub struct File {
+    handle: abi::n_handle,
+    pos: AtomicU64,
+    writable: bool,
+    append: bool,
+    /// The complete path with a trailing NUL: for `file_attr` and `duplicate`.
+    path: Vec<u8>,
+}
+
+#[derive(Clone)]
+pub struct FileAttr {
+    size: u64,
+    kind: u32,
+    modified: i64,
+    modified_ns: u32,
+}
+
+pub struct ReadDir {
+    root: PathBuf,
+    entries: crate::vec::IntoIter<DirEntry>,
+}
+
+pub struct DirEntry {
+    root: PathBuf,
+    name: OsString,
+    attr: FileAttr,
+}
+
+#[derive(Clone, Debug)]
+pub struct OpenOptions {
+    read: bool,
+    write: bool,
+    append: bool,
+    truncate: bool,
+    create: bool,
+    create_new: bool,
+}
+
+#[derive(Copy, Clone, Debug, Default)]
+pub struct FileTimes {}
+
+#[derive(Clone, PartialEq, Eq, Debug)]
+pub struct FilePermissions {
+    readonly: bool,
+}
+
+#[derive(Copy, Clone, PartialEq, Eq, Hash, Debug)]
+pub struct FileType {
+    kind: u32,
+}
+
+#[derive(Debug)]
+pub struct DirBuilder {}
+
+fn invalid(msg: &'static str) -> io::Error {
+    io::Error::new(io::ErrorKind::InvalidInput, msg)
+}
+
+fn info(path: *const c_char) -> io::Result<FileAttr> {
+    let mut e = n_entry::zeroed();
+    cvt(unsafe { abi::n_entry_info(path, &mut e) })?;
+    Ok(FileAttr::from_entry(&e))
+}
+
+impl FileAttr {
+    fn from_entry(e: &n_entry) -> FileAttr {
+        FileAttr { size: e.size, kind: e.kind, modified: e.modified, modified_ns: e.modified_ns }
+    }
+
+    pub fn size(&self) -> u64 {
+        self.size
+    }
+
+    pub fn perm(&self) -> FilePermissions {
+        FilePermissions { readonly: false }
+    }
+
+    pub fn file_type(&self) -> FileType {
+        FileType { kind: self.kind }
+    }
+
+    pub fn modified(&self) -> io::Result<SystemTime> {
+        // SystemTime starts at 1970: an older entry shows as that.
+        if self.modified < 0 {
+            return Ok(SystemTime::MIN);
+        }
+        SystemTime::new(self.modified, self.modified_ns.into())
+    }
+
+    pub fn accessed(&self) -> io::Result<SystemTime> {
+        self.modified()
+    }
+
+    pub fn created(&self) -> io::Result<SystemTime> {
+        Err(io::const_error!(io::ErrorKind::Unsupported, "creation time is not available"))
+    }
+}
+
+impl FilePermissions {
+    pub fn readonly(&self) -> bool {
+        self.readonly
+    }
+
+    pub fn set_readonly(&mut self, readonly: bool) {
+        self.readonly = readonly;
+    }
+}
+
+impl FileTimes {
+    pub fn set_accessed(&mut self, _t: SystemTime) {}
+    pub fn set_modified(&mut self, _t: SystemTime) {}
+}
+
+impl FileType {
+    pub fn is_dir(&self) -> bool {
+        self.kind == abi::N_KIND_FOLDER
+    }
+
+    pub fn is_file(&self) -> bool {
+        self.kind == abi::N_KIND_DOCUMENT
+    }
+
+    pub fn is_symlink(&self) -> bool {
+        false
+    }
+}
+
+impl fmt::Debug for ReadDir {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_tuple("ReadDir").field(&self.root).finish()
+    }
+}
+
+impl Iterator for ReadDir {
+    type Item = io::Result<DirEntry>;
+
+    fn next(&mut self) -> Option<io::Result<DirEntry>> {
+        self.entries.next().map(Ok)
+    }
+}
+
+impl DirEntry {
+    pub fn path(&self) -> PathBuf {
+        self.root.join(&self.name)
+    }
+
+    pub fn file_name(&self) -> OsString {
+        self.name.clone()
+    }
+
+    pub fn metadata(&self) -> io::Result<FileAttr> {
+        Ok(self.attr.clone())
+    }
+
+    pub fn file_type(&self) -> io::Result<FileType> {
+        Ok(self.attr.file_type())
+    }
+}
+
+impl OpenOptions {
+    pub fn new() -> OpenOptions {
+        OpenOptions {
+            read: false,
+            write: false,
+            append: false,
+            truncate: false,
+            create: false,
+            create_new: false,
+        }
+    }
+
+    pub fn read(&mut self, read: bool) {
+        self.read = read;
+    }
+    pub fn write(&mut self, write: bool) {
+        self.write = write;
+    }
+    pub fn append(&mut self, append: bool) {
+        self.append = append;
+    }
+    pub fn truncate(&mut self, truncate: bool) {
+        self.truncate = truncate;
+    }
+    pub fn create(&mut self, create: bool) {
+        self.create = create;
+    }
+    pub fn create_new(&mut self, create_new: bool) {
+        self.create_new = create_new;
+    }
+
+    fn writes(&self) -> bool {
+        self.write || self.append
+    }
+
+    fn check(&self) -> io::Result<()> {
+        if !self.read && !self.writes() {
+            return Err(invalid("must specify at least one of read, write, or append access"));
+        }
+        if !self.writes() && (self.truncate || self.create || self.create_new) {
+            return Err(invalid("creating or truncating a file requires write or append access"));
+        }
+        if self.append && self.truncate && !self.create_new {
+            return Err(invalid("creating or truncating a file requires write access"));
+        }
+        Ok(())
+    }
+}
+
+fn open_handle(full: *const c_char, access: crate::ffi::c_int) -> io::Result<abi::n_handle> {
+    let h = unsafe { abi::n_document_open(full, access) };
+    cvt(h as i64).map(|h| h as abi::n_handle)
+}
+
+impl File {
+    pub fn open(path: &Path, opts: &OpenOptions) -> io::Result<File> {
+        opts.check()?;
+        with_complete_path(path, &|full| {
+            let handle = if opts.create_new {
+                open_handle(full, abi::N_DOCUMENT_CREATE)?
+            } else if opts.writes() {
+                let h = match open_handle(full, abi::N_DOCUMENT_EDIT) {
+                    Err(e) if opts.create && e.raw_os_error() == Some(abi::N_ERR_NOT_FOUND) => {
+                        match open_handle(full, abi::N_DOCUMENT_CREATE) {
+                            // Somebody else created it in the meantime.
+                            Err(e) if e.raw_os_error() == Some(abi::N_ERR_EXISTS) => {
+                                open_handle(full, abi::N_DOCUMENT_EDIT)?
+                            }
+                            other => other?,
+                        }
+                    }
+                    other => other?,
+                };
+                if opts.truncate {
+                    if let Err(e) = cvt(unsafe { abi::n_document_set_size(h, 0) }) {
+                        unsafe { abi::n_handle_close(h) };
+                        return Err(e);
+                    }
+                }
+                h
+            } else {
+                open_handle(full, abi::N_DOCUMENT_READ)?
+            };
+            let stored = unsafe { CStr::from_ptr(full) }.to_bytes_with_nul().to_vec();
+            Ok(File {
+                handle,
+                pos: AtomicU64::new(0),
+                writable: opts.writes(),
+                append: opts.append,
+                path: stored,
+            })
+        })
+    }
+
+    pub fn file_attr(&self) -> io::Result<FileAttr> {
+        let mut attr = info(self.path.as_ptr().cast())?;
+        // The handle knows the current size.
+        if let Ok(size) = cvt(unsafe { abi::n_document_size(self.handle) }) {
+            attr.size = size as u64;
+        }
+        Ok(attr)
+    }
+
+    pub fn fsync(&self) -> io::Result<()> {
+        // Returns once the document is on the medium.
+        cvt(unsafe { abi::n_document_commit(self.handle, abi::N_COMMIT_WAIT) }).map(|_| ())
+    }
+
+    pub fn datasync(&self) -> io::Result<()> {
+        self.fsync()
+    }
+
+    pub fn lock(&self) -> io::Result<()> {
+        cvt(unsafe { abi::n_document_claim(self.handle, true) }).map(|_| ())
+    }
+
+    pub fn lock_shared(&self) -> io::Result<()> {
+        self.lock()
+    }
+
+    pub fn try_lock(&self) -> Result<(), TryLockError> {
+        let r = unsafe { abi::n_document_claim(self.handle, false) };
+        if r == -(abi::N_ERR_NOT_READY as i64) {
+            Err(TryLockError::WouldBlock)
+        } else {
+            cvt(r).map(|_| ()).map_err(TryLockError::Error)
+        }
+    }
+
+    pub fn try_lock_shared(&self) -> Result<(), TryLockError> {
+        self.try_lock()
+    }
+
+    pub fn unlock(&self) -> io::Result<()> {
+        cvt(unsafe { abi::n_document_release(self.handle) }).map(|_| ())
+    }
+
+    pub fn truncate(&self, size: u64) -> io::Result<()> {
+        cvt(unsafe { abi::n_document_set_size(self.handle, size) }).map(|_| ())
+    }
+
+    pub fn read(&self, buf: &mut [u8]) -> io::Result<usize> {
+        let pos = self.pos.load(Ordering::Relaxed);
+        let n = cvt(unsafe {
+            abi::n_document_read_at(self.handle, pos, buf.as_mut_ptr().cast(), buf.len())
+        })? as usize;
+        self.pos.store(pos + n as u64, Ordering::Relaxed);
+        Ok(n)
+    }
+
+    pub fn read_vectored(&self, bufs: &mut [IoSliceMut<'_>]) -> io::Result<usize> {
+        io::default_read_vectored(|b| self.read(b), bufs)
+    }
+
+    #[inline]
+    pub fn is_read_vectored(&self) -> bool {
+        false
+    }
+
+    pub fn read_buf(&self, cursor: BorrowedCursor<'_, u8>) -> io::Result<()> {
+        io::default_read_buf(|b| self.read(b), cursor)
+    }
+
+    pub fn write(&self, buf: &[u8]) -> io::Result<usize> {
+        if !self.writable {
+            return Err(io::Error::from_raw_os_error(abi::N_ERR_DENIED));
+        }
+        if buf.is_empty() {
+            return Ok(0);
+        }
+        if self.append {
+            // The claim keeps other appenders from writing at the same end.
+            let claimed = unsafe { abi::n_document_claim(self.handle, true) } >= 0;
+            let result = (|| {
+                let end = cvt(unsafe { abi::n_document_size(self.handle) })? as u64;
+                let n = cvt(unsafe {
+                    abi::n_document_write_at(self.handle, end, buf.as_ptr().cast(), buf.len())
+                })? as usize;
+                self.pos.store(end + n as u64, Ordering::Relaxed);
+                Ok(n)
+            })();
+            if claimed {
+                unsafe { abi::n_document_release(self.handle) };
+            }
+            result
+        } else {
+            let pos = self.pos.load(Ordering::Relaxed);
+            let n = cvt(unsafe {
+                abi::n_document_write_at(self.handle, pos, buf.as_ptr().cast(), buf.len())
+            })? as usize;
+            self.pos.store(pos + n as u64, Ordering::Relaxed);
+            Ok(n)
+        }
+    }
+
+    pub fn write_vectored(&self, bufs: &[IoSlice<'_>]) -> io::Result<usize> {
+        io::default_write_vectored(|b| self.write(b), bufs)
+    }
+
+    #[inline]
+    pub fn is_write_vectored(&self) -> bool {
+        false
+    }
+
+    pub fn flush(&self) -> io::Result<()> {
+        Ok(())
+    }
+
+    pub fn seek(&self, pos: SeekFrom) -> io::Result<u64> {
+        let target = match pos {
+            SeekFrom::Start(n) => Some(n),
+            SeekFrom::Current(d) => self.pos.load(Ordering::Relaxed).checked_add_signed(d),
+            SeekFrom::End(d) => {
+                let end = cvt(unsafe { abi::n_document_size(self.handle) })? as u64;
+                end.checked_add_signed(d)
+            }
+        };
+        let target =
+            target.ok_or_else(|| invalid("invalid seek to a negative or overflowing position"))?;
+        self.pos.store(target, Ordering::Relaxed);
+        Ok(target)
+    }
+
+    pub fn size(&self) -> Option<io::Result<u64>> {
+        Some(cvt(unsafe { abi::n_document_size(self.handle) }).map(|n| n as u64))
+    }
+
+    pub fn tell(&self) -> io::Result<u64> {
+        Ok(self.pos.load(Ordering::Relaxed))
+    }
+
+    pub fn duplicate(&self) -> io::Result<File> {
+        // There is no handle duplication: open the same document again.
+        let handle = open_handle(
+            self.path.as_ptr().cast(),
+            if self.writable { abi::N_DOCUMENT_EDIT } else { abi::N_DOCUMENT_READ },
+        )?;
+        Ok(File {
+            handle,
+            pos: AtomicU64::new(self.pos.load(Ordering::Relaxed)),
+            writable: self.writable,
+            append: self.append,
+            path: self.path.clone(),
+        })
+    }
+
+    pub fn set_permissions(&self, _perm: FilePermissions) -> io::Result<()> {
+        // No permission bits exist; accepting this lets `fs::copy` finish.
+        Ok(())
+    }
+
+    pub fn set_times(&self, _times: FileTimes) -> io::Result<()> {
+        unsupported()
+    }
+}
+
+impl Drop for File {
+    fn drop(&mut self) {
+        unsafe { abi::n_handle_close(self.handle) };
+    }
+}
+
+impl fmt::Debug for File {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        let path = String::from_utf8_lossy(&self.path[..self.path.len() - 1]);
+        f.debug_struct("File").field("path", &path).field("handle", &self.handle).finish()
+    }
+}
+
+impl DirBuilder {
+    pub fn new() -> DirBuilder {
+        DirBuilder {}
+    }
+
+    pub fn mkdir(&self, p: &Path) -> io::Result<()> {
+        with_complete_path(p, &|full| cvt(unsafe { abi::n_folder_create(full) }).map(|_| ()))
+    }
+}
+
+pub fn readdir(p: &Path) -> io::Result<ReadDir> {
+    with_complete_path(p, &|full| {
+        let mut entries = Vec::new();
+        let mut page: Vec<n_entry> = (0..LIST_PAGE).map(|_| n_entry::zeroed()).collect();
+        let mut start = 0u64;
+        loop {
+            let count =
+                cvt(unsafe { abi::n_folder_list(full, page.as_mut_ptr(), page.len(), start) })?
+                    as usize;
+            for e in &page[..count.min(page.len())] {
+                let name = unsafe { CStr::from_ptr(e.name.as_ptr()) }.to_bytes();
+                if name == b"." || name == b".." {
+                    continue;
+                }
+                entries.push(DirEntry {
+                    root: p.to_path_buf(),
+                    // SAFETY: names are plain bytes.
+                    name: unsafe { OsString::from_encoded_bytes_unchecked(name.to_vec()) },
+                    attr: FileAttr::from_entry(e),
+                });
+            }
+            start += count as u64;
+            if count < page.len() {
+                break;
+            }
+        }
+        Ok(ReadDir { root: p.to_path_buf(), entries: entries.into_iter() })
+    })
+}
+
+pub fn unlink(p: &Path) -> io::Result<()> {
+    with_complete_path(p, &|full| {
+        if info(full)?.kind == abi::N_KIND_FOLDER {
+            return Err(io::Error::from_raw_os_error(abi::N_ERR_IS_FOLDER));
+        }
+        cvt(unsafe { abi::n_entry_remove(full) }).map(|_| ())
+    })
+}
+
+pub fn rename(old: &Path, new: &Path) -> io::Result<()> {
+    // The C library's `rename` replaces an existing document atomically;
+    // `n_entry_move` alone never replaces.
+    with_complete_path(old, &|old| {
+        with_complete_path(new, &|new| {
+            if unsafe { abi::rename(old, new) } == 0 {
+                Ok(())
+            } else {
+                Err(io::Error::last_os_error())
+            }
+        })
+    })
+}
+
+pub fn set_perm(_p: &Path, _perm: FilePermissions) -> io::Result<()> {
+    Ok(())
+}
+
+pub fn set_times(_p: &Path, _times: FileTimes) -> io::Result<()> {
+    unsupported()
+}
+
+pub fn set_times_nofollow(_p: &Path, _times: FileTimes) -> io::Result<()> {
+    unsupported()
+}
+
+pub fn rmdir(p: &Path) -> io::Result<()> {
+    with_complete_path(p, &|full| {
+        if info(full)?.kind != abi::N_KIND_FOLDER {
+            return Err(io::Error::from_raw_os_error(abi::N_ERR_NOT_FOLDER));
+        }
+        cvt(unsafe { abi::n_entry_remove(full) }).map(|_| ())
+    })
+}
+
+pub fn readlink(_p: &Path) -> io::Result<PathBuf> {
+    unsupported()
+}
+
+pub fn symlink(_original: &Path, _link: &Path) -> io::Result<()> {
+    unsupported()
+}
+
+pub fn link(_src: &Path, _dst: &Path) -> io::Result<()> {
+    unsupported()
+}
+
+pub fn stat(p: &Path) -> io::Result<FileAttr> {
+    with_complete_path(p, &|full| info(full))
+}
+
+pub fn lstat(p: &Path) -> io::Result<FileAttr> {
+    stat(p)
+}
+
+pub fn canonicalize(p: &Path) -> io::Result<PathBuf> {
+    with_complete_path(p, &|full| {
+        info(full)?;
+        Ok(unsafe { c_path(full) })
+    })
+}
