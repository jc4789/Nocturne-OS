index 0000000..daeb4f5
--- /dev/null
+++ b/library/std/src/sys/io/error/nocturne.rs
@@ -0,0 +1,54 @@
+//! OS error codes on Nocturne: the positive `N_ERR_*` numbers of the native ABI.
+
+use crate::io::ErrorKind;
+use crate::sys::pal::abi::*;
+
+pub fn errno() -> i32 {
+    // SAFETY: the C library keeps `errno` per thread.
+    unsafe { *__errno_location() }
+}
+
+pub fn is_interrupted(code: i32) -> bool {
+    code == N_ERR_CANCELLED || code == N_ERR_STOPPED
+}
+
+pub fn decode_error_kind(code: i32) -> ErrorKind {
+    match code {
+        N_ERR_NOT_FOUND | N_ERR_NO_APP => ErrorKind::NotFound,
+        N_ERR_EXISTS => ErrorKind::AlreadyExists,
+        N_ERR_DENIED | N_ERR_READ_ONLY => ErrorKind::PermissionDenied,
+        N_ERR_NO_MEMORY => ErrorKind::OutOfMemory,
+        N_ERR_INVALID | N_ERR_BAD_ADDRESS | N_ERR_WRONG_KIND | N_ERR_NOT_PROGRAM
+        | N_ERR_PROTOCOL => ErrorKind::InvalidInput,
+        N_ERR_BUSY | N_ERR_NOT_READY => ErrorKind::WouldBlock,
+        N_ERR_CLOSED => ErrorKind::BrokenPipe,
+        N_ERR_TIMEOUT => ErrorKind::TimedOut,
+        N_ERR_CANCELLED | N_ERR_STOPPED => ErrorKind::Interrupted,
+        N_ERR_TOO_LARGE | N_ERR_NAME_TOO_LONG | N_ERR_TOO_MANY_ARGUMENTS => {
+            ErrorKind::InvalidFilename
+        }
+        N_ERR_NOT_EMPTY => ErrorKind::DirectoryNotEmpty,
+        N_ERR_UNSUPPORTED => ErrorKind::Unsupported,
+        N_ERR_NOT_FOLDER => ErrorKind::NotADirectory,
+        N_ERR_IS_FOLDER => ErrorKind::IsADirectory,
+        N_ERR_NO_SPACE => ErrorKind::StorageFull,
+        N_ERR_CONNECTION_RESET => ErrorKind::ConnectionReset,
+        N_ERR_CONNECTION_REFUSED => ErrorKind::ConnectionRefused,
+        N_ERR_ADDRESS_IN_USE => ErrorKind::AddrInUse,
+        N_ERR_NETWORK_DOWN => ErrorKind::NetworkDown,
+        N_ERR_NOT_CONNECTED => ErrorKind::NotConnected,
+        N_ERR_UNREACHABLE => ErrorKind::HostUnreachable,
+        _ => ErrorKind::Uncategorized,
+    }
+}
+
+pub fn error_string(code: i32) -> String {
+    // SAFETY: `n_result_text` returns a static string for any code.
+    unsafe {
+        let p = n_result_text(-(code as i64));
+        if p.is_null() {
+            return format!("error {code}");
+        }
+        crate::ffi::CStr::from_ptr(p).to_string_lossy().into_owned()
+    }
+}
