+func setWriteBuffer(fd *netFD, bytes int) error { return syscall.ENOTSUP }
+func setLinger(fd *netFD, sec int) error        { return syscall.ENOTSUP }
+
+func setKeepAlive(fd *netFD, keepalive bool) error {
+	if keepalive {
+		return syscall.ENOTSUP
+	}
+	return nil
+}
+
+func setKeepAliveIdle(fd *netFD, d time.Duration) error     { return nil }
+func setKeepAliveInterval(fd *netFD, d time.Duration) error { return nil }
+func setKeepAliveCount(fd *netFD, n int) error              { return nil }
+
+func setIPv4MulticastInterface(fd *netFD, ifi *Interface) error { return syscall.ENOTSUP }
+func setIPv4MulticastLoopback(fd *netFD, v bool) error          { return syscall.ENOTSUP }
+func joinIPv4Group(fd *netFD, ifi *Interface, ip IP) error      { return syscall.ENOTSUP }
