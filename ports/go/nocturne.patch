diff --git a/src/os/dir_nocturne.go b/src/os/dir_nocturne.go
new file mode 100644
index 00000000..0994eecd
--- /dev/null
+++ b/src/os/dir_nocturne.go
@@ -0,0 +1,81 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package os
+
+import (
+	"io"
+	"io/fs"
+	"syscall"
+)
+
+// readdir lists the folder by path (FolderList), a batch of entries at a time.
+func (file *File) readdir(n int, mode readdirMode) (names []string, dirents []DirEntry, infos []FileInfo, err error) {
+	if file.kind != syscall.KIND_FOLDER {
+		return nil, nil, nil, &PathError{Op: "readdir", Path: file.name, Err: syscall.ENOTDIR}
+	}
+	var d *dirInfo
+	for {
+		d = file.dirinfo.Load()
+		if d != nil {
+			break
+		}
+		newD := new(dirInfo)
+		if file.dirinfo.CompareAndSwap(nil, newD) {
+			d = newD
+			break
+		}
+	}
+
+	d.mu.Lock()
+	defer d.mu.Unlock()
+
+	if n <= 0 {
+		n = -1
+	}
+	for n != 0 {
+		if d.pos >= d.n {
+			count, err := syscall.FolderList(file.path, d.entries[:], d.next)
+			if err != nil {
+				return names, dirents, infos, &PathError{Op: "readdir", Path: file.name, Err: err}
+			}
+			d.pos, d.n = 0, count
+			d.next += count
+			if count == 0 {
+				break
+			}
+		}
+		e := &d.entries[d.pos]
+		d.pos++
+		if mode == readdirName {
+			names = append(names, e.EntryName())
+		} else {
+			f := fileInfoFromEntry(e, joinFolder(file.path, e.EntryName()))
+			if mode == readdirDirEntry {
+				dirents = append(dirents, dirEntry{f})
+			} else {
+				infos = append(infos, f)
+			}
+		}
+		n--
+	}
+
+	if n > 0 && len(names)+len(dirents)+len(infos) == 0 {
+		return nil, nil, nil, io.EOF
+	}
+	return names, dirents, infos, nil
+}
+
+type dirEntry struct {
+	fs *fileStat
+}
+
+func (de dirEntry) Name() string            { return de.fs.Name() }
+func (de dirEntry) IsDir() bool             { return de.fs.IsDir() }
+func (de dirEntry) Type() FileMode          { return de.fs.Mode().Type() }
+func (de dirEntry) Info() (FileInfo, error) { return de.fs, nil }
+
+func (de dirEntry) String() string {
+	return fs.FormatDirEntry(de)
+}
diff --git a/src/os/exec/lp_nocturne.go b/src/os/exec/lp_nocturne.go
new file mode 100644
index 00000000..1d134b9c
--- /dev/null
+++ b/src/os/exec/lp_nocturne.go
@@ -0,0 +1,55 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package exec
+
+import (
+	"errors"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"syscall"
+)
+
+// ErrNotFound is the error resulting if a path search failed to find an executable file.
+var ErrNotFound = errors.New("program not found")
+
+// findExecutable accepts any document: Nocturne documents have no
+// permission bits, and the launcher checks that it is a program.
+func findExecutable(file string) error {
+	d, err := os.Stat(file)
+	if err != nil {
+		return err
+	}
+	if d.IsDir() {
+		return fs.ErrPermission
+	}
+	return nil
+}
+
+// lookPath finds a program as Nocturne's launchers do: a bare name in the
+// system's folder, then in each app's folder of C:\Programs; there is no
+// PATH. Any other name is in the current folder, or complete.
+func lookPath(file string) (string, error) {
+	if err := validateLookPath(filepath.Clean(file)); err != nil {
+		return "", &Error{file, err}
+	}
+	if filepath.Base(file) != file {
+		if err := findExecutable(file); err != nil {
+			return "", &Error{file, err}
+		}
+		return file, nil
+	}
+	path, err := syscall.FindProgram(file)
+	if err != nil {
+		return "", &Error{file, ErrNotFound}
+	}
+	return path, nil
+}
+
+// lookExtensions is a no-op on non-Windows platforms, since
+// they do not restrict executables to specific extensions.
+func lookExtensions(path, dir string) (string, error) {
+	return path, nil
+}
diff --git a/src/os/exec_nocturne.go b/src/os/exec_nocturne.go
new file mode 100644
index 00000000..9849a48a
--- /dev/null
+++ b/src/os/exec_nocturne.go
@@ -0,0 +1,190 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package os
+
+import (
+	"internal/strconv"
+	"runtime"
+	"syscall"
+	"time"
+)
+
+// Nocturne has no signals. Both of these stop the app (AppStop).
+var (
+	Interrupt Signal = stopSignal("interrupt")
+	Kill      Signal = stopSignal("kill")
+)
+
+type stopSignal string
+
+func (s stopSignal) String() string { return string(s) }
+func (stopSignal) Signal()          {}
+
+// startProcess launches the program with AppLaunch. The new app's handle
+// i is attr.Files[i] (none for a nil File or DevNull); attr.Dir becomes
+// its setting FOLDER.
+func startProcess(name string, argv []string, attr *ProcAttr) (p *Process, err error) {
+	env := attr.Env
+	if env == nil {
+		env = syscall.Environ()
+	}
+	if attr.Dir != "" {
+		dir := syscall.FullPath(attr.Dir)
+		var e syscall.Entry
+		if err := syscall.EntryInfo(dir, &e); err != nil {
+			return nil, &PathError{Op: "chdir", Path: attr.Dir, Err: err}
+		}
+		if e.Kind != syscall.KIND_FOLDER {
+			return nil, &PathError{Op: "chdir", Path: attr.Dir, Err: syscall.ENOTDIR}
+		}
+		kept := make([]string, 0, len(env)+1)
+		for _, s := range env {
+			if len(s) < 7 || s[:7] != "FOLDER=" {
+				kept = append(kept, s)
+			}
+		}
+		env = append(kept, "FOLDER="+dir)
+	}
+	handles := make([]int, len(attr.Files))
+	for i, f := range attr.Files {
+		handles[i] = -1
+		if f != nil && f.sysfd >= 0 && f.kind != 0 {
+			handles[i] = f.sysfd
+		}
+	}
+	h, e := syscall.AppLaunch(name, argv, env, handles)
+	for _, f := range attr.Files {
+		// the handles must stay open until the launch has copied them
+		runtime.KeepAlive(f)
+	}
+	if e != nil {
+		return nil, &PathError{Op: "launch", Path: name, Err: e}
+	}
+	id, _ := syscall.AppID(h)
+	return newHandleProcess(id, uintptr(h)), nil
+}
+
+func (ph *processHandle) closeHandle() {
+	syscall.Close(int(ph.handle))
+}
+
+func (p *Process) signal(sig Signal) error {
+	if sig != Kill && sig != Interrupt {
+		return syscall.ENOTSUP
+	}
+	h, status := p.handleTransientAcquire()
+	switch status {
+	case statusDone:
+		return ErrProcessDone
+	case statusReleased:
+		return syscall.EINVAL
+	}
+	defer p.handleTransientRelease()
+	if err := syscall.AppStop(int(h), 0); err != nil {
+		if err == syscall.ERR_STOPPED || err == syscall.ERR_NOT_FOUND {
+			return ErrProcessDone
+		}
+		return NewSyscallError("stop", err)
+	}
+	return nil
+}
+
+func (p *Process) kill() error {
+	return p.signal(Kill)
+}
+
+func (p *Process) wait() (ps *ProcessState, err error) {
+	h, status := p.handleTransientAcquire()
+	switch status {
+	case statusDone:
+		return nil, ErrProcessDone
+	case statusReleased:
+		return nil, syscall.EINVAL
+	}
+	defer p.handleTransientRelease()
+
+	code, err := syscall.AppResult(int(h), -1)
+	if err != nil {
+		return nil, NewSyscallError("wait", err)
+	}
+	p.doRelease(statusDone)
+	return &ProcessState{pid: p.Pid, status: code}, nil
+}
+
+func (p *Process) withHandle(f func(handle uintptr)) error {
+	h, status := p.handleTransientAcquire()
+	switch status {
+	case statusDone:
+		return ErrProcessDone
+	case statusReleased:
+		return syscall.EINVAL
+	}
+	defer p.handleTransientRelease()
+	f(h)
+	return nil
+}
+
+// findProcess opens the running app with identifier pid.
+func findProcess(pid int) (p *Process, err error) {
+	h, err := syscall.AppOpen(pid)
+	if err != nil {
+		if err == syscall.ERR_NOT_FOUND {
+			return nil, ErrProcessDone
+		}
+		return nil, NewSyscallError("open", err)
+	}
+	return newHandleProcess(pid, uintptr(h)), nil
+}
+
+// ProcessState stores information about a process, as reported by Wait.
+type ProcessState struct {
+	pid    int // The app's identifier.
+	status int // Its exit status.
+}
+
+// Pid returns the process id of the exited process.
+func (p *ProcessState) Pid() int {
+	return p.pid
+}
+
+func (p *ProcessState) exited() bool {
+	return true
+}
+
+func (p *ProcessState) success() bool {
+	return p.status == 0
+}
+
+func (p *ProcessState) sys() any {
+	return p.status
+}
+
+func (p *ProcessState) sysUsage() any {
+	return nil
+}
+
+func (p *ProcessState) userTime() time.Duration {
+	return 0
+}
+
+func (p *ProcessState) systemTime() time.Duration {
+	return 0
+}
+
+func (p *ProcessState) String() string {
+	if p == nil {
+		return "<nil>"
+	}
+	return "exit status " + strconv.Itoa(p.status)
+}
+
+// ExitCode returns the exit code of the exited process, or -1
+// if the process hasn't exited.
+func (p *ProcessState) ExitCode() int {
+	if p == nil {
+		return -1
+	}
+	return p.status
+}
