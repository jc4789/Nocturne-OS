+package os
+
+import "time"
+
+// A fileStat is the implementation of FileInfo returned by Stat and Lstat.
+type fileStat struct {
+	name    string
+	path    string // full path; "" for a handle not opened by name
+	size    int64
+	mode    FileMode
+	modTime time.Time
+	sys     any
+}
