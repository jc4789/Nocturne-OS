diff --git a/src/net/tcpsock_nocturne.go b/src/net/tcpsock_nocturne.go
new file mode 100644
index 00000000..e7b647d3
--- /dev/null
+++ b/src/net/tcpsock_nocturne.go
@@ -0,0 +1,99 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package net
+
+import (
+	"context"
+	"io"
+	"os"
+	"syscall"
+)
+
+func (c *TCPConn) readFrom(r io.Reader) (int64, error) {
+	return genericReadFrom(c, r)
+}
+
+func (c *TCPConn) writeTo(w io.Writer) (int64, error) {
+	return genericWriteTo(c, w)
+}
+
+func (sd *sysDialer) dialTCP(ctx context.Context, laddr, raddr *TCPAddr) (*TCPConn, error) {
+	if h := sd.testHookDialTCP; h != nil {
+		return h(ctx, sd.network, laddr, raddr)
+	}
+	if h := testHookDialTCP; h != nil {
+		return h(ctx, sd.network, laddr, raddr)
+	}
+	return sd.doDialTCP(ctx, laddr, raddr)
+}
+
+func (sd *sysDialer) doDialTCP(ctx context.Context, laddr, raddr *TCPAddr) (*TCPConn, error) {
+	switch sd.network {
+	case "tcp", "tcp4", "tcp6":
+	default:
+		return nil, UnknownNetworkError(sd.network)
+	}
+	if raddr == nil {
+		return nil, errMissingAddress
+	}
+	to, ok := sockaddr4(raddr.IP, raddr.Port)
+	if !ok {
+		return nil, errNotIPv4(raddr.IP)
+	}
+	// The system chooses the local port.
+	if laddr != nil && laddr.Port != 0 {
+		return nil, &AddrError{Err: "a local port cannot be chosen", Addr: laddr.String()}
+	}
+	id, err := connectTCP(ctx, to)
+	if err != nil {
+		return nil, err
+	}
+	fd := newFD(sd.network, id, false, tcpLocalAddr(id), raddr)
+	return newTCPConn(fd, sd.Dialer.KeepAlive, sd.Dialer.KeepAliveConfig, testPreHookSetKeepAlive, testHookSetKeepAlive), nil
+}
+
+func (ln *TCPListener) ok() bool { return ln != nil && ln.fd != nil }
+
+func (ln *TCPListener) accept() (*TCPConn, error) {
+	fd, err := ln.fd.accept()
+	if err != nil {
+		return nil, err
+	}
+	return newTCPConn(fd, ln.lc.KeepAlive, ln.lc.KeepAliveConfig, testPreHookSetKeepAlive, testHookSetKeepAlive), nil
+}
+
+func (ln *TCPListener) close() error {
+	return ln.fd.closeListener()
+}
+
+// file is not available: a listener is not a handle.
+func (ln *TCPListener) file() (*os.File, error) {
+	return nil, syscall.ENOTSUP
+}
+
+func (sl *sysListener) listenTCP(ctx context.Context, laddr *TCPAddr) (*TCPListener, error) {
+	switch sl.network {
+	case "tcp", "tcp4", "tcp6":
+	default:
+		return nil, UnknownNetworkError(sl.network)
+	}
+	var at syscall.Sockaddr4
+	if laddr != nil {
+		ip := laddr.IP
+		if ip.IsUnspecified() {
+			ip = nil // every local address, as for ":port" and "[::]:port"
+		}
+		var ok bool
+		if at, ok = sockaddr4(ip, laddr.Port); !ok {
+			return nil, errNotIPv4(laddr.IP)
+		}
+	}
+	id, err := syscall.TCPListen(at.IP, at.Port, maxListenerBacklog())
+	if err != nil {
+		return nil, os.NewSyscallError("listen", err)
+	}
+	fd := newFD(sl.network, id, false, tcpLocalAddr(id), nil)
+	return &TCPListener{fd: fd, lc: sl.ListenConfig}, nil
+}
diff --git a/src/net/udpsock_nocturne.go b/src/net/udpsock_nocturne.go
new file mode 100644
index 00000000..9f6b21a9
--- /dev/null
+++ b/src/net/udpsock_nocturne.go
@@ -0,0 +1,108 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package net
+
+import (
+	"context"
+	"net/netip"
+	"syscall"
+)
+
+func (c *UDPConn) readFrom(b []byte, addr *UDPAddr) (int, *UDPAddr, error) {
+	n, from, err := c.fd.readFrom(b)
+	if err != nil {
+		return n, nil, err
+	}
+	*addr = UDPAddr{IP: ipFromUint32(from.IP).To4(), Port: int(from.Port)}
+	return n, addr, nil
+}
+
+func (c *UDPConn) readFromAddrPort(b []byte) (int, netip.AddrPort, error) {
+	n, from, err := c.fd.readFrom(b)
+	if err != nil {
+		return n, netip.AddrPort{}, err
+	}
+	ip := netip.AddrFrom4([4]byte{byte(from.IP >> 24), byte(from.IP >> 16), byte(from.IP >> 8), byte(from.IP)})
+	return n, netip.AddrPortFrom(ip, from.Port), nil
+}
+
+// readMsg receives a datagram; Nocturne passes no ancillary data.
+func (c *UDPConn) readMsg(b, oob []byte) (n, oobn, flags int, addr netip.AddrPort, err error) {
+	n, addr, err = c.readFromAddrPort(b)
+	return n, 0, 0, addr, err
+}
+
+func (c *UDPConn) writeTo(b []byte, addr *UDPAddr) (int, error) {
+	if c.fd.raddr != nil {
+		return 0, ErrWriteToConnected
+	}
+	if addr == nil {
+		return 0, errMissingAddress
+	}
+	to, ok := sockaddr4(addr.IP, addr.Port)
+	if !ok {
+		return 0, errNotIPv4(addr.IP)
+	}
+	return c.fd.writeTo(b, to)
+}
+
+func (c *UDPConn) writeToAddrPort(b []byte, addr netip.AddrPort) (int, error) {
+	return c.writeTo(b, UDPAddrFromAddrPort(addr))
+}
+
+func (c *UDPConn) writeMsg(b, oob []byte, addr *UDPAddr) (n, oobn int, err error) {
+	if len(oob) > 0 {
+		return 0, 0, syscall.ENOTSUP
+	}
+	if c.fd.raddr != nil && addr == nil {
+		n, err = c.fd.Write(b)
+	} else {
+		n, err = c.writeTo(b, addr)
+	}
+	return n, 0, err
+}
+
+func (c *UDPConn) writeMsgAddrPort(b, oob []byte, addr netip.AddrPort) (n, oobn int, err error) {
+	if !addr.IsValid() {
+		return c.writeMsg(b, oob, nil)
+	}
+	return c.writeMsg(b, oob, UDPAddrFromAddrPort(addr))
+}
+
+func (sd *sysDialer) dialUDP(ctx context.Context, laddr, raddr *UDPAddr) (*UDPConn, error) {
+	if raddr == nil {
+		return nil, errMissingAddress
+	}
+	to, ok := sockaddr4(raddr.IP, raddr.Port)
+	if !ok {
+		return nil, errNotIPv4(raddr.IP)
+	}
+	port := 0
+	if laddr != nil {
+		port = laddr.Port
+	}
+	id, err := syscall.UDPSocket(uint16(port))
+	if err != nil {
+		return nil, wrapSyscallError("socket", err)
+	}
+	fd := newFD(sd.network, id, true, &UDPAddr{IP: localIP(), Port: port}, raddr)
+	fd.peer = to
+	return newUDPConn(fd), nil
+}
+
+func (sl *sysListener) listenUDP(ctx context.Context, laddr *UDPAddr) (*UDPConn, error) {
+	if _, ok := sockaddr4(laddr.IP, laddr.Port); !ok {
+		return nil, errNotIPv4(laddr.IP)
+	}
+	id, err := syscall.UDPSocket(uint16(laddr.Port))
+	if err != nil {
+		return nil, wrapSyscallError("socket", err)
+	}
+	return newUDPConn(newFD(sl.network, id, true, &UDPAddr{IP: localIP(), Port: laddr.Port}, nil)), nil
+}
+
+func (sl *sysListener) listenMulticastUDP(ctx context.Context, ifi *Interface, gaddr *UDPAddr) (*UDPConn, error) {
+	return nil, syscall.ENOTSUP
+}
