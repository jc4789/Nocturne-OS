+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package os
+
+import (
+	"internal/filepathlite"
+	"syscall"
+	"time"
+)
+
+// fileInfoFromEntry describes the entry at full path path. Nocturne
+// entries have no permission bits; the mode shows what an app may do.
+func fileInfoFromEntry(e *syscall.Entry, path string) *fileStat {
+	name := e.EntryName()
+	if name == "" {
+		name = filepathlite.Base(path)
+	}
+	fs := &fileStat{
+		name:    name,
+		path:    path,
+		size:    int64(e.Size),
+		modTime: time.Unix(e.Modified, 0),
+		sys:     e,
+	}
+	switch e.Kind {
+	case syscall.KIND_FOLDER:
+		fs.mode = ModeDir | 0777
+		fs.size = 0
+	case syscall.KIND_DEVICE:
+		fs.mode = ModeDevice | 0666
+	default:
+		fs.mode = 0666
+	}
+	return fs
+}
+
+func joinFolder(folder, name string) string {
+	if folder != "" && IsPathSeparator(folder[len(folder)-1]) {
+		return folder + name
+	}
+	return folder + string(PathSeparator) + name
+}
+
+// statNolog implements Stat for Nocturne.
+func statNolog(name string) (FileInfo, error) {
+	if name == DevNull {
+		return &fileStat{name: DevNull, path: DevNull, mode: ModeDevice | ModeCharDevice | 0666}, nil
+	}
+	full := syscall.FullPath(name)
+	e := new(syscall.Entry)
+	if err := syscall.EntryInfo(full, e); err != nil {
+		return nil, &PathError{Op: "stat", Path: name, Err: err}
+	}
+	return fileInfoFromEntry(e, filepathlite.Clean(full)), nil
+}
+
+// lstatNolog implements Lstat for Nocturne, which has no links.
+func lstatNolog(name string) (FileInfo, error) {
+	fi, err := statNolog(name)
+	if err != nil {
+		err.(*PathError).Op = "lstat"
+	}
+	return fi, err
+}
+
+// For testing.
+func atime(fi FileInfo) time.Time {
+	return fi.ModTime()
+}
