+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package time
+
+import "syscall"
+
+// Nocturne keeps no zoneinfo folder of its own; LoadLocation reads
+// $GOROOT/lib/time/zoneinfo.zip or the embedded time/tzdata.
+var platformZoneSources []string
+
+// initLocal takes the zone named by the setting TZ ("Asia/Tokyo", or a
+// zoneinfo document's full path); without one, local time is UTC.
+func initLocal() {
+	tz, _ := syscall.Getenv("TZ")
+	if tz != "" && tz[0] == ':' {
+		tz = tz[1:]
+	}
+	if tz != "" && tz != "UTC" {
+		sources := platformZoneSources
+		if tz[0] == '/' {
+			sources = []string{""}
+		}
+		if z, err := loadLocation(tz, sources); err == nil {
+			localLoc = *z
+			localLoc.name = tz
+			return
+		}
+	}
+	localLoc.name = "UTC"
+}
