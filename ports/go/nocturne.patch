diff --git a/src/internal/filepathlite/path_nocturne.go b/src/internal/filepathlite/path_nocturne.go
new file mode 100644
index 00000000..961e0f25
--- /dev/null
+++ b/src/internal/filepathlite/path_nocturne.go
@@ -0,0 +1,71 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package filepathlite
+
+import (
+	"internal/stringslite"
+	"syscall"
+)
+
+// Nocturne paths are drive paths on its one drive (syscall.FullPath):
+// "C:\Users\User\a.txt", with '\' or '/' between names.
+const (
+	Separator     = '\\' // OS-specific path separator
+	ListSeparator = ';'  // OS-specific path list separator
+)
+
+func IsPathSeparator(c uint8) bool {
+	return syscall.IsPathSeparator(c)
+}
+
+func isLocal(path string) bool {
+	if path == "" || IsPathSeparator(path[0]) {
+		return false
+	}
+	// A colon only follows a drive: no name holds one.
+	if stringslite.IndexByte(path, ':') >= 0 {
+		return false
+	}
+	path = Clean(path)
+	return path != ".." && !stringslite.HasPrefix(path, `..\`)
+}
+
+func localize(path string) (string, error) {
+	for i := 0; i < len(path); i++ {
+		switch path[i] {
+		case ':', '\\', 0:
+			return "", errInvalidPath
+		}
+	}
+	return FromSlash(path), nil
+}
+
+// IsAbs reports whether the path is absolute: whether a separator begins
+// it or follows its drive ("C:\a" or "\a"; "C:a" is in the current folder).
+func IsAbs(path string) bool {
+	return syscall.PathIsComplete(path)
+}
+
+// volumeNameLen returns the length of the path's drive ("C:"), or 0.
+func volumeNameLen(path string) int {
+	return syscall.PathDriveLength(path)
+}
+
+// postClean keeps Clean from giving a relative path a drive: "a/../c:b"
+// becomes `.\c:b`, not "c:b".
+func postClean(out *lazybuf) {
+	if out.volLen != 0 || out.buf == nil {
+		return
+	}
+	for _, c := range out.buf {
+		if IsPathSeparator(c) {
+			break
+		}
+		if c == ':' {
+			out.prepend('.', Separator)
+			return
+		}
+	}
+}
