+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package runtime
+
+import "unsafe"
+
+// Nocturne memory. A reservation is a demand-zero shared object mapped
+// read-write: its pages take frames only when first touched, so reserving
+// address space costs no memory and a reserved range is already usable.
+// The system chooses every address (see mallocinit), and a mapping is
+// released only as a whole.
+
+// nocturneReserve maps n bytes of demand-zero memory, or returns nil.
+//
+//go:nosplit
+func nocturneReserve(n uintptr) unsafe.Pointer {
+	h := syscall5(_SYS_SHARED_RESERVE, n, 0, 0, 0, 0)
+	if h < 0 {
+		return nil
+	}
+	// The mapping keeps the object; the handle is not needed.
+	va := syscall5(_SYS_SHARED_MAP, uintptr(h), n, _N_MEMORY_READ_WRITE, 0, 0)
+	syscall5(_SYS_HANDLE_CLOSE, uintptr(h), 0, 0, 0, 0)
+	if va <= 0 {
+		return nil
+	}
+	return unsafe.Pointer(uintptr(va))
+}
+
+// Don't split the stack as this function may be invoked without a valid G,
+// which prevents us from allocating more stack.
+//
+//go:nosplit
+func sysAllocOS(n uintptr, _ string) unsafe.Pointer {
+	return nocturneReserve(n)
+}
+
+func sysUnusedOS(v unsafe.Pointer, n uintptr) {
+	// The pages stay with the app until it releases the whole mapping.
+}
+
+func sysUsedOS(v unsafe.Pointer, n uintptr) {
+}
+
+func sysHugePageOS(v unsafe.Pointer, n uintptr) {
+}
+
+func sysNoHugePageOS(v unsafe.Pointer, n uintptr) {
+}
+
+func sysHugePageCollapseOS(v unsafe.Pointer, n uintptr) {
+}
+
+// Don't split the stack as this function may be invoked without a valid G,
+// which prevents us from allocating more stack.
+//
+//go:nosplit
+func sysFreeOS(v unsafe.Pointer, n uintptr) {
+	// Only a whole mapping can be released. Part of one (the trimmed
+	// ends of an aligned reservation) stays reserved, and costs nothing
+	// while untouched.
+	syscall5(_SYS_MEMORY_RELEASE, uintptr(v), n, 0, 0, 0)
+}
+
+func sysFaultOS(v unsafe.Pointer, n uintptr) {
+}
+
+func sysReserveOS(v unsafe.Pointer, n uintptr, _ string) unsafe.Pointer {
+	return nocturneReserve(n)
+}
+
+func sysMapOS(v unsafe.Pointer, n uintptr, _ string) {
+	// A reservation is already mapped read-write.
+}
+
+func needZeroAfterSysUnusedOS() bool {
+	return true
+}
