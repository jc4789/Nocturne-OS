+
+package os
+
+import "syscall"
+
+// executable finds the program by its first argument, as Nocturne's
+// launchers do (syscall.FindProgram).
+func executable() (string, error) {
+	if len(Args) == 0 || Args[0] == "" {
+		return "", ErrNotExist
+	}
+	full, err := syscall.FindProgram(Args[0])
+	if err != nil {
+		return "", ErrNotExist
+	}
+	return full, nil
+}
