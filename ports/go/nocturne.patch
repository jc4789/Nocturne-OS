new file mode 100644
index 00000000..c1346282
--- /dev/null
+++ b/src/os/executable_nocturne.go
@@ -0,0 +1,43 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package os
+
+import (
+	"internal/stringslite"
+	"syscall"
+)
+
+// executable finds the program as Nocturne's launcher does: the first
+// argument as a full path, or a name in the folders of the setting PATH.
+func executable() (string, error) {
+	if len(Args) == 0 || Args[0] == "" {
+		return "", ErrNotExist
+	}
+	name := Args[0]
+	if stringslite.IndexByte(name, '/') >= 0 {
+		return syscall.FullPath(name), nil
+	}
+	path := Getenv("PATH")
+	if path == "" {
+		path = "/bin:/data/bin"
+	}
+	for path != "" {
+		folder := path
+		if i := stringslite.IndexByte(path, PathListSeparator); i >= 0 {
+			folder, path = path[:i], path[i+1:]
+		} else {
+			path = ""
+		}
+		if folder == "" {
+			continue
+		}
+		full := joinFolder(syscall.FullPath(folder), name)
+		var e syscall.Entry
+		if syscall.EntryInfo(full, &e) == nil && e.Kind == syscall.KIND_DOCUMENT {
+			return full, nil
+		}
+	}
+	return "", ErrNotExist
+}
