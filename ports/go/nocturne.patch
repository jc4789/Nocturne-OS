@@ -0,0 +1,76 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package time
+
+import (
+	"errors"
+	"sync"
+	"syscall"
+)
+
+// for testing: whatever interrupts a sleep
+func interrupt() {
+}
+
+// Nocturne documents are read at offsets; read keeps each open document's
+// position for the sequential readers in this package.
+var (
+	readPosLock sync.Mutex
+	readPos     map[uintptr]int64
+)
+
+func open(name string) (uintptr, error) {
+	h, err := syscall.DocumentOpen(name, syscall.DOCUMENT_READ)
+	if err != nil {
+		return 0, err
+	}
+	return uintptr(h), nil
+}
+
+func read(fd uintptr, buf []byte) (int, error) {
+	readPosLock.Lock()
+	off := readPos[fd]
+	readPosLock.Unlock()
+	n, err := syscall.DocumentReadAt(int(fd), buf, off)
+	if n > 0 {
+		readPosLock.Lock()
+		if readPos == nil {
+			readPos = make(map[uintptr]int64)
+		}
+		readPos[fd] = off + int64(n)
+		readPosLock.Unlock()
+	}
+	return n, err
+}
+
+func closefd(fd uintptr) {
+	readPosLock.Lock()
+	delete(readPos, fd)
+	readPosLock.Unlock()
+	syscall.Close(int(fd))
+}
+
+func preadn(fd uintptr, buf []byte, off int) error {
+	pos := int64(off)
+	if off < 0 {
+		size, err := syscall.DocumentSize(int(fd))
+		if err != nil {
+			return err
+		}
+		pos = size + int64(off)
+	}
+	for len(buf) > 0 {
+		m, err := syscall.DocumentReadAt(int(fd), buf, pos)
+		if m <= 0 {
+			if err == nil {
+				return errors.New("short read")
+			}
+			return err
+		}
+		buf = buf[m:]
+		pos += int64(m)
+	}
+	return nil
+}
