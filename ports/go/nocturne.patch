+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package user
+
+import (
+	"os"
+	"syscall"
+)
+
+// Nocturne has one person at the machine and no user or group database.
+// Current describes them by the settings USER and HOME; Lookup and the
+// group calls are not supported.
+
+func init() {
+	userImplemented = false
+	groupImplemented = false
+	groupListImplemented = false
+}
+
+var (
+	// unused variables (in this implementation)
+	// modified during test to exercise code paths in the cgo implementation.
+	userBuffer  = 0
+	groupBuffer = 0
+)
+
+func current() (*User, error) {
+	name := os.Getenv("USER")
+	if name == "" {
+		name = "nocturne"
+	}
+	home, _ := os.UserHomeDir()
+	return &User{Uid: "0", Gid: "0", Username: name, Name: name, HomeDir: home}, nil
+}
+
+func lookupUser(username string) (*User, error) {
+	return nil, syscall.ENOTSUP
+}
+
+func lookupUserId(uid string) (*User, error) {
+	return nil, syscall.ENOTSUP
+}
+
+func lookupGroup(groupname string) (*Group, error) {
+	return nil, syscall.ENOTSUP
+}
+
