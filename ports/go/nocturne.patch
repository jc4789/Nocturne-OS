@@ -0,0 +1,93 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//
+// System calls for AMD64, Nocturne.
+// A call is INT $0x80 with the number in AX and the arguments in
+// DI, SI, DX, R10 and R8; the result (or a negated Nocturne result code)
+// comes back in AX and every other register is preserved.
+//
+
+#include "go_asm.h"
+#include "go_tls.h"
+#include "textflag.h"
+
+#define SYS_EXIT		0
+#define SYS_YIELD		28
+#define SYS_THREAD_EXIT		47
+#define SYS_THREAD_ID		50
+#define SYS_THREAD_TLS		52
+
+// func syscall5(n, a1, a2, a3, a4, a5 uintptr) int64
+TEXT runtime·syscall5(SB),NOSPLIT,$0-56
+	MOVQ	n+0(FP), AX
+	MOVQ	a1+8(FP), DI
+	MOVQ	a2+16(FP), SI
+	MOVQ	a3+24(FP), DX
+	MOVQ	a4+32(FP), R10
+	MOVQ	a5+40(FP), R8
+	INT	$0x80
+	MOVQ	AX, ret+48(FP)
+	RET
+
+// Ends the whole app, from any of its threads.
+TEXT runtime·exit(SB),NOSPLIT,$0-4
+	MOVL	code+0(FP), DI
+	MOVL	$SYS_EXIT, AX
+	INT	$0x80
+	INT	$3
+	JMP	0(PC)
+
+// func exitThread(wait *atomic.Uint32)
+TEXT runtime·exitThread(SB),NOSPLIT,$0-8
+	MOVQ	wait+0(FP), AX
+	// We're done using the stack.
+	MOVL	$0, (AX)
+	MOVL	$SYS_THREAD_EXIT, AX
+	INT	$0x80
+	INT	$3
+	JMP	0(PC)
+
+TEXT runtime·osyield(SB),NOSPLIT,$0
+	MOVL	$SYS_YIELD, AX
+	INT	$0x80
+	RET
+
+// set tls base to DI
+TEXT runtime·settls(SB),NOSPLIT,$0
+	ADDQ	$8, DI	// ELF wants to use -8(FS)
+	MOVQ	$16, SI	// g lives in the 8 bytes below FS
+	MOVL	$SYS_THREAD_TLS, AX
+	INT	$0x80
+	CMPQ	AX, $0
+	JEQ	2(PC)
+	MOVL	$0xf1, 0xf1  // crash
+	RET
+
+// The first instruction of a thread made by newosproc. The kernel starts
+// it on a stack of its own with DI = fn (an ABI0 function) and SI = m.
+TEXT runtime·tstart_nocturne(SB),NOSPLIT|TOPFRAME|NOFRAME,$0
+	MOVQ	DI, R12	// fn
+	MOVQ	SI, R13	// m
+
+	LEAQ	m_tls(R13), DI
+	CALL	runtime·settls(SB)
+
+	MOVL	$SYS_THREAD_ID, AX
+	INT	$0x80
+	MOVQ	AX, m_procid(R13)
+
+	MOVQ	m_g0(R13), R9
+	get_tls(CX)
+	MOVQ	R9, g(CX)
+	MOVQ	R9, R14	// set g register
+	MOVQ	$0, BP
+
+	CALL	R12
+
+	// mstart returns when an M on a system stack exits.
+	MOVL	$SYS_THREAD_EXIT, AX
+	INT	$0x80
+	INT	$3
+	JMP	0(PC)
