@@ -0,0 +1,428 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package runtime
+
+import (
+	"internal/abi"
+	"internal/runtime/atomic"
+	"internal/runtime/sys"
+	"unsafe"
+)
+
+// Nocturne system calls (common/abi.h of Nocturne). A failed call returns
+// a negated Nocturne result code.
+const (
+	_SYS_SLEEP               = 19
+	_SYS_UPTIME              = 20
+	_SYS_TIME                = 21
+	_SYS_CPU_INFO            = 38
+	_SYS_CLOCK_INFO          = 44
+	_SYS_THREAD_CREATE       = 45
+	_SYS_WAIT_ADDRESS        = 48
+	_SYS_WAKE_ADDRESS        = 49
+	_SYS_THREAD_STACK_BOUNDS = 58
+	_SYS_SHARED_RESERVE      = 88
+	_SYS_HANDLE_CLOSE        = 128
+	_SYS_DOCUMENT_OPEN       = 130
+	_SYS_DOCUMENT_WRITE_AT   = 132
+	_SYS_DOCUMENT_SIZE       = 133
+	_SYS_CHANNEL_SEND        = 145
+	_SYS_CHANNEL_RECEIVE     = 146
+	_SYS_SYSTEM_LOG_OPEN     = 160
+	_SYS_RANDOM              = 165
+	_SYS_MEMORY_RELEASE      = 167
+	_SYS_SHARED_MAP          = 169
+)
+
+const (
+	_N_ERR_WRONG_KIND = 6
+	_N_ERR_NO_HANDLE  = 7
+
+	_N_MEMORY_READ_WRITE = 2
+	_N_DOCUMENT_READ     = 1
+	_N_CHANNEL_WAIT      = 1
+
+	_N_CLOCK_USER_TSC     = 1
+	_N_CLOCK_HV_REFERENCE = 2
+)
+
+// syscall5 makes Nocturne system call n.
+//
+//go:noescape
+func syscall5(n, a1, a2, a3, a4, a5 uintptr) int64
+
+// The first instruction of a new thread (sys_nocturne_amd64.s).
+func tstart_nocturne()
+
+// nocturneSettings is the program's null-terminated "NAME=value" list,
+// recorded by _rt0_amd64_nocturne.
+var nocturneSettings unsafe.Pointer
+
+type mOS struct {
+	waitsema uint32 // semaphore for parking on locks
+}
+
+// ---- clocks ----
+
+// struct n_clockinfo
+type nocturneClockInfo struct {
+	version, flags  uint32
+	tscHz           uint64
+	tscSample       uint64
+	uptimeMs        uint64
+	referencePage   uint64
+	referenceSample uint64 // 100ns units
+}
+
+// struct n_reference_tsc, the Hyper-V reference page
+type nocturneReferenceTSC struct {
+	sequence uint32
+	reserved uint32
+	scale    uint64
+	offset   uint64
+}
+
+var nocturneClock nocturneClockInfo
+
+// nocturneWallBase is the wall clock in nanoseconds minus nanotime, taken
+// at start: the system wall clock counts whole seconds.
+var nocturneWallBase int64
+
+//go:nosplit
+func nanotime1() int64 {
+	c := &nocturneClock
+	if c.flags&_N_CLOCK_HV_REFERENCE != 0 && c.referencePage != 0 {
+		p := (*nocturneReferenceTSC)(unsafe.Pointer(uintptr(c.referencePage)))
+		for attempt := 0; attempt < 4; attempt++ {
+			sequence := atomic.Load(&p.sequence)
+			if sequence == 0 {
+				break
+			}
+			tsc := uint64(cputicks())
+			scale := atomic.Load64(&p.scale)
+			offset := atomic.Load64(&p.offset)
+			if sequence != atomic.Load(&p.sequence) {
+				continue
+			}
+			hi, _ := mul64(tsc, scale)
+			reference := hi + offset
+			if reference < c.referenceSample {
+				break
+			}
+			return int64(c.uptimeMs)*1e6 + int64(reference-c.referenceSample)*100
+		}
+	} else if c.flags&_N_CLOCK_USER_TSC != 0 && c.tscHz >= 1e6 {
+		now := uint64(cputicks())
+		if now >= c.tscSample {
+			d := now - c.tscSample
+			return int64(c.uptimeMs)*1e6 + int64(d/c.tscHz)*1e9 + int64(d%c.tscHz*1e9/c.tscHz)
+		}
+	}
+	return syscall5(_SYS_UPTIME, 0, 0, 0, 0, 0) * 1e6
+}
+
+// mul64 returns the 128-bit product of x and y.
+//
+//go:nosplit
+func mul64(x, y uint64) (hi, lo uint64) {
+	const mask32 = 1<<32 - 1
+	x0 := x & mask32
+	x1 := x >> 32
+	y0 := y & mask32
+	y1 := y >> 32
+	w0 := x0 * y0
+	t := x1*y0 + w0>>32
+	w1 := t & mask32
+	w2 := t >> 32
+	w1 += x0 * y1
+	hi = x1*y1 + w2 + w1>>32
+	lo = x * y
+	return
+}
+
+//go:nosplit
+func walltime() (sec int64, nsec int32) {
+	ns := nocturneWallBase + nanotime1()
+	return ns / 1e9, int32(ns % 1e9)
+}
+
+// ---- threads ----
+
+func futexsleep(addr *uint32, val uint32, ns int64) {
+	ms := uintptr(^uint32(0)) // no time limit
+	if ns >= 0 {
+		ms = uintptr((ns + 999999) / 1000000)
+		if ms >= uintptr(^uint32(0)) {
+			ms = uintptr(^uint32(0)) - 1
+		}
+	}
+	syscall5(_SYS_WAIT_ADDRESS, uintptr(unsafe.Pointer(addr)), uintptr(val), ms, 0, 0)
+}
+
+//go:nosplit
+func futexwakeup(addr *uint32, cnt uint32) {
+	if cnt == 0 {
+		return // Nocturne would wake every waiter
+	}
+	syscall5(_SYS_WAKE_ADDRESS, uintptr(unsafe.Pointer(addr)), uintptr(cnt), 0, 0, 0)
+}
+
+// struct n_cpuinfo
+type nocturneCPUInfo struct {
+	version, detected, online, workers, scheduler, flags uint32
+	parallelJobs, workerChunks                           uint64
+}
+
+func getCPUCount() int32 {
+	var info nocturneCPUInfo
+	if syscall5(_SYS_CPU_INFO, uintptr(unsafe.Pointer(&info)), 0, 0, 0, 0) < 0 || info.scheduler == 0 {
+		return 1
+	}
+	return int32(info.scheduler)
+}
+
+// May run with m.p==nil, so write barriers are not allowed.
+//
+//go:nowritebarrier
+func newosproc(mp *m) {
+	// The thread gets a stack of its own from the system
+	// (mStackIsSystemAllocated) and starts in tstart_nocturne.
+	r := syscall5(_SYS_THREAD_CREATE, abi.FuncPCABI0(mstart), uintptr(unsafe.Pointer(mp)), abi.FuncPCABI0(tstart_nocturne), 0, 0)
+	if r < 0 {
+		print("runtime: failed to create new OS thread (have ", mcount(), " already; result ", -r, ")\n")
+		throw("newosproc")
+	}
+}
+
+//go:nosplit
+func newosproc0(stacksize uintptr, fn unsafe.Pointer) {
+	throw("newosproc0: not implemented")
+}
+
+//go:nosplit
+func exitThread(wait *atomic.Uint32)
+
+// Called to initialize a new m (including the bootstrap m).
+// Called on the parent thread (main thread in case of bootstrap), can allocate memory.
+func mpreinit(mp *m) {
+	mp.gsignal = malg(32 * 1024)
+	mp.gsignal.m = mp
+}
+
+// Called to initialize a new m (including the bootstrap m).
+// Called on the new thread, cannot allocate memory.
+func minit() {
+	gp := getg()
+	if gp.m == &m0 {
+		return // rt0_go took its g0 stack from the main stack
+	}
+	// mstart0 guessed the bounds of the system stack; take the real ones.
+	var lo, hi uintptr
+	if syscall5(_SYS_THREAD_STACK_BOUNDS, uintptr(unsafe.Pointer(&lo)), uintptr(unsafe.Pointer(&hi)), 0, 0, 0) < 0 {
+		return
+	}
+	g0 := gp.m.g0
+	sp := sys.GetCallerSP()
+	if sp <= lo || sp > hi || g0.stack.hi > hi {
+		print("runtime: thread stack [", hex(lo), ", ", hex(hi), ") does not hold sp ", hex(sp), "\n")
+		throw("minit: bad thread stack")
+	}
+	g0.stack.lo = lo
+	g0.stackguard0 = g0.stack.lo + stackGuard
+	g0.stackguard1 = g0.stackguard0
+}
+
+// Called from dropm to undo the effect of an minit.
+func unminit() {
+}
+
+// Called from mexit, but not from dropm, to undo the effect of thread-owned
+// resources in minit, semacreate, or elsewhere. Do not take locks after calling this.
+//
+//go:nowritebarrierrec
+func mdestroy(mp *m) {
+}
+
+//go:nosplit
+func osyield()
+
+//go:nosplit
+func osyield_no_g() {
+	osyield()
+}
+
+// usleep sleeps for at least usec microseconds. The system sleeps in whole
+// milliseconds, so a short sleep yields the CPU instead.
+//
+//go:nosplit
+func usleep(usec uint32) {
+	if usec < 100 {
+		osyield()
+		return
+	}
+	syscall5(_SYS_SLEEP, uintptr((usec+999)/1000), 0, 0, 0, 0)
+}
+
+//go:nosplit
+func usleep_no_g(usec uint32) {
+	usleep(usec)
+}
+
+// ---- start and end ----
+
+func osinit() {
+	numCPUStartup = getCPUCount()
+	physPageSize = 4096
+	nocturneClock.version = 1
+	if syscall5(_SYS_CLOCK_INFO, uintptr(unsafe.Pointer(&nocturneClock)), 0, 0, 0, 0) < 0 {
+		nocturneClock = nocturneClockInfo{}
+	}
+	nocturneWallBase = syscall5(_SYS_TIME, 0, 0, 0, 0, 0)*1e9 - nanotime1()
+}
+
+func goenvs() {
+	if nocturneSettings == nil {
+		return
+	}
+	settings := (**byte)(nocturneSettings)
+	n := int32(0)
+	for argv_index(settings, n) != nil {
+		n++
+	}
+	envs = make([]string, n)
+	for i := int32(0); i < n; i++ {
+		envs[i] = gostring(argv_index(settings, i))
+	}
+}
+
+//go:nosplit
+func exit(code int32)
+
+func readRandom(r []byte) int {
+	if len(r) == 0 || syscall5(_SYS_RANDOM, uintptr(unsafe.Pointer(&r[0])), uintptr(len(r)), 0, 0, 0) < 0 {
+		return 0
+	}
+	return len(r)
+}
+
+//go:nosplit
+//go:nowritebarrierrec
+func libpreinit() {}
+
+func crash() {
+	abort()
+}
+
+// ---- handles used by the runtime itself ----
+
+// nocturneLog is the system log handle, opened when the app has no log
+// handle 2 for the runtime's own messages; -1 until then.
+var nocturneLog int32 = -1
+
+// write1 sends a message on output handle fd. A document handle takes the
+// bytes at its end.
+//
+//go:nosplit
+func write1(fd uintptr, p unsafe.Pointer, n int32) int32 {
+	r := syscall5(_SYS_CHANNEL_SEND, fd, uintptr(p), uintptr(n), ^uintptr(0), 0)
+	if r == -_N_ERR_NO_HANDLE && fd == 2 {
+		h := atomic.Load((*uint32)(unsafe.Pointer(&nocturneLog)))
+		if int32(h) < 0 {
+			opened := syscall5(_SYS_SYSTEM_LOG_OPEN, 0, 0, 0, 0, 0)
+			if opened < 0 {
+				return int32(r)
+			}
+			if !atomic.Cas((*uint32)(unsafe.Pointer(&nocturneLog)), h, uint32(opened)) {
+				syscall5(_SYS_HANDLE_CLOSE, uintptr(opened), 0, 0, 0, 0)
+			}
+			h = atomic.Load((*uint32)(unsafe.Pointer(&nocturneLog)))
+		}
+		fd = uintptr(h)
+		r = syscall5(_SYS_CHANNEL_SEND, fd, uintptr(p), uintptr(n), ^uintptr(0), 0)
+	}
+	if r == -_N_ERR_WRONG_KIND {
+		size := syscall5(_SYS_DOCUMENT_SIZE, fd, 0, 0, 0, 0)
+		if size < 0 {
+			return int32(size)
+		}
+		r = syscall5(_SYS_DOCUMENT_WRITE_AT, fd, uintptr(size), uintptr(p), uintptr(n), 0)
+	}
+	if r < 0 {
+		return int32(r)
+	}
+	return n
+}
+
+// read receives the next message on input handle fd.
+func read(fd int32, p unsafe.Pointer, n int32) int32 {
+	return int32(syscall5(_SYS_CHANNEL_RECEIVE, uintptr(fd), uintptr(p), uintptr(n), _N_CHANNEL_WAIT, 0))
+}
+
+// open opens a document for reading.
+func open(name *byte, mode, perm int32) int32 {
+	return int32(syscall5(_SYS_DOCUMENT_OPEN, uintptr(unsafe.Pointer(name)), _N_DOCUMENT_READ, 0, 0, 0))
+}
+
+func closefd(fd int32) int32 {
+	return int32(syscall5(_SYS_HANDLE_CLOSE, uintptr(fd), 0, 0, 0, 0))
+}
+
+// ---- no signals ----
+//
+// Nocturne has no signals: an app is stopped through its app handle, and a
+// fault ends the app. Goroutines are preempted cooperatively.
+
+type sigset struct{}
+
+type gsignalStack struct{}
+
+const _NSIG = 0
+
+const _SIGSEGV = 0xb
+
+const preemptMSupported = false
+
+func sigpanic() {
+	gp := getg()
+	if !canpanic() {
+		throw("unexpected signal during runtime execution")
+	}
+	gp.sig = _SIGSEGV
+	panicmem()
+}
+
+func sigsave(p *sigset) {
+}
+
+func msigrestore(sigmask sigset) {
+}
+
+//go:nosplit
+//go:nowritebarrierrec
+func clearSignalHandlers() {
+}
+
+func sigblock(exiting bool) {
+}
+
+func initsig(preinit bool) {
+}
+
+func signame(sig uint32) string {
+	return ""
+}
+
+func preemptM(mp *m) {
+}
+
+func setProcessCPUProfiler(hz int32) {}
+func setThreadCPUProfiler(hz int32)  {}
+func sigdisable(uint32)              {}
+func sigenable(uint32)               {}
+func sigignore(uint32)               {}
+
+func os_sigpipe() {}
+
+func madvise(addr unsafe.Pointer, n uintptr, flags int32) int32 { return 0 }
