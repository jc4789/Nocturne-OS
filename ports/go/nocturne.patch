diff --git a/src/net/fd_nocturne.go b/src/net/fd_nocturne.go
new file mode 100644
index 00000000..a01d29b2
--- /dev/null
+++ b/src/net/fd_nocturne.go
@@ -0,0 +1,302 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package net
+
+import (
+	"internal/poll"
+	"io"
+	"os"
+	"sync/atomic"
+	"syscall"
+	"time"
+)
+
+// waitSlice bounds each wait in the system, in milliseconds, so that a
+// blocked Read or Write notices Close and deadline changes. Nocturne's TCP
+// and UDP calls take a timeout, not a cancellation handle.
+const waitSlice = 250
+
+// netFD is a Nocturne TCP connection or UDP socket. Both are numbered by
+// the network calls themselves, not handles.
+type netFD struct {
+	pfd poll.FD
+
+	// immutable until Close
+	net          string
+	id           int
+	udp          bool
+	laddr, raddr Addr
+	peer         syscall.Sockaddr4 // a dialed UDP socket's remote address
+
+	closing              atomic.Bool
+	rdeadline, wdeadline atomic.Int64 // UnixNano; 0 is none
+}
+
+func newFD(net string, id int, udp bool, laddr, raddr Addr) *netFD {
+	fd := &netFD{net: net, id: id, udp: udp, laddr: laddr, raddr: raddr}
+	fd.pfd.Sysfd = id
+	fd.pfd.Destroy = fd.destroy
+	return fd
+}
+
+func (fd *netFD) destroy() {
+	if fd.udp {
+		syscall.UDPClose(fd.id)
+	} else {
+		syscall.TCPClose(fd.id)
+	}
+}
+
+func (fd *netFD) name() string {
+	var ls, rs string
+	if fd.laddr != nil {
+		ls = fd.laddr.String()
+	}
+	if fd.raddr != nil {
+		rs = fd.raddr.String()
+	}
+	return fd.net + ":" + ls + "->" + rs
+}
+
+// Close stops new use of fd at once. Users blocked in the system see it
+// within waitSlice; the last one gives the connection up, so queued data
+// is still sent.
+func (fd *netFD) Close() error {
+	fd.closing.Store(true)
+	return fd.pfd.Close()
+}
+
+// wait returns how long the next wait in the system may last.
+func (fd *netFD) wait(deadline *atomic.Int64) (int, error) {
+	if fd.closing.Load() {
+		return 0, poll.ErrNetClosing
+	}
+	d := deadline.Load()
+	if d == 0 {
+		return waitSlice, nil
+	}
+	left := time.Until(time.Unix(0, d))
+	if left <= 0 {
+		return 0, poll.ErrDeadlineExceeded
+	}
+	return int(min((left+time.Millisecond-1)/time.Millisecond, waitSlice)), nil
+}
+
+func (fd *netFD) Read(b []byte) (int, error) {
+	if fd.udp {
+		n, _, err := fd.readFrom(b)
+		return n, err
+	}
+	n, err := fd.pfd.Read(fd.recv, b)
+	return n, wrapSyscallError("read", err)
+}
+
+func (fd *netFD) recv(b []byte) (int, error) {
+	for {
+		ms, err := fd.wait(&fd.rdeadline)
+		if err != nil {
+			return 0, err
+		}
+		n, err := syscall.TCPRecv(fd.id, b, ms)
+		switch {
+		case err == syscall.ERR_NOT_READY:
+			continue
+		case err != nil:
+			return 0, err
+		case n == 0:
+			return 0, io.EOF
+		}
+		return n, nil
+	}
+}
+
+func (fd *netFD) Write(b []byte) (int, error) {
+	if fd.udp {
+		if fd.raddr == nil {
+			return 0, errMissingAddress
+		}
+		return fd.writeTo(b, fd.peer)
+	}
+	n, err := fd.pfd.Write(fd.send, b)
+	return n, wrapSyscallError("write", err)
+}
+
+func (fd *netFD) send(b []byte) (int, error) {
+	done := 0
+	for done < len(b) {
+		ms, err := fd.wait(&fd.wdeadline)
+		if err != nil {
+			return done, err
+		}
+		n, err := syscall.TCPSendUntil(fd.id, b[done:], syscall.Uptime()+uint64(ms), 0)
+		done += n
+		if err != nil && err != syscall.ERR_TIMEOUT {
+			return done, err
+		}
+	}
+	return done, nil
+}
+
+// readFrom receives one datagram; a dialed socket takes only its peer's.
+func (fd *netFD) readFrom(b []byte) (n int, from syscall.Sockaddr4, err error) {
+	n, err = fd.pfd.Read(func(b []byte) (int, error) {
+		for {
+			ms, err := fd.wait(&fd.rdeadline)
+			if err != nil {
+				return 0, err
+			}
+			n, err = syscall.UDPRecv(fd.id, b, ms, &from)
+			if err == syscall.ERR_NOT_READY {
+				continue
+			}
+			if err == nil && fd.raddr != nil && from != fd.peer {
+				continue
+			}
+			return n, err
+		}
+	}, b)
+	return n, from, wrapSyscallError("recvfrom", err)
+}
+
+func (fd *netFD) writeTo(b []byte, to syscall.Sockaddr4) (int, error) {
+	if len(b) > syscall.UDPMaxPayload {
+		return 0, wrapSyscallError("sendto", syscall.ERR_TOO_LARGE)
+	}
+	n, err := fd.pfd.Write(func(b []byte) (int, error) {
+		return syscall.UDPSend(fd.id, to.IP, to.Port, b)
+	}, b)
+	return n, wrapSyscallError("sendto", err)
+}
+
+func (fd *netFD) closeRead() error {
+	return syscall.ENOTSUP
+}
+
+// closeWrite sends the FIN after what is queued; reading goes on.
+func (fd *netFD) closeWrite() error {
+	if fd.udp {
+		return syscall.ENOTSUP
+	}
+	var err error
+	if e := fd.pfd.RawControl(func(uintptr) { err = syscall.TCPFinish(fd.id) }); e != nil {
+		return e
+	}
+	return wrapSyscallError("shutdown", err)
+}
+
+func setDeadline(d *atomic.Int64, t time.Time) {
+	if t.IsZero() {
+		d.Store(0)
+	} else {
+		d.Store(max(t.UnixNano(), 1))
+	}
+}
+
+func (fd *netFD) SetDeadline(t time.Time) error {
+	setDeadline(&fd.rdeadline, t)
+	setDeadline(&fd.wdeadline, t)
+	return nil
+}
+
+func (fd *netFD) SetReadDeadline(t time.Time) error {
+	setDeadline(&fd.rdeadline, t)
+	return nil
+}
+
+func (fd *netFD) SetWriteDeadline(t time.Time) error {
+	setDeadline(&fd.wdeadline, t)
+	return nil
+}
+
+// accept takes a listener's next connection.
+func (fd *netFD) accept() (*netFD, error) {
+	var remote syscall.Sockaddr4
+	id, err := fd.pfd.Accept(func() (int, error) {
+		for {
+			ms, err := fd.wait(&fd.rdeadline)
+			if err != nil {
+				return -1, err
+			}
+			id, err := syscall.TCPAccept(fd.id, ms, &remote)
+			if err == syscall.ERR_NOT_READY {
+				continue
+			}
+			if err != nil && fd.closing.Load() {
+				return -1, poll.ErrNetClosing
+			}
+			return id, err
+		}
+	})
+	if err != nil {
+		return nil, wrapSyscallError("accept", err)
+	}
+	return newFD(fd.net, id, false, tcpLocalAddr(id), &TCPAddr{IP: ipFromUint32(remote.IP), Port: int(remote.Port)}), nil
+}
+
+// closeListener ends a listener at once: the system refuses connections
+// not yet accepted and wakes a blocked accept.
+func (fd *netFD) closeListener() error {
+	if !fd.closing.Swap(true) {
+		// Only the first Close gets here, before the number is given up.
+		syscall.TCPCancel(fd.id)
+	}
+	return fd.pfd.Close()
+}
+
+// tcpLocalAddr is a connection's or listener's local address.
+func tcpLocalAddr(id int) *TCPAddr {
+	var local syscall.Sockaddr4
+	if syscall.TCPAddress(id, &local, nil) != nil {
+		return &TCPAddr{IP: localIP()}
+	}
+	return &TCPAddr{IP: ipFromUint32(local.IP), Port: int(local.Port)}
+}
+
+// dup is not available: network connections are not handles.
+func (fd *netFD) dup() (*os.File, error) {
+	return nil, syscall.ENOTSUP
+}
+
+// sockaddr4 converts an IPv4 address for the network calls.
+func sockaddr4(ip IP, port int) (syscall.Sockaddr4, bool) {
+	if len(ip) == 0 {
+		ip = IPv4zero
+	}
+	ip4 := ip.To4()
+	if ip4 == nil || port < 0 || port > 0xffff {
+		return syscall.Sockaddr4{}, false
+	}
+	return syscall.Sockaddr4{
+		IP:   uint32(ip4[0])<<24 | uint32(ip4[1])<<16 | uint32(ip4[2])<<8 | uint32(ip4[3]),
+		Port: uint16(port),
+	}, true
+}
+
+func ipFromUint32(v uint32) IP {
+	return IPv4(byte(v>>24), byte(v>>16), byte(v>>8), byte(v))
+}
+
+// localIP is this system's address, for a connection's local address.
+func localIP() IP {
+	var ni syscall.NetInfo
+	if syscall.GetNetInfo(&ni) != nil || ni.Present == 0 {
+		return IPv4zero
+	}
+	return IPv4(ni.IP[0], ni.IP[1], ni.IP[2], ni.IP[3])
+}
+
+func wrapSyscallError(name string, err error) error {
+	if _, ok := err.(syscall.Errno); ok {
+		err = os.NewSyscallError(name, err)
+	}
+	return err
+}
+
+func isConnError(err error) bool {
+	if se, ok := err.(syscall.Errno); ok {
+		return se == syscall.ECONNRESET
+	}
+	return false
+}
diff --git a/src/net/interface_nocturne.go b/src/net/interface_nocturne.go
