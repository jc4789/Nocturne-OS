diff --git a/src/internal/poll/fd_nocturne.go b/src/internal/poll/fd_nocturne.go
new file mode 100644
index 00000000..1196d78c
--- /dev/null
+++ b/src/internal/poll/fd_nocturne.go
@@ -0,0 +1,117 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package poll
+
+import (
+	"syscall"
+	"time"
+)
+
+// FD serializes the users of a Nocturne handle. Nocturne calls block in
+// the system (syscall.Syscall lets other goroutines run meanwhile); there
+// is no poller, so deadlines are not supported.
+type FD struct {
+	// Lock sysfd and serialize access to Read and Write methods.
+	fdmu fdMutex
+
+	// The handle.
+	Sysfd int
+
+	// Destroy releases the handle once its last user is done.
+	Destroy func()
+
+	// Whether this is a document or folder rather than a connection;
+	// shared code in fd_mutex.go checks it.
+	isFile bool
+}
+
+func (fd *FD) destroy() error {
+	if fd.Destroy != nil {
+		fd.Destroy()
+	}
+	return nil
+}
+
+// Close handles the locking for closing an FD.
+func (fd *FD) Close() error {
+	if !fd.fdmu.increfAndClose() {
+		return errClosing(fd.isFile)
+	}
+	return fd.decref()
+}
+
+// Read implements io.Reader through fn.
+func (fd *FD) Read(fn func([]byte) (int, error), b []byte) (int, error) {
+	if err := fd.readLock(); err != nil {
+		return 0, err
+	}
+	defer fd.readUnlock()
+	if len(b) == 0 {
+		return 0, nil
+	}
+	return fn(b)
+}
+
+// Write implements io.Writer through fn.
+func (fd *FD) Write(fn func([]byte) (int, error), b []byte) (int, error) {
+	if err := fd.writeLock(); err != nil {
+		return 0, err
+	}
+	defer fd.writeUnlock()
+	return fn(b)
+}
+
+func (fd *FD) SetDeadline(t time.Time) error      { return ErrNoDeadline }
+func (fd *FD) SetReadDeadline(t time.Time) error  { return ErrNoDeadline }
+func (fd *FD) SetWriteDeadline(t time.Time) error { return ErrNoDeadline }
+
+// RawControl invokes the user-defined function f for a non-IO operation.
+func (fd *FD) RawControl(f func(uintptr)) error {
+	if err := fd.incref(); err != nil {
+		return err
+	}
+	defer fd.decref()
+	f(uintptr(fd.Sysfd))
+	return nil
+}
+
+// FDMutex is an exported fdMutex, only for package os.
+type FDMutex struct {
+	fdmu fdMutex
+}
+
+func (fdmu *FDMutex) Incref() bool {
+	return fdmu.fdmu.incref()
+}
+
+func (fdmu *FDMutex) Decref() bool {
+	return fdmu.fdmu.decref()
+}
+
+func (fdmu *FDMutex) IncrefAndClose() bool {
+	return fdmu.fdmu.increfAndClose()
+}
+
+func (fdmu *FDMutex) ReadLock() bool {
+	return fdmu.fdmu.rwlock(readlock, waitLock)
+}
+
+func (fdmu *FDMutex) ReadUnlock() bool {
+	return fdmu.fdmu.rwunlock(readlock)
+}
+
+func (fdmu *FDMutex) WriteLock() bool {
+	return fdmu.fdmu.rwlock(writeLock, waitLock)
+}
+
+func (fdmu *FDMutex) WriteUnlock() bool {
+	return fdmu.fdmu.rwunlock(writeLock)
+}
+
+// DupCloseOnExec is not available: Nocturne handles are not duplicated,
+// and an app receives only the handles its launcher names.
+func DupCloseOnExec(fd int) (int, string, error) {
+	return -1, "dup", syscall.ENOTSUP
+}
