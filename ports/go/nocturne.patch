+#include "textflag.h"
+
+// func rawSyscall(n, a1, a2, a3, a4, a5 uintptr) int64
+// A Nocturne system call: INT $0x80 with the number in AX and the
+// arguments in DI, SI, DX, R10 and R8. AX returns the result, or a
+// negated Nocturne result code; every other register is preserved.
+TEXT ·rawSyscall(SB),NOSPLIT,$0-56
+	MOVQ	n+0(FP), AX
+	MOVQ	a1+8(FP), DI
+	MOVQ	a2+16(FP), SI
+	MOVQ	a3+24(FP), DX
+	MOVQ	a4+32(FP), R10
+	MOVQ	a5+40(FP), R8
+	INT	$0x80
+	MOVQ	AX, ret+48(FP)
+	RET
