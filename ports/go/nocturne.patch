+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+// Nocturne system calls. Nocturne is not Unix: its resources are typed
+// handles; documents and folders are named by full paths and read and
+// written at offsets (there is no shared cursor and no working folder);
+// channels carry messages; apps are launched with an explicit table of
+// handles and stopped through their app handle. There are no signals.
+// See docs/nocturne-native-abi.md in the Nocturne sources.
+
+package syscall
+
+import (
+	errorspkg "errors"
+	"internal/bytealg"
+	"internal/oserror"
+	"internal/strconv"
+	"unsafe"
+)
+
+const ImplementsGetwd = true
+
+// System call numbers (common/abi.h of Nocturne).
+const (
+	SYS_EXIT              = 0
+	SYS_SLEEP             = 19
+	SYS_UPTIME            = 20
+	SYS_TIME              = 21
+	SYS_YIELD             = 28
+	SYS_HANDLE_CLOSE      = 128
+	SYS_HANDLE_KIND       = 129
+	SYS_DOCUMENT_OPEN     = 130
+	SYS_DOCUMENT_READ_AT  = 131
+	SYS_DOCUMENT_WRITE_AT = 132
+	SYS_DOCUMENT_SIZE     = 133
+	SYS_DOCUMENT_SET_SIZE = 134
+	SYS_DOCUMENT_CLAIM    = 135
+	SYS_DOCUMENT_RELEASE  = 136
+	SYS_DOCUMENT_SAVE     = 137
+	SYS_DOCUMENT_APPEND   = 138
+	SYS_DOCUMENT_COMMIT   = 185
+	SYS_ENTRY_INFO        = 139
+	SYS_ENTRY_REMOVE      = 140
+	SYS_ENTRY_MOVE        = 141
+	SYS_FOLDER_CREATE     = 142
+	SYS_FOLDER_LIST       = 143
+	SYS_CHANNEL_PAIR      = 144
+	SYS_CHANNEL_SEND      = 145
+	SYS_CHANNEL_RECEIVE   = 146
+	SYS_APP_LAUNCH        = 147
+	SYS_APP_RESULT        = 148
+	SYS_APP_STOP          = 149
+	SYS_APP_SELF          = 150
+	SYS_APP_PARENT        = 151
+	SYS_APP_OPEN          = 158
+	SYS_APP_ID            = 159
+	SYS_SYSTEM_LOG_OPEN   = 160
+	SYS_RANDOM            = 165
+)
+
+// Handle kinds.
+const (
+	KIND_DOCUMENT   = 1
+	KIND_FOLDER     = 2
+	KIND_CHANNEL    = 3
+	KIND_WINDOW     = 4
+	KIND_SHARED     = 5
+	KIND_APP        = 6
+	KIND_EVENTS     = 7
+	KIND_DEVICE     = 8
+	KIND_CONNECTION = 9
+)
+
+// DocumentOpen access: one of these, not a bit set.
+const (
+	DOCUMENT_READ    = 1 // read an existing document
+	DOCUMENT_EDIT    = 2 // read and write an existing document
+	DOCUMENT_CREATE  = 3 // a new, empty document; ERR_EXISTS if the name is taken
+	DOCUMENT_REPLACE = 4 // new content, swapped in whole by Close
+)
+
+// DocumentCommit modes.
+const (
+	COMMIT_WAIT   = 1 // until it is on the medium
+	COMMIT_START  = 2 // return at once
+	COMMIT_RESULT = 3 // the last started commit's outcome (ERR_NOT_READY: not yet)
+)
+
+// ChannelReceive flags.
+const (
+	CHANNEL_WAIT    = 1
+	CHANNEL_PEEK    = 2 // report the next message's size, leave it queued
+	CHANNEL_DISCARD = 4 // copy up to len(p) bytes of the next message, then drop it
+)
+
+// AppStop flags.
+const APP_STOP_TREE = 1 // also stop every app it launched
+
+// Errno is a Nocturne result code.
+type Errno uintptr
+
+const (
+	ERR_NOT_FOUND          Errno = 1
+	ERR_EXISTS             Errno = 2
+	ERR_DENIED             Errno = 3
+	ERR_NO_MEMORY          Errno = 4
+	ERR_INVALID            Errno = 5
+	ERR_WRONG_KIND         Errno = 6
+	ERR_NO_HANDLE          Errno = 7
+	ERR_BUSY               Errno = 8
+	ERR_NOT_READY          Errno = 9
+	ERR_CLOSED             Errno = 10
+	ERR_TIMEOUT            Errno = 11
+	ERR_CANCELLED          Errno = 12
+	ERR_TOO_LARGE          Errno = 13
+	ERR_NOT_EMPTY          Errno = 14
+	ERR_IO                 Errno = 15
+	ERR_UNSUPPORTED        Errno = 16
+	ERR_BAD_ADDRESS        Errno = 17
+	ERR_STOPPED            Errno = 18
+	ERR_NOT_FOLDER         Errno = 19
+	ERR_IS_FOLDER          Errno = 20
+	ERR_READ_ONLY          Errno = 21
+	ERR_NO_SPACE           Errno = 22
+	ERR_NOT_PROGRAM        Errno = 23
+	ERR_NAME_TOO_LONG      Errno = 24
+	ERR_NO_APP             Errno = 25
+	ERR_TOO_MANY_ARGUMENTS Errno = 26
+	ERR_CONNECTION_RESET   Errno = 27
+	ERR_CONNECTION_REFUSED Errno = 28
+	ERR_ADDRESS_IN_USE     Errno = 29
+	ERR_NETWORK_DOWN       Errno = 30
+	ERR_NOT_CONNECTED      Errno = 31
+	ERR_UNREACHABLE        Errno = 32
+	ERR_PROTOCOL           Errno = 33
+)
+
+var errors = [...]string{
+	ERR_NOT_FOUND:          "not found",
+	ERR_EXISTS:             "already exists",
+	ERR_DENIED:             "not permitted",
+	ERR_NO_MEMORY:          "out of memory",
+	ERR_INVALID:            "invalid argument",
+	ERR_WRONG_KIND:         "wrong kind of handle",
+	ERR_NO_HANDLE:          "no such handle",
+	ERR_BUSY:               "busy",
+	ERR_NOT_READY:          "not ready",
+	ERR_CLOSED:             "closed",
+	ERR_TIMEOUT:            "timed out",
+	ERR_CANCELLED:          "cancelled",
+	ERR_TOO_LARGE:          "too large",
+	ERR_NOT_EMPTY:          "folder not empty",
+	ERR_IO:                 "I/O error",
+	ERR_UNSUPPORTED:        "not supported",
+	ERR_BAD_ADDRESS:        "bad address",
+	ERR_STOPPED:            "stopped",
+	ERR_NOT_FOLDER:         "not a folder",
+	ERR_IS_FOLDER:          "is a folder",
+	ERR_READ_ONLY:          "read-only",
+	ERR_NO_SPACE:           "no space left",
+	ERR_NOT_PROGRAM:        "not a program",
+	ERR_NAME_TOO_LONG:      "name too long",
+	ERR_NO_APP:             "no such app",
+	ERR_TOO_MANY_ARGUMENTS: "too many arguments",
+	ERR_CONNECTION_RESET:   "connection reset",
+	ERR_CONNECTION_REFUSED: "connection refused",
+	ERR_ADDRESS_IN_USE:     "address in use",
+	ERR_NETWORK_DOWN:       "network is down",
+	ERR_NOT_CONNECTED:      "not connected",
+	ERR_UNREACHABLE:        "host unreachable",
+	ERR_PROTOCOL:           "protocol error",
+}
+
+func (e Errno) Error() string {
+	if 0 <= int(e) && int(e) < len(errors) {
+		s := errors[e]
+		if s != "" {
+			return s
+		}
+	}
+	return "result " + strconv.Itoa(int(e))
+}
+
+func (e Errno) Is(target error) bool {
+	switch target {
+	case oserror.ErrPermission:
+		return e == ERR_DENIED || e == ERR_READ_ONLY
+	case oserror.ErrExist:
+		return e == ERR_EXISTS || e == ERR_NOT_EMPTY
+	case oserror.ErrNotExist:
+		return e == ERR_NOT_FOUND
+	case errorspkg.ErrUnsupported:
+		return e == ERR_UNSUPPORTED
+	}
+	return false
+}
+
+func (e Errno) Temporary() bool {
+	return e == ERR_NOT_READY || e == ERR_BUSY || e.Timeout()
+}
+
+func (e Errno) Timeout() bool {
+	return e == ERR_TIMEOUT
+}
+
+// Names of results that Go's portable packages use.
+const (
+	EINVAL       = ERR_INVALID
+	ENOENT       = ERR_NOT_FOUND
+	EEXIST       = ERR_EXISTS
+	EPERM        = ERR_DENIED
+	EACCES       = ERR_DENIED
+	ENOTDIR      = ERR_NOT_FOLDER
+	EISDIR       = ERR_IS_FOLDER
+	ENOTEMPTY    = ERR_NOT_EMPTY
+	ENAMETOOLONG = ERR_NAME_TOO_LONG
+	EBADF        = ERR_NO_HANDLE
+	EIO          = ERR_IO
+	ENOMEM       = ERR_NO_MEMORY
+	ENOSPC       = ERR_NO_SPACE
+	EROFS        = ERR_READ_ONLY
+	EAGAIN       = ERR_NOT_READY
+	EBUSY        = ERR_BUSY
+	ETIMEDOUT    = ERR_TIMEOUT
+	EPIPE        = ERR_CLOSED
+	ENOSYS       = ERR_UNSUPPORTED
+	ENOTSUP      = ERR_UNSUPPORTED
+	EOPNOTSUPP   = ERR_UNSUPPORTED
+	ESPIPE       = ERR_WRONG_KIND
+	EINTR        = ERR_CANCELLED
+	ECONNRESET   = ERR_CONNECTION_RESET
+	ECONNREFUSED = ERR_CONNECTION_REFUSED
+	EADDRINUSE   = ERR_ADDRESS_IN_USE
+	ENETDOWN     = ERR_NETWORK_DOWN
+	ENOTCONN     = ERR_NOT_CONNECTED
+	EHOSTUNREACH = ERR_UNREACHABLE
+	ERANGE       = ERR_TOO_LARGE
+)
+
+// Flags of os.OpenFile. Nocturne opens a document for one access
+// (DocumentOpen); package os maps these onto it.
+const (
+	O_RDONLY = 0x0
+	O_WRONLY = 0x1
+	O_RDWR   = 0x2
+	O_APPEND = 0x400
+	O_CREAT  = 0x40
+	O_EXCL   = 0x80
+	O_SYNC   = 0x1000
+	O_TRUNC  = 0x200
+
+	O_CLOEXEC  = 0 // handles pass to an app only through its launch table
+	O_NONBLOCK = 0
+)
+
+// ---- calls ----
+
+func rawSyscall(n, a1, a2, a3, a4, a5 uintptr) int64
+
+//go:linkname runtime_entersyscall runtime.entersyscall
+func runtime_entersyscall()
+
+//go:linkname runtime_exitsyscall runtime.exitsyscall
+func runtime_exitsyscall()
+
+// Syscall makes Nocturne system call n, letting other goroutines run while
+// it blocks. It returns the call's non-negative result, or its result code.
+//
+//go:uintptrkeepalive
+//go:nosplit
+func Syscall(n, a1, a2, a3, a4, a5 uintptr) (r uintptr, err Errno) {
+	runtime_entersyscall()
+	v := rawSyscall(n, a1, a2, a3, a4, a5)
+	runtime_exitsyscall()
+	if v < 0 {
+		return 0, Errno(-v)
+	}
+	return uintptr(v), 0
+}
+
+// RawSyscall is Syscall for calls that return at once.
+//
+//go:uintptrkeepalive
+//go:nosplit
+func RawSyscall(n, a1, a2, a3, a4, a5 uintptr) (r uintptr, err Errno) {
+	v := rawSyscall(n, a1, a2, a3, a4, a5)
+	if v < 0 {
+		return 0, Errno(-v)
+	}
+	return uintptr(v), 0
+}
+
+func errnoErr(e Errno) error {
+	if e == 0 {
+		return nil
+	}
+	return e
+}
+
+func bytePtr(p []byte) uintptr {
+	if len(p) == 0 {
+		return uintptr(unsafe.Pointer(&_zero))
+	}
+	return uintptr(unsafe.Pointer(&p[0]))
+}
+
+// ---- handles ----
+
+func Close(h int) error {
+	_, e := RawSyscall(SYS_HANDLE_CLOSE, uintptr(h), 0, 0, 0, 0)
+	return errnoErr(e)
+}
+
+// HandleKind returns the KIND_* of handle h.
+func HandleKind(h int) (int, error) {
+	r, e := RawSyscall(SYS_HANDLE_KIND, uintptr(h), 0, 0, 0, 0)
+	return int(r), errnoErr(e)
+}
+
+// ---- paths ----
+//
+// Nocturne paths are drive paths on its one drive, C: ("C:\Users\User\a.txt"),
+// with '\' or '/' between names, which compare without case. A path is
+// complete when a separator follows its drive or begins it ("\Users" is
+// C:\Users); "C:a" and "C:" are in the current folder, like "a" and ".".
+
+// The folders programs are found in (FindProgram): the system's, then a
+// folder of FOLDER_PROGRAMS for each app.
+const (
+	FOLDER_SYSTEM   = `C:\Nocturne\System`
+	FOLDER_PROGRAMS = `C:\Programs`
+)
+
+// IsPathSeparator reports whether c separates names in a path.
+func IsPathSeparator(c byte) bool {
+	return c == '\\' || c == '/'
+}
+
+// PathDriveLength returns the length of the drive ("C:") that begins path, or 0.
+func PathDriveLength(path string) int {
+	if len(path) >= 2 && path[1] == ':' && 'a' <= path[0]|0x20 && path[0]|0x20 <= 'z' {
+		return 2
+	}
+	return 0
+}
+
+// PathIsComplete reports whether path names a place by itself, without the
+// current folder.
+func PathIsComplete(path string) bool {
+	d := PathDriveLength(path)
+	return d < len(path) && IsPathSeparator(path[d])
+}
+
+// FullPath makes a name complete, as the C library's n_path_complete does:
+// a name that is not complete is in the current folder (the setting FOLDER,
+// else C:\). It is written "C:\a\b", with "." and ".." resolved.
+func FullPath(name string) string {
+	if !PathIsComplete(name) {
+		folder, _ := Getenv("FOLDER")
+		if !PathIsComplete(folder) {
+			folder = `C:\`
+		}
+		name = folder + `\` + name[PathDriveLength(name):]
+	}
+	out := []byte{'C', ':'}
+	if PathDriveLength(name) != 0 {
+		out[0] = name[0] &^ 0x20
+	}
+	for rest := name[PathDriveLength(name):]; rest != ""; {
+		n := 0
+		for n < len(rest) && !IsPathSeparator(rest[n]) {
+			n++
+		}
+		switch part := rest[:n]; part {
+		case "", ".":
+		case "..":
+			for len(out) > 2 && out[len(out)-1] != '\\' {
+				out = out[:len(out)-1]
+			}
+			if len(out) > 2 {
+				out = out[:len(out)-1]
+			}
+		default:
+			out = append(out, '\\')
+			out = append(out, part...)
+		}
+		if n < len(rest) {
+			n++
+		}
+		rest = rest[n:]
+	}
+	if len(out) == 2 {
+		out = append(out, '\\')
+	}
+	return string(out)
+}
+
+// FindProgram returns a program's complete path, as the C library's
+// find_program does: a bare name ("ls") is looked for in FOLDER_SYSTEM,
+// then in each folder of FOLDER_PROGRAMS; any other name is completed.
+func FindProgram(name string) (string, error) {
+	if name == "" || bytealg.IndexByteString(name, '\\') >= 0 || bytealg.IndexByteString(name, '/') >= 0 ||
+		bytealg.IndexByteString(name, ':') >= 0 {
+		full := FullPath(name)
+		return full, isProgram(full)
+	}
+	if full := FOLDER_SYSTEM + `\` + name; isProgram(full) == nil {
+		return full, nil
+	}
+	var apps [64]Entry
+	for start := 0; ; {
+		n, err := FolderList(FOLDER_PROGRAMS, apps[:], start)
+		if err != nil {
+			return "", err
+		}
+		for i := range apps[:n] {
+			if apps[i].Kind != KIND_FOLDER {
+				continue
+			}
+			if full := FOLDER_PROGRAMS + `\` + apps[i].EntryName() + `\` + name; isProgram(full) == nil {
+				return full, nil
+			}
+		}
+		if n < len(apps) {
+			return "", ERR_NOT_FOUND
+		}
+		start += n
+	}
+}
+
+// isProgram reports why there is no program at the complete path, or nil.
+func isProgram(full string) error {
+	var e Entry
+	if err := EntryInfo(full, &e); err != nil {
+		return err
+	}
+	if e.Kind != KIND_DOCUMENT {
+		return ERR_NOT_PROGRAM
+	}
+	return nil
+}
+
+func pathPtr(name string) (*byte, error) {
+	return BytePtrFromString(FullPath(name))
+}
+
+func Getwd() (string, error) {
+	return FullPath("."), nil
+}
+
+// Chdir changes the app's current folder: the setting FOLDER, which
+// FullPath reads and which the apps it launches inherit.
+func Chdir(path string) error {
+	var e Entry
+	full := FullPath(path)
+	if err := EntryInfo(full, &e); err != nil {
+		return err
+	}
+	if e.Kind != KIND_FOLDER {
+		return ERR_NOT_FOLDER
+	}
+	return Setenv("FOLDER", full)
+}
+
+// ---- documents ----
+
+func DocumentOpen(path string, access int) (h int, err error) {
+	p, err := pathPtr(path)
+	if err != nil {
+		return -1, err
+	}
+	r, e := Syscall(SYS_DOCUMENT_OPEN, uintptr(unsafe.Pointer(p)), uintptr(access), 0, 0, 0)
+	if e != 0 {
+		return -1, e
+	}
+	return int(r), nil
+}
+
+func DocumentReadAt(h int, b []byte, off int64) (n int, err error) {
+	r, e := Syscall(SYS_DOCUMENT_READ_AT, uintptr(h), uintptr(off), bytePtr(b), uintptr(len(b)), 0)
+	return int(r), errnoErr(e)
+}
+
+func DocumentWriteAt(h int, b []byte, off int64) (n int, err error) {
+	r, e := Syscall(SYS_DOCUMENT_WRITE_AT, uintptr(h), uintptr(off), bytePtr(b), uintptr(len(b)), 0)
+	return int(r), errnoErr(e)
+}
+
+func DocumentSize(h int) (int64, error) {
+	r, e := RawSyscall(SYS_DOCUMENT_SIZE, uintptr(h), 0, 0, 0, 0)
+	return int64(r), errnoErr(e)
+}
+
+func DocumentSetSize(h int, size int64) error {
+	_, e := Syscall(SYS_DOCUMENT_SET_SIZE, uintptr(h), uintptr(size), 0, 0, 0)
+	return errnoErr(e)
+}
+
+// DocumentClaim takes the document's lease; without wait, a lease held
+// elsewhere is ERR_NOT_READY.
+func DocumentClaim(h int, wait bool) error {
+	w := uintptr(0)
+	if wait {
+		w = 1
+	}
+	_, e := Syscall(SYS_DOCUMENT_CLAIM, uintptr(h), w, 0, 0, 0)
+	return errnoErr(e)
+}
+
+func DocumentRelease(h int) error {
+	_, e := RawSyscall(SYS_DOCUMENT_RELEASE, uintptr(h), 0, 0, 0, 0)
+	return errnoErr(e)
+}
+
+// DocumentCommit saves what was written through h to the medium (COMMIT_*).
+func DocumentCommit(h int, how int) error {
+	_, e := Syscall(SYS_DOCUMENT_COMMIT, uintptr(h), uintptr(how), 0, 0, 0)
+	return errnoErr(e)
+}
+
+// DocumentSave replaces the document's content atomically.
+func DocumentSave(path string, data []byte) error {
+	p, err := pathPtr(path)
+	if err != nil {
+		return err
+	}
+	_, e := Syscall(SYS_DOCUMENT_SAVE, uintptr(unsafe.Pointer(p)), bytePtr(data), uintptr(len(data)), 0, 0)
+	return errnoErr(e)
+}
+
+// DocumentAppend adds data at the end of the document, making it if needed.
+func DocumentAppend(path string, data []byte) error {
+	p, err := pathPtr(path)
+	if err != nil {
+		return err
+	}
+	_, e := Syscall(SYS_DOCUMENT_APPEND, uintptr(unsafe.Pointer(p)), bytePtr(data), uintptr(len(data)), 0, 0)
+	return errnoErr(e)
+}
+
+// ---- entries and folders ----
+
+// Entry is an entry of a folder, or the entry a path names
+// (struct n_entry). Modified is in wall seconds.
+type Entry struct {
+	Name     [256]byte
+	Kind     uint32 // KIND_DOCUMENT, KIND_FOLDER or KIND_DEVICE
+	reserved uint32
+	Size     uint64
+	Modified int64
+}
+
+// EntryName returns the entry's name.
+func (e *Entry) EntryName() string {
+	n := bytealg.IndexByte(e.Name[:], 0)
+	if n < 0 {
+		n = len(e.Name)
+	}
+	return string(e.Name[:n])
+}
+
+func EntryInfo(path string, out *Entry) error {
+	p, err := pathPtr(path)
+	if err != nil {
+		return err
+	}
+	_, e := Syscall(SYS_ENTRY_INFO, uintptr(unsafe.Pointer(p)), uintptr(unsafe.Pointer(out)), 0, 0, 0)
+	return errnoErr(e)
+}
+
+// EntryRemove removes a document or an empty folder.
+func EntryRemove(path string) error {
+	p, err := pathPtr(path)
+	if err != nil {
+		return err
+	}
+	_, e := Syscall(SYS_ENTRY_REMOVE, uintptr(unsafe.Pointer(p)), 0, 0, 0, 0)
+	return errnoErr(e)
+}
+
+// EntryMove moves an entry; it never replaces an existing name.
+func EntryMove(from, to string) error {
+	f, err := pathPtr(from)
+	if err != nil {
+		return err
+	}
+	t, err := pathPtr(to)
+	if err != nil {
+		return err
+	}
+	_, e := Syscall(SYS_ENTRY_MOVE, uintptr(unsafe.Pointer(f)), uintptr(unsafe.Pointer(t)), 0, 0, 0)
+	return errnoErr(e)
+}
+
+func FolderCreate(path string) error {
+	p, err := pathPtr(path)
+	if err != nil {
+		return err
+	}
+	_, e := Syscall(SYS_FOLDER_CREATE, uintptr(unsafe.Pointer(p)), 0, 0, 0, 0)
+	return errnoErr(e)
+}
+
+// FolderList fills out with the folder's entries from index start on and
+// returns how many it filled.
+func FolderList(path string, out []Entry, start int) (int, error) {
+	p, err := pathPtr(path)
+	if err != nil {
+		return 0, err
+	}
+	var first uintptr
+	if len(out) > 0 {
+		first = uintptr(unsafe.Pointer(&out[0]))
+	}
+	r, e := Syscall(SYS_FOLDER_LIST, uintptr(unsafe.Pointer(p)), first, uintptr(len(out)), uintptr(start), 0)
+	return int(r), errnoErr(e)
+}
+
+// ---- channels ----
+
+// ChannelPair makes an unnamed pair of connected channel ends.
+func ChannelPair() (a, b int, err error) {
+	var h [2]int32
+	_, e := RawSyscall(SYS_CHANNEL_PAIR, uintptr(unsafe.Pointer(&h[0])), 0, 0, 0, 0)
+	if e != 0 {
+		return -1, -1, e
+	}
+	return int(h[0]), int(h[1]), nil
+}
+
+// ChannelSend sends b as one message, with an attached document or shared
+// handle (or -1).
+func ChannelSend(h int, b []byte, attach int) (int, error) {
+	_, e := Syscall(SYS_CHANNEL_SEND, uintptr(h), bytePtr(b), uintptr(len(b)), uintptr(attach), 0)
+	if e != 0 {
+		return 0, e
+	}
+	return len(b), nil
+}
+
+// ChannelReceive takes the next message into b. It returns the message's
+// size and the handle attached to it (-1 if none).
+func ChannelReceive(h int, b []byte, flags int) (n int, attached int, err error) {
+	var a int32 = -1
+	r, e := Syscall(SYS_CHANNEL_RECEIVE, uintptr(h), bytePtr(b), uintptr(len(b)), uintptr(flags), uintptr(unsafe.Pointer(&a)))
+	return int(r), int(a), errnoErr(e)
+}
+
+// ---- apps ----
+
+// struct n_launch
+type launch struct {
+	arguments   **byte
+	settings    **byte
+	handles     *int32
+	argumentLen uint32
+	settingLen  uint32
+	handleLen   uint32
+	flags       uint32
+}
+
+func stringPtrs(ss []string) ([]*byte, error) {
+	ptrs := make([]*byte, len(ss)+1)
+	for i, s := range ss {
+		p, err := BytePtrFromString(s)
+		if err != nil {
+			return nil, err
+		}
+		ptrs[i] = p
+	}
+	return ptrs, nil
+}
+
+// AppLaunch starts the program at path. Handle i of the new app is
+// handles[i] (-1: none); by convention 0 is its input, 1 its output and
+// 2 its log. Settings are "NAME=value" strings. It returns an app handle.
+func AppLaunch(path string, args, settings []string, handles []int) (int, error) {
+	p, err := pathPtr(path)
+	if err != nil {
+		return -1, err
+	}
+	a, err := stringPtrs(args)
+	if err != nil {
+		return -1, err
+	}
+	s, err := stringPtrs(settings)
+	if err != nil {
+		return -1, err
+	}
+	hs := make([]int32, len(handles)+1)
+	for i, h := range handles {
+		hs[i] = int32(h)
+	}
+	l := launch{
+		arguments:   &a[0],
+		settings:    &s[0],
+		handles:     &hs[0],
+		argumentLen: uint32(len(args)),
+		settingLen:  uint32(len(settings)),
+		handleLen:   uint32(len(handles)),
+	}
+	r, e := Syscall(SYS_APP_LAUNCH, uintptr(unsafe.Pointer(p)), uintptr(unsafe.Pointer(&l)), 0, 0, 0)
+	if e != 0 {
+		return -1, e
+	}
+	return int(r), nil
+}
+
+// AppResult waits up to timeoutMs (-1: no limit, 0: not at all) for the
+// app to end and returns its exit status.
+func AppResult(h int, timeoutMs int64) (status int, err error) {
+	var st int32
+	_, e := Syscall(SYS_APP_RESULT, uintptr(h), uintptr(timeoutMs), uintptr(unsafe.Pointer(&st)), 0, 0)
+	return int(st), errnoErr(e)
+}
+
+// AppStop asks the app to stop; there are no signals.
+func AppStop(h int, flags int) error {
+	_, e := RawSyscall(SYS_APP_STOP, uintptr(h), uintptr(flags), 0, 0, 0)
+	return errnoErr(e)
+}
+
+// AppID returns the identifier of a running app (0 once it has ended).
+func AppID(h int) (int, error) {
+	r, e := RawSyscall(SYS_APP_ID, uintptr(h), 0, 0, 0, 0)
+	return int(r), errnoErr(e)
+}
+
+// AppOpen returns a handle on the running app with identifier id.
+func AppOpen(id int) (int, error) {
+	r, e := RawSyscall(SYS_APP_OPEN, uintptr(id), 0, 0, 0, 0)
+	if e != 0 {
+		return -1, e
+	}
+	return int(r), nil
+}
+
+func Getpid() int {
+	r, _ := RawSyscall(SYS_APP_SELF, 0, 0, 0, 0, 0)
+	return int(r)
+}
+
+func Getppid() int {
+	r, _ := RawSyscall(SYS_APP_PARENT, 0, 0, 0, 0, 0)
+	return int(r)
+}
+
+// ---- time and randomness ----
+
+type Timespec struct {
+	Sec  int64
+	Nsec int64
+}
+
+type Timeval struct {
+	Sec  int64
+	Usec int64
+}
+
+func NsecToTimeval(nsec int64) (tv Timeval) {
+	nsec += 999 // round up to microsecond
+	tv.Usec = nsec % 1e9 / 1e3
+	tv.Sec = nsec / 1e9
+	return
+}
+
+// Random fills b from the system's entropy.
+func Random(b []byte) error {
+	_, e := RawSyscall(SYS_RANDOM, bytePtr(b), uintptr(len(b)), 0, 0, 0)
+	return errnoErr(e)
+}
+
+// Nocturne apps have no user or group identities.
+func Getuid() int  { return -1 }
+func Geteuid() int { return -1 }
+func Getgid() int  { return -1 }
+func Getegid() int { return -1 }
+
+func Getgroups() ([]int, error) { return nil, ERR_UNSUPPORTED }
+
+// ---- the app ----
+
+// The handles an app is launched with, by convention.
+const (
+	Stdin  = 0
+	Stdout = 1
+	Stderr = 2
+)
+
+// SystemLogOpen returns a handle that writes to the system log.
+func SystemLogOpen() (int, error) {
+	r, e := RawSyscall(SYS_SYSTEM_LOG_OPEN, 0, 0, 0, 0, 0)
+	if e != 0 {
+		return -1, e
+	}
+	return int(r), nil
+}
+
+// Mkdir is FolderCreate; Nocturne folders have no permission bits.
+func Mkdir(path string, mode uint32) error {
+	return FolderCreate(path)
+}
+
+// SysProcAttr holds Nocturne-specific launch options; there are none yet.
+type SysProcAttr struct{}
+
+// ---- network ----
+
+// Network system call numbers. TCP and UDP connections are numbered on
+// their own, not handles.
+const (
+	SYS_NET_INFO       = 96
+	SYS_NET_DNS_ALL    = 108
+	SYS_UDP_SOCKET     = 99
+	SYS_UDP_SEND       = 100
+	SYS_UDP_RECV       = 101
+	SYS_UDP_CLOSE      = 106
+	SYS_TCP_CONNECT    = 102
+	SYS_TCP_RECV       = 104
+	SYS_TCP_CLOSE      = 105
+	SYS_TCP_SEND_UNTIL = 109
+	SYS_TCP_CANCEL     = 110
+	SYS_TCP_LISTEN     = 113
+	SYS_TCP_ACCEPT     = 114
+	SYS_TCP_ADDRESS    = 115
+	SYS_TCP_FINISH     = 116
+)
+
+// TCPSendUntil flags.
+const TCP_SEND_NONBLOCK = 1
+
+// UDPMaxPayload is the largest datagram UDPSend takes.
+const UDPMaxPayload = 1472
+
+// NetInfo describes the network interface.
+type NetInfo struct {
+	Present, Up                 uint8
+	MAC                         [6]byte
+	IP, Mask, Gateway, Resolver [4]byte
+	RxPackets, TxPackets        uint64
+	Driver                      [32]byte
+}
+
+// GetNetInfo reports the interface; Present is 0 when there is none.
+func GetNetInfo(ni *NetInfo) error {
+	_, e := RawSyscall(SYS_NET_INFO, uintptr(unsafe.Pointer(ni)), 0, 0, 0, 0)
+	return errnoErr(e)
+}
+
+// Sockaddr4 is an IPv4 address (host byte order, a.b.c.d is a<<24|b<<16|c<<8|d) and port.
+type Sockaddr4 struct {
+	IP   uint32
+	Port uint16
+}
+
+// DNS result statuses.
+const (
+	DNS_OK = iota
+	DNS_NXDOMAIN
+	DNS_NODATA
+	DNS_SERVFAIL
+	DNS_REFUSED
+	DNS_FORMAT
+	DNS_TIMEOUT
+	DNS_UNREACHABLE
+	DNS_CANCELLED
+	DNS_RESOURCE
+)
+
+// DNSResult describes a NetDNSAll answer; Count is the complete number of
+// addresses even when fewer fit.
+type DNSResult struct {
+	Version, Status, Count, TTL uint32
+}
+
+// NetDNSAll resolves name to IPv4 addresses with the system resolver
+// (or resolver, when not nil).
+func NetDNSAll(name string, ips []uint32, res *DNSResult, resolver *Sockaddr4) error {
+	p, err := BytePtrFromString(name)
+	if err != nil {
+		return err
+	}
+	var ip uintptr
+	if len(ips) > 0 {
+		ip = uintptr(unsafe.Pointer(&ips[0]))
+	}
+	_, e := Syscall(SYS_NET_DNS_ALL, uintptr(unsafe.Pointer(p)), ip, uintptr(len(ips)),
+		uintptr(unsafe.Pointer(res)), uintptr(unsafe.Pointer(resolver)))
+	return errnoErr(e)
+}
+
+// TCPConnect connects to ip:port, waiting at most timeoutMs (0: the
+// system's limit), and returns the connection number.
+func TCPConnect(ip uint32, port uint16, timeoutMs int) (int, error) {
+	r, e := Syscall(SYS_TCP_CONNECT, uintptr(ip), uintptr(port), uintptr(timeoutMs), 0, 0)
+	if e != 0 {
+		return -1, e
+	}
+	return int(r), nil
+}
+
+// TCPSendUntil queues b, waiting for room until the uptime deadline in
+// milliseconds (0: no deadline). It returns how much was queued.
+func TCPSendUntil(id int, b []byte, deadlineMs uint64, flags int) (int, error) {
+	r, e := Syscall(SYS_TCP_SEND_UNTIL, uintptr(id), bytePtr(b), uintptr(len(b)), uintptr(deadlineMs), uintptr(flags))
+	if e != 0 {
+		return 0, e
+	}
+	return int(r), nil
+}
+
+// TCPRecv receives into b, waiting at most timeoutMs (negative: no limit,
+// 0: not at all, ERR_NOT_READY). 0 bytes means the peer finished sending.
+func TCPRecv(id int, b []byte, timeoutMs int) (int, error) {
+	r, e := Syscall(SYS_TCP_RECV, uintptr(id), bytePtr(b), uintptr(len(b)), uintptr(timeoutMs), 0)
+	if e != 0 {
+		return 0, e
+	}
+	return int(r), nil
+}
+
+// TCPClose finishes sending what is queued and gives up the connection.
+func TCPClose(id int) error {
+	_, e := RawSyscall(SYS_TCP_CLOSE, uintptr(id), 0, 0, 0, 0)
+	return errnoErr(e)
+}
+
+// TCPCancel aborts the connection and wakes its waiters with
+// ERR_CANCELLED; the number stays the caller's until TCPClose.
+func TCPCancel(id int) error {
+	_, e := RawSyscall(SYS_TCP_CANCEL, uintptr(id), 0, 0, 0, 0)
+	return errnoErr(e)
+}
+
+// TCPListen waits for connections to ip (0: every local address) and port
+// (0: any free one), keeping at most backlog of them (<= 0: the system's
+// default) until TCPAccept takes them, and returns the listener's number.
+// TCPClose ends it.
+func TCPListen(ip uint32, port uint16, backlog int) (int, error) {
+	r, e := RawSyscall(SYS_TCP_LISTEN, uintptr(ip), uintptr(port), uintptr(backlog), 0, 0)
+	if e != 0 {
+		return -1, e
+	}
+	return int(r), nil
+}
+
+// TCPAccept takes the listener's next established connection, waiting at
+// most timeoutMs (like TCPRecv), and reports its remote address.
+func TCPAccept(id int, timeoutMs int, remote *Sockaddr4) (int, error) {
+	r, e := Syscall(SYS_TCP_ACCEPT, uintptr(id), uintptr(timeoutMs), uintptr(unsafe.Pointer(remote)), 0, 0)
+	if e != 0 {
+		return -1, e
+	}
+	return int(r), nil
+}
+
+// TCPAddress reports a connection's or listener's local and remote
+// addresses; either may be nil.
+func TCPAddress(id int, local, remote *Sockaddr4) error {
+	_, e := RawSyscall(SYS_TCP_ADDRESS, uintptr(id), uintptr(unsafe.Pointer(local)), uintptr(unsafe.Pointer(remote)), 0, 0)
+	return errnoErr(e)
+}
+
+// TCPFinish ends sending (a FIN follows the queued data); receiving goes
+// on until the peer finishes too. TCPClose still gives the number up.
+func TCPFinish(id int) error {
+	_, e := RawSyscall(SYS_TCP_FINISH, uintptr(id), 0, 0, 0, 0)
+	return errnoErr(e)
+}
+
+// UDPSocket takes the local port (0: any free one) and returns the socket number.
+func UDPSocket(port uint16) (int, error) {
+	r, e := RawSyscall(SYS_UDP_SOCKET, uintptr(port), 0, 0, 0, 0)
+	if e != 0 {
+		return -1, e
+	}
+	return int(r), nil
+}
+
+// UDPSend sends one datagram of at most UDPMaxPayload bytes.
+func UDPSend(id int, ip uint32, port uint16, b []byte) (int, error) {
+	r, e := Syscall(SYS_UDP_SEND, uintptr(id), uintptr(ip), uintptr(port), bytePtr(b), uintptr(len(b)))
+	if e != 0 {
+		return 0, e
+	}
+	return int(r), nil
+}
+
+// UDPRecv receives one datagram (cut to len(b)), waiting at most timeoutMs
+// (negative: no limit), and reports its sender.
+func UDPRecv(id int, b []byte, timeoutMs int, from *Sockaddr4) (int, error) {
+	r, e := Syscall(SYS_UDP_RECV, uintptr(id), bytePtr(b), uintptr(len(b)), uintptr(timeoutMs), uintptr(unsafe.Pointer(from)))
+	if e != 0 {
+		return 0, e
+	}
+	return int(r), nil
+}
+
+// UDPClose gives up the socket.
+func UDPClose(id int) error {
+	_, e := RawSyscall(SYS_UDP_CLOSE, uintptr(id), 0, 0, 0, 0)
+	return errnoErr(e)
+}
+
+// Uptime returns the milliseconds since the system started, the clock of
+// TCPSendUntil deadlines.
+func Uptime() uint64 {
+	r, _ := RawSyscall(SYS_UPTIME, 0, 0, 0, 0, 0)
+	return uint64(r)
+}
