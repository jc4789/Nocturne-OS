@@ -0,0 +1,65 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package net
+
+import (
+	"os"
+	"syscall"
+)
+
+// Nocturne has at most one network interface, index 1.
+
+func netInfo() (*syscall.NetInfo, error) {
+	ni := new(syscall.NetInfo)
+	if err := syscall.GetNetInfo(ni); err != nil {
+		return nil, os.NewSyscallError("netinfo", err)
+	}
+	if ni.Present == 0 {
+		return nil, nil
+	}
+	return ni, nil
+}
+
+func interfaceTable(ifindex int) ([]Interface, error) {
+	ni, err := netInfo()
+	if ni == nil || (ifindex != 0 && ifindex != 1) {
+		return nil, err
+	}
+	name := "net0"
+	for i, c := range ni.Driver {
+		if c == 0 {
+			if i > 0 {
+				name = string(ni.Driver[:i])
+			}
+			break
+		}
+	}
+	ifi := Interface{
+		Index:        1,
+		MTU:          1500,
+		Name:         name,
+		HardwareAddr: HardwareAddr(append([]byte(nil), ni.MAC[:]...)),
+		Flags:        FlagBroadcast,
+	}
+	if ni.Up != 0 {
+		ifi.Flags |= FlagUp | FlagRunning
+	}
+	return []Interface{ifi}, nil
+}
+
+func interfaceAddrTable(ifi *Interface) ([]Addr, error) {
+	ni, err := netInfo()
+	if ni == nil || (ifi != nil && ifi.Index != 1) || ni.IP == [4]byte{} {
+		return nil, err
+	}
+	return []Addr{&IPNet{
+		IP:   IPv4(ni.IP[0], ni.IP[1], ni.IP[2], ni.IP[3]),
+		Mask: IPv4Mask(ni.Mask[0], ni.Mask[1], ni.Mask[2], ni.Mask[3]),
+	}}, nil
+}
+
+func interfaceMulticastAddrTable(ifi *Interface) ([]Addr, error) {
+	return nil, nil
+}
