diff --git a/src/os/file_mutex_nocturne.go b/src/os/file_mutex_nocturne.go
new file mode 100644
index 00000000..ebed3d17
--- /dev/null
+++ b/src/os/file_mutex_nocturne.go
@@ -0,0 +1,70 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package os
+
+// File locking support for Nocturne. This uses fdMutex from the
+// internal/poll package.
+
+// incref adds a reference to the file. It returns an error if the file
+// is already closed. This method is on File so that we can incorporate
+// a nil test.
+func (f *File) incref(op string) (err error) {
+	if f == nil {
+		return ErrInvalid
+	}
+	if !f.fdmu.Incref() {
+		err = ErrClosed
+		if op != "" {
+			err = &PathError{Op: op, Path: f.name, Err: err}
+		}
+	}
+	return err
+}
+
+// decref removes a reference to the file. If this is the last
+// remaining reference, and the file has been marked to be closed,
+// then actually close it.
+func (file *file) decref() error {
+	if file.fdmu.Decref() {
+		return file.destroy()
+	}
+	return nil
+}
+
+// readLock adds a reference to the file and locks it for reading.
+// It returns an error if the file is already closed.
+func (file *file) readLock() error {
+	if !file.fdmu.ReadLock() {
+		return ErrClosed
+	}
+	return nil
+}
+
+// readUnlock removes a reference from the file and unlocks it for reading.
+// It also closes the file if it marked as closed and there is no remaining
+// reference.
+func (file *file) readUnlock() {
+	if file.fdmu.ReadUnlock() {
+		file.destroy()
+	}
+}
+
+// writeLock adds a reference to the file and locks it for writing.
+// It returns an error if the file is already closed.
+func (file *file) writeLock() error {
+	if !file.fdmu.WriteLock() {
+		return ErrClosed
+	}
+	return nil
+}
+
+// writeUnlock removes a reference from the file and unlocks it for writing.
+// It also closes the file if it is marked as closed and there is no remaining
+// reference.
+func (file *file) writeUnlock() {
+	if file.fdmu.WriteUnlock() {
+		file.destroy()
+	}
+}
diff --git a/src/os/file_nocturne.go b/src/os/file_nocturne.go
new file mode 100644
index 00000000..96fd6fe0
--- /dev/null
+++ b/src/os/file_nocturne.go
@@ -0,0 +1,713 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package os
+
+import (
+	"internal/filepathlite"
+	"internal/poll"
+	"io"
+	"runtime"
+	"sync"
+	"sync/atomic"
+	"syscall"
+	"time"
+)
+
+// fixLongPath is a noop on non-Windows platforms.
+func fixLongPath(path string) string {
+	return path
+}
+
+// kindNull marks the null device: Nocturne has no device for it, so a
+// File for DevNull holds no handle, reads nothing and discards writes,
+// and an app launched with it gets no handle in that place.
+const kindNull = -1
+
+// The largest message a Write sends on a channel; longer writes are split.
+const maxMessage = 64 << 10
+
+// file is the real representation of *File.
+// The extra level of indirection ensures that no clients of os
+// can overwrite this data, which could cause the finalizer
+// to close the wrong handle.
+type file struct {
+	fdmu       poll.FDMutex
+	sysfd      int    // the handle; -1 for folders and the null device
+	name       string // as given to Open
+	path       string // full path, "" for a handle not opened by name
+	kind       int    // syscall.KIND_*, kindNull, or 0 when sysfd holds no handle
+	appendMode bool
+	dirinfo    atomic.Pointer[dirInfo] // nil unless folder being read
+
+	// Documents have no shared cursor: off is this File's position.
+	// mu guards it, as reads and writes may run at once.
+	mu  sync.Mutex
+	off int64
+
+	// The unread rest of a channel message longer than a Read's buffer.
+	pending []byte
+
+	// For writes on Stderr when the app was launched without handle 2.
+	logOnce sync.Once
+	logfd   int
+}
+
+// fd is the Nocturne implementation of Fd.
+func (f *File) fd() uintptr {
+	if f == nil {
+		return ^(uintptr(0))
+	}
+	return uintptr(f.sysfd)
+}
+
+func newFile(h int, name, path string, kind int) *File {
+	f := &File{&file{sysfd: h, name: name, path: path, kind: kind, logfd: -1}}
+	runtime.SetFinalizer(f.file, (*file).close)
+	return f
+}
+
+// newFileFromNewFile is called by [NewFile].
+func newFileFromNewFile(fd uintptr, name string) *File {
+	h := int(fd)
+	if h < 0 {
+		return nil
+	}
+	kind, err := syscall.HandleKind(h)
+	if err != nil {
+		kind = 0
+	}
+	return newFile(h, name, "", kind)
+}
+
+// Auxiliary information if the File describes a folder.
+type dirInfo struct {
+	mu      sync.Mutex
+	entries [64]syscall.Entry
+	n       int // entries filled by the last FolderList
+	pos     int // next of them to return
+	next    int // index in the folder of the entry after entries[n-1]
+}
+
+func epipecheck(file *File, e error) {
+}
+
+// DevNull is the name of the operating system's “null device.”
+// On Unix-like systems, it is "/dev/null"; on Windows and Nocturne, "NUL".
+// Nocturne has no device of that name: a File opened by it holds no handle.
+const DevNull = "NUL"
+
+// syscallMode returns the syscall-specific mode bits from Go's portable mode bits.
+// Nocturne entries have no permission bits.
+func syscallMode(i FileMode) uint32 {
+	return 0
+}
+
+// openFileNolog is the Nocturne implementation of OpenFile. Documents are
+// opened for reading (DOCUMENT_READ) or for editing (DOCUMENT_EDIT), or are
+// made (DOCUMENT_CREATE); the permission bits have no meaning on Nocturne.
+func openFileNolog(name string, flag int, perm FileMode) (*File, error) {
+	if name == DevNull {
+		return newFile(-1, name, "", kindNull), nil
+	}
+	full := syscall.FullPath(name)
+	write := flag&(O_WRONLY|O_RDWR) != 0
+	access := syscall.DOCUMENT_READ
+	if write {
+		access = syscall.DOCUMENT_EDIT
+	}
+	var (
+		h       int
+		err     error
+		created bool
+	)
+	switch {
+	case flag&O_CREATE != 0 && flag&O_EXCL != 0:
+		h, err = syscall.DocumentOpen(full, syscall.DOCUMENT_CREATE)
+		created = err == nil
+	case flag&O_CREATE != 0:
+		for {
+			h, err = syscall.DocumentOpen(full, access)
+			if err != syscall.ERR_NOT_FOUND {
+				break
+			}
+			h, err = syscall.DocumentOpen(full, syscall.DOCUMENT_CREATE)
+			if err != syscall.ERR_EXISTS {
+				created = err == nil
+				break
+			}
+		}
+	default:
+		h, err = syscall.DocumentOpen(full, access)
+	}
+	if err == syscall.ERR_IS_FOLDER && !write {
+		// Folders are listed by path; the File holds no handle.
+		return newFile(-1, name, full, syscall.KIND_FOLDER), nil
+	}
+	if err != nil {
+		return nil, &PathError{Op: "open", Path: name, Err: err}
+	}
+	if flag&O_TRUNC != 0 && write && !created {
+		if err := syscall.DocumentSetSize(h, 0); err != nil {
+			syscall.Close(h)
+			return nil, &PathError{Op: "truncate", Path: name, Err: err}
+		}
+	}
+	f := newFile(h, name, full, syscall.KIND_DOCUMENT)
+	f.appendMode = flag&O_APPEND != 0
+	return f, nil
+}
+
+func openDirNolog(name string) (*File, error) {
+	f, err := openFileNolog(name, O_RDONLY, 0)
+	if err != nil {
+		return nil, err
+	}
+	if f.kind != syscall.KIND_FOLDER {
+		f.Close()
+		return nil, &PathError{Op: "open", Path: name, Err: syscall.ENOTDIR}
+	}
+	return f, nil
+}
+
+// Close closes the File, rendering it unusable for I/O.
+// On files that support SetDeadline, any pending I/O operations will
+// be canceled and return immediately with an ErrClosed error.
+// Close will return an error if it has already been called.
+func (f *File) Close() error {
+	if f == nil {
+		return ErrInvalid
+	}
+	return f.file.close()
+}
+
+func (file *file) close() error {
+	if !file.fdmu.IncrefAndClose() {
+		return &PathError{Op: "close", Path: file.name, Err: ErrClosed}
+	}
+	err := file.decref()
+
+	// no need for a finalizer anymore
+	runtime.SetFinalizer(file, nil)
+	return err
+}
+
+// destroy actually closes the handle. This is called when
+// there are no remaining references, by the decref, readUnlock,
+// and writeUnlock methods.
+func (file *file) destroy() error {
+	if file.logfd >= 0 {
+		syscall.Close(file.logfd)
+	}
+	if file.sysfd < 0 || file.kind == 0 {
+		return nil
+	}
+	if e := syscall.Close(file.sysfd); e != nil {
+		return &PathError{Op: "close", Path: file.name, Err: e}
+	}
+	return nil
+}
+
+// Stat returns the FileInfo structure describing file.
+// If there is an error, it will be of type [*PathError].
+func (f *File) Stat() (FileInfo, error) {
+	if f == nil {
+		return nil, ErrInvalid
+	}
+	if err := f.incref("stat"); err != nil {
+		return nil, err
+	}
+	defer f.decref()
+	if f.path != "" {
+		var e syscall.Entry
+		if err := syscall.EntryInfo(f.path, &e); err != nil {
+			return nil, &PathError{Op: "stat", Path: f.name, Err: err}
+		}
+		return fileInfoFromEntry(&e, f.path), nil
+	}
+	fs := &fileStat{name: filepathlite.Base(f.name)}
+	switch f.kind {
+	case syscall.KIND_DOCUMENT:
+		size, err := syscall.DocumentSize(f.sysfd)
+		if err != nil {
+			return nil, &PathError{Op: "stat", Path: f.name, Err: err}
+		}
+		fs.size = size
+		fs.mode = 0666
+	case kindNull:
+		fs.mode = ModeDevice | ModeCharDevice | 0666
+	case 0:
+		return nil, &PathError{Op: "stat", Path: f.name, Err: syscall.EBADF}
+	default:
+		// channels and connections carry messages
+		fs.mode = ModeNamedPipe | 0666
+	}
+	return fs, nil
+}
+
+// Truncate changes the size of the file.
+// It does not change the I/O offset.
+// If there is an error, it will be of type [*PathError].
+func (f *File) Truncate(size int64) error {
+	if f == nil {
+		return ErrInvalid
+	}
+	if err := f.incref("truncate"); err != nil {
+		return err
+	}
+	defer f.decref()
+	if f.kind != syscall.KIND_DOCUMENT {
+		return &PathError{Op: "truncate", Path: f.name, Err: syscall.EINVAL}
+	}
+	if err := syscall.DocumentSetSize(f.sysfd, size); err != nil {
+		return &PathError{Op: "truncate", Path: f.name, Err: err}
+	}
+	return nil
+}
+
+// Nocturne entries have no permission bits: chmod checks the File only.
+func (f *File) chmod(mode FileMode) error {
+	return f.checkValid("chmod")
+}
+
+// Sync commits the current contents of the file to stable storage.
+// Nocturne writes reach the document's store when they return.
+func (f *File) Sync() error {
+	if err := f.incref("sync"); err != nil {
+		return err
+	}
+	defer f.decref()
+	if f.kind != syscall.KIND_DOCUMENT {
+		return nil
+	}
+	if e := syscall.DocumentCommit(f.sysfd, syscall.COMMIT_WAIT); e != nil {
+		return f.wrapErr("sync", e)
+	}
+	return nil
+}
+
+// read reads up to len(b) bytes from the File.
+// It returns the number of bytes read and an error, if any.
+func (f *File) read(b []byte) (n int, err error) {
+	if err := f.readLock(); err != nil {
+		return 0, err
+	}
+	defer f.readUnlock()
+	if len(b) == 0 {
+		return 0, nil
+	}
+	switch f.kind {
+	case syscall.KIND_DOCUMENT:
+		f.mu.Lock()
+		n, err = syscall.DocumentReadAt(f.sysfd, b, f.off)
+		f.off += int64(n)
+		f.mu.Unlock()
+		if n == 0 && err == nil {
+			return 0, io.EOF
+		}
+		return n, err
+	case kindNull:
+		return 0, io.EOF
+	case syscall.KIND_FOLDER:
+		return 0, syscall.EISDIR
+	case 0:
+		return 0, syscall.EBADF
+	}
+	return f.receive(b)
+}
+
+// receive reads a channel's messages as a stream of bytes. Only one
+// reader runs at a time (readLock), so pending needs no lock.
+func (file *file) receive(b []byte) (int, error) {
+	if len(file.pending) > 0 {
+		n := copy(b, file.pending)
+		file.pending = file.pending[n:]
+		return n, nil
+	}
+	for {
+		n, attached, err := syscall.ChannelReceive(file.sysfd, b, syscall.CHANNEL_WAIT)
+		if attached >= 0 {
+			// a handle sent along has no place in a byte stream
+			syscall.Close(attached)
+		}
+		switch err {
+		case nil:
+			if n == 0 {
+				continue // an empty message carries no bytes
+			}
+			return n, nil
+		case syscall.ERR_TOO_LARGE:
+			// The message stays queued: take it whole and keep the rest.
+			size, _, err := syscall.ChannelReceive(file.sysfd, nil, syscall.CHANNEL_PEEK|syscall.CHANNEL_WAIT)
+			if err != nil && err != syscall.ERR_TOO_LARGE {
+				return 0, err
+			}
+			msg := make([]byte, size)
+			m, attached, err := syscall.ChannelReceive(file.sysfd, msg, syscall.CHANNEL_WAIT)
+			if attached >= 0 {
+				syscall.Close(attached)
+			}
+			if err == syscall.ERR_TOO_LARGE {
+				continue // another reader took it; the next one is larger
+			}
+			if err != nil {
+				return 0, err
+			}
+			n := copy(b, msg[:m])
+			file.pending = msg[n:m]
+			return n, nil
+		case syscall.ERR_CLOSED:
+			return 0, io.EOF
+		default:
+			return 0, err
+		}
+	}
+}
+
+// pread reads len(b) bytes from the File starting at byte offset off.
+// It returns the number of bytes read and the error, if any.
+// EOF is signaled by a zero count with err set to nil.
+func (f *File) pread(b []byte, off int64) (n int, err error) {
+	if err := f.readLock(); err != nil {
+		return 0, err
+	}
+	defer f.readUnlock()
+	if f.kind != syscall.KIND_DOCUMENT {
+		return 0, syscall.ESPIPE
+	}
+	n, err = syscall.DocumentReadAt(f.sysfd, b, off)
+	if n == 0 && len(b) > 0 && err == nil {
+		return 0, io.EOF
+	}
+	return n, err
+}
+
+// write writes len(b) bytes to the File.
+// It returns the number of bytes written and an error, if any.
+// A channel carries each Write as messages; an empty Write sends none.
+func (f *File) write(b []byte) (n int, err error) {
+	if err := f.writeLock(); err != nil {
+		return 0, err
+	}
+	defer f.writeUnlock()
+	if len(b) == 0 {
+		return 0, nil
+	}
+	switch f.kind {
+	case syscall.KIND_DOCUMENT:
+		f.mu.Lock()
+		defer f.mu.Unlock()
+		if f.appendMode {
+			size, err := syscall.DocumentSize(f.sysfd)
+			if err != nil {
+				return 0, err
+			}
+			f.off = size
+		}
+		n, err = writeAt(f.sysfd, b, f.off)
+		f.off += int64(n)
+		return n, err
+	case kindNull:
+		return len(b), nil
+	case syscall.KIND_FOLDER:
+		return 0, syscall.EISDIR
+	case 0:
+		if f.sysfd != syscall.Stderr {
+			return 0, syscall.EBADF
+		}
+		// Without handle 2, the log goes to the system log.
+		f.logOnce.Do(func() {
+			f.logfd, _ = syscall.SystemLogOpen()
+		})
+		if f.logfd < 0 {
+			return 0, syscall.EBADF
+		}
+		return send(f.logfd, b)
+	}
+	return send(f.sysfd, b)
+}
+
+func writeAt(h int, b []byte, off int64) (n int, err error) {
+	for n < len(b) {
+		m, err := syscall.DocumentWriteAt(h, b[n:], off+int64(n))
+		n += m
+		if err != nil {
+			return n, err
+		}
+		if m == 0 {
+			return n, io.ErrShortWrite
+		}
+	}
+	return n, nil
+}
+
+func send(h int, b []byte) (n int, err error) {
+	for n < len(b) {
+		chunk := b[n:]
+		if len(chunk) > maxMessage {
+			chunk = chunk[:maxMessage]
+		}
+		if _, err := syscall.ChannelSend(h, chunk, -1); err != nil {
+			return n, err
+		}
+		n += len(chunk)
+	}
+	return n, nil
+}
+
+// pwrite writes len(b) bytes to the File starting at byte offset off.
+// It returns the number of bytes written and an error, if any.
+func (f *File) pwrite(b []byte, off int64) (n int, err error) {
+	if err := f.writeLock(); err != nil {
+		return 0, err
+	}
+	defer f.writeUnlock()
+	if f.kind != syscall.KIND_DOCUMENT {
+		return 0, syscall.ESPIPE
+	}
+	return writeAt(f.sysfd, b, off)
+}
+
+// seek sets the offset for the next Read or Write on file to offset, interpreted
+// according to whence: 0 means relative to the origin of the file, 1 means
+// relative to the current offset, and 2 means relative to the end.
+// It returns the new offset and an error, if any.
+func (f *File) seek(offset int64, whence int) (ret int64, err error) {
+	if err := f.incref(""); err != nil {
+		return 0, err
+	}
+	defer f.decref()
+	// Free cached dirinfo, so we allocate a new one if we
+	// access this file as a directory again. See #35767 and #37161.
+	f.dirinfo.Store(nil)
+	if f.kind == syscall.KIND_FOLDER && offset == 0 && whence == io.SeekStart {
+		return 0, nil
+	}
+	if f.kind != syscall.KIND_DOCUMENT {
+		return 0, syscall.ESPIPE
+	}
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	switch whence {
+	case io.SeekStart:
+	case io.SeekCurrent:
+		offset += f.off
+	case io.SeekEnd:
+		size, err := syscall.DocumentSize(f.sysfd)
+		if err != nil {
+			return 0, err
+		}
+		offset += size
+	default:
+		return 0, syscall.EINVAL
+	}
+	if offset < 0 {
+		return 0, syscall.EINVAL
+	}
+	f.off = offset
+	return offset, nil
+}
+
+// Truncate changes the size of the named file.
+// If there is an error, it will be of type [*PathError].
+func Truncate(name string, size int64) error {
+	h, err := syscall.DocumentOpen(name, syscall.DOCUMENT_EDIT)
+	if err == nil {
+		err = syscall.DocumentSetSize(h, size)
+		syscall.Close(h)
+	}
+	if err != nil {
+		return &PathError{Op: "truncate", Path: name, Err: err}
+	}
+	return nil
+}
+
+// Remove removes the named file or directory.
+// If there is an error, it will be of type [*PathError].
+func Remove(name string) error {
+	if e := syscall.EntryRemove(name); e != nil {
+		return &PathError{Op: "remove", Path: name, Err: e}
+	}
+	return nil
+}
+
+// rename moves an entry. Nocturne never moves onto an existing name; as
+// Rename replaces an existing document, a document in the way is removed
+// first.
+func rename(oldname, newname string) error {
+	err := syscall.EntryMove(oldname, newname)
+	if err == syscall.ERR_EXISTS {
+		var from, to syscall.Entry
+		if syscall.EntryInfo(oldname, &from) == nil && from.Kind != syscall.KIND_FOLDER &&
+			syscall.EntryInfo(newname, &to) == nil && to.Kind != syscall.KIND_FOLDER {
+			if err = syscall.EntryRemove(newname); err == nil {
+				err = syscall.EntryMove(oldname, newname)
+			}
+		}
+	}
+	if err != nil {
+		return &LinkError{"rename", oldname, newname, err}
+	}
+	return nil
+}
+
+// See docs in file.go:Chmod. Nocturne entries have no permission bits.
+func chmod(name string, mode FileMode) error {
+	var e syscall.Entry
+	if err := syscall.EntryInfo(name, &e); err != nil {
+		return &PathError{Op: "chmod", Path: name, Err: err}
+	}
+	return nil
+}
+
+// Chtimes changes the access and modification times of the named
+// file, similar to the Unix utime() or utimes() functions.
+// A zero time.Time value will leave the corresponding file time unchanged.
+//
+// Nocturne sets an entry's modification time when it is written;
+// Chtimes returns [syscall.ENOTSUP] wrapped in [*PathError].
+func Chtimes(name string, atime time.Time, mtime time.Time) error {
+	return &PathError{Op: "chtimes", Path: name, Err: syscall.ENOTSUP}
+}
+
+// Pipe returns a connected pair of Files; reads from r return bytes
+// written to w. It returns the files and an error, if any.
+// The pair is a Nocturne channel.
+func Pipe() (r *File, w *File, err error) {
+	a, b, e := syscall.ChannelPair()
+	if e != nil {
+		return nil, nil, NewSyscallError("pipe", e)
+	}
+	return newFile(a, "|0", "", syscall.KIND_CHANNEL), newFile(b, "|1", "", syscall.KIND_CHANNEL), nil
+}
+
+// not supported on Nocturne
+
+// Link creates newname as a hard link to the oldname file.
+// If there is an error, it will be of type *LinkError.
+func Link(oldname, newname string) error {
+	return &LinkError{"link", oldname, newname, syscall.ENOTSUP}
+}
+
+// Symlink creates newname as a symbolic link to oldname.
+// If there is an error, it will be of type *LinkError.
+func Symlink(oldname, newname string) error {
+	return &LinkError{"symlink", oldname, newname, syscall.ENOTSUP}
+}
+
+func readlink(name string) (string, error) {
+	return "", &PathError{Op: "readlink", Path: name, Err: syscall.ENOTSUP}
+}
+
+// Chown changes the numeric uid and gid of the named file.
+// Nocturne has no owners: Chown returns [syscall.ENOTSUP] wrapped in [*PathError].
+func Chown(name string, uid, gid int) error {
+	return &PathError{Op: "chown", Path: name, Err: syscall.ENOTSUP}
+}
+
+// Lchown changes the numeric uid and gid of the named file.
+// If there is an error, it will be of type [*PathError].
+func Lchown(name string, uid, gid int) error {
+	return &PathError{Op: "lchown", Path: name, Err: syscall.ENOTSUP}
+}
+
+// Chown changes the numeric uid and gid of the named file.
+// If there is an error, it will be of type [*PathError].
+func (f *File) Chown(uid, gid int) error {
+	if f == nil {
+		return ErrInvalid
+	}
+	return &PathError{Op: "chown", Path: f.name, Err: syscall.ENOTSUP}
+}
+
+// tempDir is the setting TEMP: the user's temporary folder, emptied at
+// every start.
+func tempDir() string {
+	dir := Getenv("TEMP")
+	if dir == "" {
+		dir = `C:\`
+	}
+	return dir
+}
+
+// Chdir changes the current folder to the file,
+// which must be a folder.
+// If there is an error, it will be of type [*PathError].
+func (f *File) Chdir() error {
+	if err := f.incref("chdir"); err != nil {
+		return err
+	}
+	defer f.decref()
+	err := error(syscall.ENOTDIR)
+	if f.kind == syscall.KIND_FOLDER {
+		err = syscall.Chdir(f.path)
+	}
+	if err != nil {
+		return &PathError{Op: "chdir", Path: f.name, Err: err}
+	}
+	return nil
+}
+
+// setDeadline sets the read and write deadline.
+func (f *File) setDeadline(time.Time) error {
+	if err := f.checkValid("SetDeadline"); err != nil {
+		return err
+	}
+	return poll.ErrNoDeadline
+}
+
+// setReadDeadline sets the read deadline.
+func (f *File) setReadDeadline(time.Time) error {
+	if err := f.checkValid("SetReadDeadline"); err != nil {
+		return err
+	}
+	return poll.ErrNoDeadline
+}
+
+// setWriteDeadline sets the write deadline.
+func (f *File) setWriteDeadline(time.Time) error {
+	if err := f.checkValid("SetWriteDeadline"); err != nil {
+		return err
+	}
+	return poll.ErrNoDeadline
+}
+
+// checkValid checks whether f is valid for use, but does not prepare
+// to actually use it. If f is not ready checkValid returns an appropriate
+// error, perhaps incorporating the operation name op.
+func (f *File) checkValid(op string) error {
+	if f == nil {
+		return ErrInvalid
+	}
+	if err := f.incref(op); err != nil {
+		return err
+	}
+	return f.decref()
+}
+
+type rawConn struct{}
+
+func (c *rawConn) Control(f func(uintptr)) error {
+	return syscall.ENOTSUP
+}
+
+func (c *rawConn) Read(f func(uintptr) bool) error {
+	return syscall.ENOTSUP
+}
+
+func (c *rawConn) Write(f func(uintptr) bool) error {
+	return syscall.ENOTSUP
+}
+
+func newRawConn(file *File) (*rawConn, error) {
+	return nil, syscall.ENOTSUP
+}
+
+func ignoringEINTR(fn func() error) error {
+	return fn()
+}
+
+func ignoringEINTR2[T any](fn func() (T, error)) (T, error) {
+	return fn()
+}
