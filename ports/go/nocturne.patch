new file mode 100644
index 00000000..fd52061b
--- /dev/null
+++ b/src/net/ipsock_nocturne.go
@@ -0,0 +1,68 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package net
+
+import (
+	"context"
+	"os"
+	"syscall"
+	"time"
+)
+
+// Nocturne's network is IPv4.
+func (p *ipStackCapabilities) probe() {
+	p.ipv4Enabled = true
+}
+
+func errNotIPv4(ip IP) error {
+	return &AddrError{Err: "not an IPv4 address", Addr: ip.String()}
+}
+
+// connectTCP connects to `to` within ctx's deadline. The connection call
+// blocks, so it runs on its own goroutine when ctx can be cancelled; a
+// connection that completes after cancellation is given up.
+func connectTCP(ctx context.Context, to syscall.Sockaddr4) (int, error) {
+	if err := ctx.Err(); err != nil {
+		return -1, mapErr(err)
+	}
+	ms := 0 // the system's limit
+	if d, ok := ctx.Deadline(); ok {
+		left := time.Until(d)
+		if left <= 0 {
+			return -1, errTimeout
+		}
+		ms = int(max(min(left/time.Millisecond, 1<<30), 1))
+	}
+	connect := func() (int, error) {
+		id, err := syscall.TCPConnect(to.IP, to.Port, ms)
+		if err != nil {
+			return -1, os.NewSyscallError("connect", err)
+		}
+		return id, nil
+	}
+	if ctx.Done() == nil {
+		return connect()
+	}
+	type result struct {
+		id  int
+		err error
+	}
+	ch := make(chan result, 1)
+	go func() {
+		id, err := connect()
+		ch <- result{id, err}
+	}()
+	select {
+	case r := <-ch:
+		return r.id, r.err
+	case <-ctx.Done():
+		go func() {
+			if r := <-ch; r.err == nil {
+				syscall.TCPClose(r.id)
+			}
+		}()
+		return -1, mapErr(ctx.Err())
+	}
+}
diff --git a/src/net/lookup_nocturne.go b/src/net/lookup_nocturne.go
new file mode 100644
index 00000000..08b06369
--- /dev/null
+++ b/src/net/lookup_nocturne.go
@@ -0,0 +1,157 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package net
+
+import (
+	"context"
+	"syscall"
+	"time"
+)
+
+// Nocturne resolves addresses in the system (NetDNSAll, IPv4, with one
+// cache for every app). Other records go through Go's DNS client to the
+// same resolver (dnsconfig_nocturne.go), as do all lookups of a Resolver
+// with PreferGo or Dial.
+
+// Nocturne has no table of fixed names: every name goes to the resolver,
+// so no lookup reads this.
+var hostsFilePath = ""
+
+// The system resolver plays the part that the C library does elsewhere.
+const cgoAvailable = true
+
+func lookupProtocol(_ context.Context, name string) (int, error) {
+	return lookupProtocolMap(name)
+}
+
+func (r *Resolver) useGo() bool {
+	return r != nil && (r.PreferGo || r.Dial != nil)
+}
+
+func (r *Resolver) lookupHost(ctx context.Context, host string) ([]string, error) {
+	if r.useGo() {
+		return r.goLookupHostOrder(ctx, host, hostLookupDNS, getSystemDNSConfig())
+	}
+	ips, err := r.lookupIP(ctx, "ip", host)
+	if err != nil {
+		return nil, err
+	}
+	addrs := make([]string, len(ips))
+	for i, ip := range ips {
+		addrs[i] = ip.String()
+	}
+	return addrs, nil
+}
+
+func (r *Resolver) lookupIP(ctx context.Context, network, host string) ([]IPAddr, error) {
+	if r.useGo() {
+		ips, _, err := r.goLookupIPCNAMEOrder(ctx, network, host, hostLookupDNS, getSystemDNSConfig())
+		return ips, err
+	}
+	if network == "ip6" {
+		return nil, newDNSError(errNoSuchHost, host, "")
+	}
+	if ctx.Done() == nil {
+		return systemLookupIP(host)
+	}
+	type result struct {
+		ips []IPAddr
+		err error
+	}
+	ch := make(chan result, 1)
+	go func() {
+		ips, err := systemLookupIP(host)
+		ch <- result{ips, err}
+	}()
+	select {
+	case r := <-ch:
+		return r.ips, r.err
+	case <-ctx.Done():
+		return nil, newDNSError(mapErr(ctx.Err()), host, "")
+	}
+}
+
+// systemLookupIP asks the system resolver for host's IPv4 addresses.
+func systemLookupIP(host string) ([]IPAddr, error) {
+	var small [16]uint32
+	ips := small[:]
+	var res syscall.DNSResult
+	err := syscall.NetDNSAll(host, ips, &res, nil)
+	if err == nil && int(res.Count) > len(ips) {
+		// The complete answer is cached; ask again with room for it.
+		ips = make([]uint32, res.Count)
+		err = syscall.NetDNSAll(host, ips, &res, nil)
+	}
+	if err == nil && res.Status == syscall.DNS_OK && res.Count > 0 {
+		addrs := make([]IPAddr, min(int(res.Count), len(ips)))
+		for i := range addrs {
+			addrs[i] = IPAddr{IP: ipFromUint32(ips[i])}
+		}
+		return addrs, nil
+	}
+	switch {
+	case res.Version == 0 && err == syscall.ERR_INVALID:
+		return nil, newDNSError(errNoSuchHost, host, "")
+	case res.Status == syscall.DNS_OK, res.Status == syscall.DNS_NXDOMAIN, res.Status == syscall.DNS_NODATA:
+		return nil, newDNSError(errNoSuchHost, host, "")
+	case res.Status == syscall.DNS_TIMEOUT, err == syscall.ERR_TIMEOUT:
+		return nil, newDNSError(errTimeout, host, "")
+	case res.Status == syscall.DNS_SERVFAIL, res.Status == syscall.DNS_UNREACHABLE,
+		res.Status == syscall.DNS_RESOURCE:
+		return nil, newDNSError(errServerTemporarilyMisbehaving, host, "")
+	case res.Status == syscall.DNS_CANCELLED:
+		return nil, newDNSError(errCanceled, host, "")
+	}
+	if err == nil {
+		err = errServerMisbehaving
+	}
+	return nil, newDNSError(err, host, "")
+}
+
+func (r *Resolver) lookupPort(ctx context.Context, network, service string) (int, error) {
+	return lookupPortMap(network, service)
+}
+
+func (r *Resolver) lookupCNAME(ctx context.Context, name string) (string, error) {
+	return r.goLookupCNAME(ctx, name, hostLookupDNS, getSystemDNSConfig())
+}
+
+func (r *Resolver) lookupSRV(ctx context.Context, service, proto, name string) (string, []*SRV, error) {
+	return r.goLookupSRV(ctx, service, proto, name)
+}
+
+func (r *Resolver) lookupMX(ctx context.Context, name string) ([]*MX, error) {
+	return r.goLookupMX(ctx, name)
+}
+
+func (r *Resolver) lookupNS(ctx context.Context, name string) ([]*NS, error) {
+	return r.goLookupNS(ctx, name)
+}
+
+func (r *Resolver) lookupTXT(ctx context.Context, name string) ([]string, error) {
+	return r.goLookupTXT(ctx, name)
+}
+
+func (r *Resolver) lookupAddr(ctx context.Context, addr string) ([]string, error) {
+	return r.goLookupPTR(ctx, addr, hostLookupDNS, getSystemDNSConfig())
+}
+
+// dnsReadConfig describes the system resolver for Go's DNS client; Nocturne
+// has no resolver file, so the name is ignored.
+func dnsReadConfig(string) *dnsConfig {
+	conf := &dnsConfig{
+		ndots:    1,
+		timeout:  5 * time.Second,
+		attempts: 2,
+	}
+	var ni syscall.NetInfo
+	if syscall.GetNetInfo(&ni) == nil && ni.Present != 0 && ni.Resolver != [4]byte{} {
+		ip := IPv4(ni.Resolver[0], ni.Resolver[1], ni.Resolver[2], ni.Resolver[3])
+		conf.servers = []string{JoinHostPort(ip.String(), "53")}
+	} else {
+		conf.servers = defaultNS
+	}
+	return conf
+}
