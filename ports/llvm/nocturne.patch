+namespace {
+
+// A folder's entries as they were when the iteration began: removing entries
+// while going through them (remove_directories) leaves the rest to come.
+struct FolderListing {
+  n_entry *Entries = nullptr;
+  size_t Count = 0, Next = 0;
+
+  ~FolderListing() { std::free(Entries); }
+};
+
+} // end anonymous namespace
+
+std::error_code detail::directory_iterator_construct(detail::DirIterState &It,
+                                                     StringRef Path,
+                                                     bool FollowSymlinks) {
+  sandbox::violationIfEnabled();
+
+  SmallString<256> Folder;
+  if (std::error_code EC = nocturne::completePath(Path, Folder))
+    return EC;
+  auto Listing = std::make_unique<FolderListing>();
+  n_result Count = n_folder_entries(Folder.data(), &Listing->Entries);
+  if (Count < 0)
+    return nocturne::errorCode(Count);
+  Listing->Count = Count;
+
+  It.IterationHandle = reinterpret_cast<intptr_t>(Listing.release());
+  // Add something for replace_filename to replace.
+  SmallString<128> PathWithDot(Path);
+  path::append(PathWithDot, ".");
+  It.CurrentEntry = directory_entry(PathWithDot.str(), FollowSymlinks);
+  return directory_iterator_increment(It);
+}
+
+std::error_code detail::directory_iterator_destruct(detail::DirIterState &It) {
+  delete reinterpret_cast<FolderListing *>(It.IterationHandle);
+  It.IterationHandle = 0;
+  It.CurrentEntry = directory_entry();
+  return std::error_code();
+}
+
+std::error_code detail::directory_iterator_increment(detail::DirIterState &It) {
+  sandbox::violationIfEnabled();
+
+  auto &Listing = *reinterpret_cast<FolderListing *>(It.IterationHandle);
+  if (Listing.Next == Listing.Count)
+    return directory_iterator_destruct(It);
+  const n_entry &Entry = Listing.Entries[Listing.Next++];
+  // The listing has what status needs: there is no other look at the entry.
+  It.CurrentEntry.replace_filename(
+      Entry.name, entryType(Entry),
+      basic_file_status(entryType(Entry), all_all, Entry.modified,
+                        Entry.modified_ns, Entry.size));
+  return std::error_code();
+}
+
+ErrorOr<basic_file_status> directory_entry::status() const { return Status; }
+
+std::error_code openFile(const Twine &Name, int &ResultFD,
+                         CreationDisposition Disp, FileAccess Access,
+                         OpenFlags Flags, unsigned Mode) {
+  sandbox::violationIfEnabled();
+
+  ResultFD = kInvalidFile;
+  SmallString<256> Path;
+  if (std::error_code EC = nocturne::completePath(Name, Path))
+    return EC;
+  // As elsewhere, appending opens the document that is there, or a new one.
+  if (Flags & OF_Append)
+    Disp = CD_OpenAlways;
+  int Existing = (Access & FA_Write) ? N_DOCUMENT_EDIT : N_DOCUMENT_READ;
+  n_handle H = -N_ERR_INVALID;
+  switch (Disp) {
+  case CD_CreateAlways:
+    // New content that takes the document's place when it is closed: until
+    // then, everyone else reads the document as it was.
+    H = n_document_open(Path.data(), N_DOCUMENT_REPLACE);
+    break;
+  case CD_CreateNew:
+    H = n_document_open(Path.data(), N_DOCUMENT_CREATE);
+    break;
+  case CD_OpenExisting:
+    H = n_document_open(Path.data(), Existing);
+    break;
+  case CD_OpenAlways:
+    H = n_document_open(Path.data(), Existing);
+    if (H == -N_ERR_NOT_FOUND)
+      H = n_document_open(Path.data(), N_DOCUMENT_CREATE);
+    if (H == -N_ERR_EXISTS) // made meanwhile
+      H = n_document_open(Path.data(), Existing);
+    break;
+  }
+  if (H < 0)
+    return nocturne::errorCode(H);
+  handleStates().opened(H, Flags & OF_Append);
+  ResultFD = H;
+  return std::error_code();
+}
+
+Expected<int> openNativeFile(const Twine &Name, CreationDisposition Disp,
+                             FileAccess Access, OpenFlags Flags,
+                             unsigned Mode) {
+  sandbox::violationIfEnabled();
+
+  int FD;
+  std::error_code EC = openFile(Name, FD, Disp, Access, Flags, Mode);
+  if (EC)
+    return errorCodeToError(EC);
+  return FD;
+}
+
+std::error_code openFileForRead(const Twine &Name, int &ResultFD,
+                                OpenFlags Flags,
+                                SmallVectorImpl<char> *RealPath) {
+  sandbox::violationIfEnabled();
+
+  std::error_code EC =
+      openFile(Name, ResultFD, CD_OpenExisting, FA_Read, Flags, 0666);
+  if (EC)
+    return EC;
+  // Left empty when it cannot be had, as elsewhere.
+  if (RealPath)
+    (void)real_path(Name, *RealPath);
+  return std::error_code();
+}
+
+Expected<file_t> openNativeFileForRead(const Twine &Name, OpenFlags Flags,
+                                       SmallVectorImpl<char> *RealPath) {
+  sandbox::violationIfEnabled();
+
+  file_t ResultFD;
+  std::error_code EC = openFileForRead(Name, ResultFD, Flags, RealPath);
+  if (EC)
+    return errorCodeToError(EC);
+  return ResultFD;
+}
+
+// The app's input, output and log, by convention.
+file_t getStdinHandle() { return 0; }
+file_t getStdoutHandle() { return 1; }
+file_t getStderrHandle() { return 2; }
+
+// The messages of a channel as one run of bytes, which ends when the other
+// end has gone.
+static Expected<size_t> readMessages(file_t H, HandleState &State,
+                                     MutableArrayRef<char> Buf) {
+  if (Buf.empty())
+    return 0;
+  while (State.MessageRead == State.Message.size()) {
+    n_result Read = n_channel_receive(H, Buf.data(), Buf.size(),
+                                      N_CHANNEL_WAIT, nullptr);
+    if (Read > 0)
+      return Read;
+    if (Read == -N_ERR_CLOSED)
+      return 0;
+    if (Read == -N_ERR_TOO_LARGE) {
+      Read = n_channel_receive(H, nullptr, 0, N_CHANNEL_WAIT | N_CHANNEL_PEEK,
+                               nullptr);
+      if (Read >= 0) {
+        State.Message.resize(Read);
+        Read = n_channel_receive(H, State.Message.data(), Read, N_CHANNEL_WAIT,
+                                 nullptr);
+      }
+      if (Read >= 0) {
+        State.Message.resize(Read);
+        State.MessageRead = 0;
+      }
+    }
+    if (Read < 0)
+      return errorCodeToError(nocturne::errorCode(Read));
+    // An empty message carries no bytes: the next one is waited for.
+  }
+  size_t Size = std::min(Buf.size(), State.Message.size() - State.MessageRead);
+  std::memcpy(Buf.data(), State.Message.data() + State.MessageRead, Size);
+  State.MessageRead += Size;
+  if (State.MessageRead == State.Message.size()) {
+    State.Message.clear();
+    State.MessageRead = 0;
+  }
+  return Size;
+}
+
+Expected<size_t> readNativeFile(file_t FD, MutableArrayRef<char> Buf) {
+  sandbox::violationIfEnabled();
+
+  std::shared_ptr<HandleState> State = handleStates().get(FD);
+  if (!State)
+    return errorCodeToError(make_error_code(errc::bad_file_descriptor));
+  std::lock_guard<std::mutex> Guard(State->Lock);
+  if (State->Kind != N_KIND_DOCUMENT)
+    return readMessages(FD, *State, Buf);
+  n_result Read =
+      n_document_read_at(FD, State->Position, Buf.data(), Buf.size());
+  if (Read < 0)
+    return errorCodeToError(nocturne::errorCode(Read));
+  State->Position += Read;
+  return Read;
+}
+
+Expected<size_t> readNativeFileSlice(file_t FD, MutableArrayRef<char> Buf,
+                                     uint64_t Offset) {
+  sandbox::violationIfEnabled();
+
+  n_result Read = n_document_read_at(FD, Offset, Buf.data(), Buf.size());
+  if (Read < 0)
+    return errorCodeToError(nocturne::errorCode(Read));
+  return Read;
+}
+
+// A document's claim is its lock: one opening holds it at a time, so a shared
+// lock is an exclusive one.
+static std::error_code claim(int FD, bool Wait) {
+  std::shared_ptr<HandleState> State = handleStates().get(FD);
+  if (!State)
+    return make_error_code(errc::bad_file_descriptor);
+  n_result R = n_document_claim(FD, Wait);
+  if (R < 0)
+    return nocturne::errorCode(R);
+  std::lock_guard<std::mutex> Guard(State->Lock);
+  State->Claimed = true;
+  return std::error_code();
+}
+
+std::error_code tryLockFile(int FD, std::chrono::milliseconds Timeout,
+                            LockKind Kind) {
+  auto End = std::chrono::steady_clock::now() + Timeout;
+  do {
+    std::error_code EC = claim(FD, false);
+    if (EC != errc::resource_unavailable_try_again)
+      return EC;
+    if (Timeout.count() == 0)
+      break;
+    n_sleep_ms(1);
+  } while (std::chrono::steady_clock::now() < End);
+  return make_error_code(errc::no_lock_available);
+}
+
+std::error_code lockFile(int FD, LockKind Kind) { return claim(FD, true); }
+
+std::error_code unlockFile(int FD) {
+  std::shared_ptr<HandleState> State = handleStates().get(FD);
+  if (!State)
+    return make_error_code(errc::bad_file_descriptor);
+  std::lock_guard<std::mutex> Guard(State->Lock);
+  State->Claimed = false;
+  n_result R = n_document_release(FD);
+  return R < 0 ? nocturne::errorCode(R) : std::error_code();
+}
+
+std::error_code closeFile(file_t &F) {
+  sandbox::violationIfEnabled();
+
+  file_t TmpF = F;
+  F = kInvalidFile;
+  return nocturne::close(TmpF);
+}
+
+static std::error_code removeContents(const Twine &Folder, bool IgnoreErrors) {
+  std::error_code EC;
+  directory_iterator Begin(Folder, EC, false);
+  directory_iterator End;
+  while (!EC && Begin != End) {
+    if (Begin->type() == file_type::directory_file) {
+      EC = removeContents(Begin->path(), IgnoreErrors);
+      if (EC && !IgnoreErrors)
+        return EC;
+    }
+    EC = fs::remove(Begin->path(), true);
+    if (EC && !IgnoreErrors)
+      return EC;
+    Begin.increment(EC);
+  }
+  return IgnoreErrors ? std::error_code() : EC;
+}
+
+std::error_code remove_directories(const Twine &Path, bool IgnoreErrors) {
+  std::error_code EC = removeContents(Path, IgnoreErrors);
+  if (!EC)
+    EC = fs::remove(Path, true);
+  return IgnoreErrors ? std::error_code() : EC;
+}
+
+std::error_code real_path(const Twine &Path, SmallVectorImpl<char> &Dest,
+                          bool ExpandTilde) {
+  sandbox::violationIfEnabled();
+
+  // No links and no "~" (expand_tilde): the real path is the complete one,
+  // with each name as its entry keeps it.
+  Dest.clear();
+  if (Path.isTriviallyEmpty())
+    return std::error_code();
+  SmallString<256> Full;
+  if (std::error_code EC = nocturne::completePath(Path, Full))
+    return EC;
+  const size_t Root = 3; // "C:\"
+  Dest.append(Full.begin(), Full.begin() + Root);
+  for (size_t Start = Root; Start < Full.size();) {
+    size_t End = std::min(Full.find('\\', Start), Full.size());
+    char After = Full.data()[End]; // '\\', or the nul after Full
+    Full.data()[End] = 0;
+    n_entry Entry;
+    n_result R = n_entry_info(Full.data(), &Entry);
+    Full.data()[End] = After;
+    if (R < 0) {
+      Dest.clear();
+      return nocturne::errorCode(R);
+    }
+    if (Dest.size() > Root)
+      Dest.push_back('\\');
+    Dest.append(Entry.name, Entry.name + std::strlen(Entry.name));
+    Start = End + 1;
+  }
+  return std::error_code();
+}
+
+std::error_code readlink(const Twine &Path, SmallVectorImpl<char> &Dest) {
+  // No entry is a link.
+  Dest.clear();
+  return make_error_code(errc::invalid_argument);
+}
+
+} // end namespace fs
+
+namespace path {
+
+static void assignFolder(SmallVectorImpl<char> &Result, const char *Folder) {
+  Result.assign(Folder, Folder + std::strlen(Folder));
+}
+
+bool home_directory(SmallVectorImpl<char> &Result) {
+  assignFolder(Result, n_user_folder());
+  return true;
+}
+
+// What an app keeps goes in the user's AppData, in a folder named for it.
+bool user_config_directory(SmallVectorImpl<char> &Result) {
+  assignFolder(Result, n_user_folder());
+  append(Result, "AppData");
+  return true;
+}
+
+bool cache_directory(SmallVectorImpl<char> &Result) {
+  return user_config_directory(Result);
+}
+
+void system_temp_directory(bool ErasedOnReboot, SmallVectorImpl<char> &Result) {
+  // The one temporary folder is emptied at every start.
+  assignFolder(Result, n_temp_folder());
+}
+
+} // end namespace path
+
+} // end namespace sys
+} // end namespace llvm
