@@ -0,0 +1,93 @@
+//===--- Nocturne.h - Nocturne OS ToolChain Implementation ------*- C++ -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#ifndef LLVM_CLANG_LIB_DRIVER_TOOLCHAINS_NOCTURNE_H
+#define LLVM_CLANG_LIB_DRIVER_TOOLCHAINS_NOCTURNE_H
+
+#include "clang/Driver/Tool.h"
+#include "clang/Driver/ToolChain.h"
+
+namespace clang {
+namespace driver {
+namespace tools {
+namespace nocturne {
+
+// Nocturne programs are static ELF executables laid out by the SDK's linker
+// script: there are no shared libraries and no dynamic loader.
+class LLVM_LIBRARY_VISIBILITY Linker final : public Tool {
+public:
+  Linker(const ToolChain &TC) : Tool("nocturne::Linker", "ld.lld", TC) {}
+
+  bool hasIntegratedCPP() const override { return false; }
+  bool isLinkJob() const override { return true; }
+
+  void ConstructJob(Compilation &C, const JobAction &JA,
+                    const InputInfo &Output, const InputInfoList &Inputs,
+                    const llvm::opt::ArgList &TCArgs,
+                    const char *LinkingOutput) const override;
+};
+
+} // end namespace nocturne
+} // end namespace tools
+
+namespace toolchains {
+
+// The SDK (the sysroot, C:\Nocturne\SDK unless --sysroot names another) holds
+// the C and C++ library headers in Include and crt1.o, libc.a, libc++.a,
+// libunwind.a and user.ld in Lib.
+class LLVM_LIBRARY_VISIBILITY Nocturne final : public ToolChain {
+public:
+  Nocturne(const Driver &D, const llvm::Triple &Triple,
+           const llvm::opt::ArgList &Args);
+
+  bool HasNativeLLVMSupport() const override { return true; }
+  bool IsMathErrnoDefault() const override { return false; }
+  bool isPICDefault() const override { return false; }
+  bool isPIEDefault(const llvm::opt::ArgList &Args) const override {
+    return false;
+  }
+  bool isPICDefaultForced() const override { return false; }
+
+  RuntimeLibType GetDefaultRuntimeLibType() const override {
+    return ToolChain::RLT_CompilerRT;
+  }
+  CXXStdlibType GetDefaultCXXStdlibType() const override {
+    return ToolChain::CST_Libcxx;
+  }
+  // Only C++ exceptions unwind the stack, and -fexceptions gives the code they
+  // unwind through the tables it needs.
+  UnwindTableLevel
+  getDefaultUnwindTableLevel(const llvm::opt::ArgList &Args) const override {
+    return UnwindTableLevel::None;
+  }
+  const char *getDefaultLinker() const override { return "ld.lld"; }
+  // Programs run on Nocturne's own threads (thread_create), the only model:
+  // code is built for many threads.
+  std::string getThreadModel() const override { return "nocturne"; }
+  bool isThreadModelSupported(const StringRef Model) const override {
+    return Model == "nocturne";
+  }
+
+  std::string computeSysRoot() const override;
+
+  void
+  AddClangSystemIncludeArgs(const llvm::opt::ArgList &DriverArgs,
+                            llvm::opt::ArgStringList &CC1Args) const override;
+  void AddClangCXXStdlibIncludeArgs(
+      const llvm::opt::ArgList &DriverArgs,
+      llvm::opt::ArgStringList &CC1Args) const override;
+
+protected:
+  Tool *buildLinker() const override;
+};
+
+} // end namespace toolchains
+} // end namespace driver
+} // end namespace clang
+
+#endif // LLVM_CLANG_LIB_DRIVER_TOOLCHAINS_NOCTURNE_H
