+//===- llvm/Support/Nocturne/Nocturne.h - Common Nocturne Include File ---===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// The Nocturne implementations of the Support library use Nocturne's native
+// interface (nocturne.h): typed handles, documents and folders named by
+// complete paths, message channels and apps. This header holds what several
+// of them share.
+//
+//===----------------------------------------------------------------------===//
+
+#ifndef LLVM_LIB_SUPPORT_NOCTURNE_NOCTURNE_H
+#define LLVM_LIB_SUPPORT_NOCTURNE_NOCTURNE_H
+
+#include "llvm/ADT/SmallVector.h"
+#include "llvm/ADT/StringRef.h"
+#include "llvm/ADT/Twine.h"
+#include "llvm/Support/FileSystem.h"
+#include <cstdint>
+#include <nocturne.h>
+#include <string>
+#include <system_error>
+
+namespace llvm {
+namespace sys {
+namespace nocturne {
+
+/// A failed n_result is a negated N_ERR_* code, which is also the errno value
+/// for it, so the generic category names it and compares it with std::errc.
+inline std::error_code errorCode(n_result R) {
+  return std::error_code(static_cast<int>(-R), std::generic_category());
+}
+
+/// Sets *ErrMsg, when there is one, to Prefix and what EC says.
+inline void setErrMsg(std::string *ErrMsg, const Twine &Prefix,
+                      std::error_code EC) {
+  if (ErrMsg)
+    *ErrMsg = (Prefix + ": " + EC.message()).str();
+}
+
+/// Path as Nocturne takes it: complete ("C:\a\b", with "." and ".." resolved),
+/// taken inside this app's folder when it is not complete already. Result is
+/// followed by a nul that is not part of it.
+std::error_code completePath(const Twine &Path, SmallVectorImpl<char> &Result);
+
+/// The complete path of the program Name names, as find_program finds it: a
+/// bare name in the system's folder, then in each app's folder under Programs;
+/// any other name completed. Empty when there is none.
+std::string findProgram(StringRef Name);
+
+/// A document has no shared cursor, so fs keeps where each handle reads and
+/// writes next: from the start of a document fs opened, and at the end of one
+/// it opened to append to. A document the app was given (its input or output)
+/// is read from its start and written at its end, as another app reads that
+/// output after it. A channel carries the bytes in order, as messages.
+///
+/// Reading is fs::readNativeFile. write writes all of Data where H writes.
+std::error_code write(fs::file_t H, StringRef Data);
+
+/// Where H reads and writes next in a document, or -1 when H has no such
+/// place: it appends, or it is a channel.
+int64_t position(fs::file_t H);
+std::error_code setPosition(fs::file_t H, uint64_t Position);
+
+/// Closes H, which saves a document it replaces, and forgets what fs kept
+/// for it.
+std::error_code close(fs::file_t H);
+
+} // namespace nocturne
+} // namespace sys
+} // namespace llvm
+
+#endif
diff --git a/llvm/lib/Support/Nocturne/Path.inc b/llvm/lib/Support/Nocturne/Path.inc
new file mode 100644
index 00000000..3f83d270
--- /dev/null
+++ b/llvm/lib/Support/Nocturne/Path.inc
@@ -0,0 +1,822 @@
+//===- Nocturne/Path.inc - Nocturne Path Implementation ---------*- C++ -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// This file implements the Path API on Nocturne's documents and folders.
+// Nocturne takes complete paths ("C:\a\b"); a name is taken inside the app's
+// folder (its setting FOLDER). Names compare without regard to case and are
+// kept as they were given. There are no links, owners or permissions, and an
+// entry's id identifies it for as long as it exists, wherever it moves.
+//
+//===----------------------------------------------------------------------===//
+
+#include "Nocturne.h"
+#include "llvm/ADT/DenseMap.h"
+#include "llvm/Support/Chrono.h"
+#include "llvm/Support/MathExtras.h"
+#include <cstdlib>
+#include <cstring>
+#include <memory>
+#include <mutex>
+#include <string>
+
+namespace llvm {
+namespace sys {
+
+std::error_code nocturne::completePath(const Twine &Path,
+                                       SmallVectorImpl<char> &Result) {
+  SmallString<128> Storage;
+  StringRef Name = Path.toNullTerminatedStringRef(Storage);
+  // The folder it is taken in adds to its length; doubling finds room.
+  size_t Capacity = Name.size() + 256;
+  for (;;) {
+    Result.resize_for_overwrite(Capacity);
+    n_result Length = n_path_complete(Name.data(), Result.data(), Capacity);
+    if (Length >= 0) {
+      Result.truncate(Length); // the nul after it stays
+      return std::error_code();
+    }
+    if (Length != -N_ERR_TOO_LARGE) {
+      Result.clear();
+      return errorCode(Length);
+    }
+    Capacity *= 2;
+  }
+}
+
+std::string nocturne::findProgram(StringRef Name) {
+  std::string NameStr = Name.str();
+  char Program[4096];
+  if (!find_program(NameStr.c_str(), Program, sizeof(Program)))
+    return std::string();
+  return Program;
+}
+
+namespace {
+
+// What fs keeps for a handle it reads or writes (Nocturne.h). A channel gives
+// a message whole, so a read with less room than the message keeps the rest
+// for the reads after it.
+struct HandleState {
+  std::mutex Lock;
+  int64_t Kind = 0;      // N_KIND_*
+  bool Append = false;   // writes go to the document's end
+  bool Claimed = false;  // lockFile holds the document's claim
+  uint64_t Position = 0; // in a document
+  std::string Message;   // from a channel, read up to MessageRead
+  size_t MessageRead = 0;
+};
+
+class HandleStates {
+  std::mutex Lock;
+  DenseMap<fs::file_t, std::shared_ptr<HandleState>> States;
+
+public:
+  // A document fs opened.
+  void opened(fs::file_t H, bool Append) {
+    auto State = std::make_shared<HandleState>();
+    State->Kind = N_KIND_DOCUMENT;
+    State->Append = Append;
+    std::lock_guard<std::mutex> Guard(Lock);
+    States[H] = std::move(State);
+  }
+
+  // Null when H is not open. A handle fs did not open is one the app was
+  // given: a document of it is written at its end.
+  std::shared_ptr<HandleState> get(fs::file_t H) {
+    std::lock_guard<std::mutex> Guard(Lock);
+    std::shared_ptr<HandleState> &State = States[H];
+    if (!State) {
+      n_result Kind = n_handle_kind(H);
+      if (Kind < 0) {
+        States.erase(H);
+        return nullptr;
+      }
+      State = std::make_shared<HandleState>();
+      State->Kind = Kind;
+      State->Append = Kind == N_KIND_DOCUMENT;
+    }
+    return State;
+  }
+
+  void forget(fs::file_t H) {
+    std::lock_guard<std::mutex> Guard(Lock);
+    States.erase(H);
+  }
+};
+
+// Never destroyed: streams flush into it while static objects are destroyed.
+HandleStates &handleStates() {
+  static HandleStates *States = new HandleStates();
+  return *States;
+}
+
+} // end anonymous namespace
+
+std::error_code nocturne::write(fs::file_t H, StringRef Data) {
+  std::shared_ptr<HandleState> State = handleStates().get(H);
+  if (!State)
+    return make_error_code(errc::bad_file_descriptor);
+  std::lock_guard<std::mutex> Guard(State->Lock);
+  n_result R = 0;
+  if (State->Kind != N_KIND_DOCUMENT) {
+    while (R >= 0 && !Data.empty()) {
+      R = n_channel_send(H, Data.data(), Data.size(), -1);
+      if (R == 0)
+        R = -N_ERR_IO;
+      else if (R > 0)
+        Data = Data.drop_front(R);
+    }
+    return R < 0 ? errorCode(R) : std::error_code();
+  }
+  // Another app may write at the same end: the claim keeps it out until these
+  // bytes are there.
+  bool Claim = State->Append && !State->Claimed;
+  if (Claim && (R = n_document_claim(H, true)) < 0)
+    return errorCode(R);
+  if (State->Append && (R = n_document_size(H)) >= 0)
+    State->Position = R;
+  while (R >= 0 && !Data.empty()) {
+    R = n_document_write_at(H, State->Position, Data.data(), Data.size());
+    if (R == 0)
+      R = -N_ERR_IO;
+    else if (R > 0) {
+      State->Position += R;
+      Data = Data.drop_front(R);
+    }
+  }
+  if (Claim)
+    n_document_release(H);
+  return R < 0 ? errorCode(R) : std::error_code();
+}
+
+int64_t nocturne::position(fs::file_t H) {
+  std::shared_ptr<HandleState> State = handleStates().get(H);
+  if (!State)
+    return -1;
+  std::lock_guard<std::mutex> Guard(State->Lock);
+  if (State->Kind != N_KIND_DOCUMENT || State->Append)
+    return -1;
+  return State->Position;
+}
+
+std::error_code nocturne::setPosition(fs::file_t H, uint64_t Position) {
+  std::shared_ptr<HandleState> State = handleStates().get(H);
+  if (!State)
+    return make_error_code(errc::bad_file_descriptor);
+  std::lock_guard<std::mutex> Guard(State->Lock);
+  if (State->Kind != N_KIND_DOCUMENT || State->Append)
+    return make_error_code(errc::invalid_seek);
+  State->Position = Position;
+  return std::error_code();
+}
+
+std::error_code nocturne::close(fs::file_t H) {
+  handleStates().forget(H);
+  n_result R = n_handle_close(H);
+  return R < 0 ? errorCode(R) : std::error_code();
+}
+
+namespace fs {
+
+const file_t kInvalidFile = -1;
+
+std::string getMainExecutable(const char *Argv0, void *MainAddr) {
+  // Nocturne does not tell an app where its program is: it is the one its
+  // name finds, as it did when the app was launched.
+  return Argv0 ? nocturne::findProgram(Argv0) : std::string();
+}
