+//
+// An app reads its launch settings with getenv and is handed its input and
+// output as handles 0, 1 and 2. The launcher names in the setting TERMINAL the
+// handles that reach a terminal, which understands ANSI escape codes.
+//
+//===----------------------------------------------------------------------===//
+
+#include "Nocturne.h"
+#include "llvm/Support/ErrorHandling.h"
