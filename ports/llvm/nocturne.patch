+std::error_code current_path(SmallVectorImpl<char> &Result) {
+  sandbox::violationIfEnabled();
+
+  return nocturne::completePath(".", Result);
+}
+
+std::error_code set_current_path(const Twine &Path) {
+  sandbox::violationIfEnabled();
+
+  SmallString<128> Storage;
+  n_result R = n_folder_set(Path.toNullTerminatedStringRef(Storage).data());
+  return R < 0 ? nocturne::errorCode(R) : std::error_code();
+}
+
+std::error_code create_directory(const Twine &Path, bool IgnoreExisting,
+                                 perms Perms) {
+  SmallString<256> Full;
+  if (std::error_code EC = nocturne::completePath(Path, Full))
+    return EC;
+  n_result R = n_folder_create(Full.data());
+  if (R < 0 && !(R == -N_ERR_EXISTS && IgnoreExisting))
+    return nocturne::errorCode(R);
+  return std::error_code();
+}
+
+// Nocturne has no links: an entry has one name.
+std::error_code create_symlink(const Twine &To, const Twine &From) {
+  return make_error_code(errc::function_not_supported);
+}
+
+std::error_code create_link(const Twine &To, const Twine &From) {
+  return make_error_code(errc::function_not_supported);
+}
+
+std::error_code create_hard_link(const Twine &To, const Twine &From) {
+  return make_error_code(errc::function_not_supported);
+}
+
+std::error_code remove(const Twine &Path, bool IgnoreNonExisting) {
+  SmallString<256> Full;
+  if (std::error_code EC = nocturne::completePath(Path, Full))
+    return EC;
+  n_result R = n_entry_remove(Full.data());
+  if (R < 0 && !(R == -N_ERR_NOT_FOUND && IgnoreNonExisting))
+    return nocturne::errorCode(R);
+  return std::error_code();
+}
+
+std::error_code is_local(const Twine &Path, bool &Result) {
+  sandbox::violationIfEnabled();
+
+  // C: is the one volume, and it is in the computer.
+  Result = true;
+  return std::error_code();
+}
+
+std::error_code is_local(int FD, bool &Result) {
+  sandbox::violationIfEnabled();
+
+  Result = true;
+  return std::error_code();
+}
+
+std::error_code rename(const Twine &From, const Twine &To) {
+  SmallString<256> FullFrom, FullTo;
+  if (std::error_code EC = nocturne::completePath(From, FullFrom))
+    return EC;
+  if (std::error_code EC = nocturne::completePath(To, FullTo))
+    return EC;
+  // A document already at To goes in the same commit.
+  n_result R = n_entry_replace(FullFrom.data(), FullTo.data());
+  return R < 0 ? nocturne::errorCode(R) : std::error_code();
+}
+
+std::error_code resize_file(int FD, uint64_t Size) {
+  n_result R = n_document_set_size(FD, Size);
+  return R < 0 ? nocturne::errorCode(R) : std::error_code();
+}
+
+std::error_code resize_file_sparse(int FD, uint64_t Size) {
+  return resize_file(FD, Size);
+}
+
+std::error_code access(const Twine &Path, AccessMode Mode) {
+  sandbox::violationIfEnabled();
+
+  SmallString<256> Full;
+  if (std::error_code EC = nocturne::completePath(Path, Full))
+    return EC;
+  n_entry Entry;
+  n_result R = n_entry_info(Full.data(), &Entry);
+  if (R < 0)
+    return nocturne::errorCode(R);
+  // A program is a document; a folder is never run.
+  if (Mode == AccessMode::Execute && Entry.kind != N_KIND_DOCUMENT)
+    return make_error_code(errc::permission_denied);
+  return std::error_code();
+}
+
+bool can_execute(const Twine &Path) {
+  sandbox::violationIfEnabled();
+
+  return !access(Path, AccessMode::Execute);
+}
+
+bool equivalent(file_status A, file_status B) {
+  assert(status_known(A) && status_known(B));
+  // A channel or a device has no entry, so no id.
+  return A.EntryID && A.EntryID == B.EntryID;
+}
+
+std::error_code equivalent(const Twine &A, const Twine &B, bool &Result) {
+  sandbox::violationIfEnabled();
+
+  file_status StatusA, StatusB;
+  if (std::error_code EC = status(A, StatusA))
+    return EC;
+  if (std::error_code EC = status(B, StatusB))
+    return EC;
+  Result = equivalent(StatusA, StatusB);
+  return std::error_code();
+}
+
+void expand_tilde(const Twine &Path, SmallVectorImpl<char> &Dest) {
+  // "~" is a name like any other: the user's folder is the setting
+  // USERFOLDER (path::home_directory).
+  Dest.clear();
+  Path.toVector(Dest);
+}
+
+static file_type entryType(const n_entry &Entry) {
+  return Entry.kind == N_KIND_FOLDER ? file_type::directory_file
+                                     : file_type::regular_file;
+}
+
+static std::error_code fillStatus(n_result R, const n_entry &Entry,
+                                  file_status &Result) {
+  if (R < 0) {
+    std::error_code EC = nocturne::errorCode(R);
+    Result = file_status(EC == errc::no_such_file_or_directory
+                             ? file_type::file_not_found
+                             : file_type::status_error);
+    return EC;
+  }
+  Result = file_status(entryType(Entry), all_all, Entry.id, Entry.modified,
+                       Entry.modified_ns, Entry.size);
+  return std::error_code();
+}
+
+std::error_code status(const Twine &Path, file_status &Result, bool Follow) {
+  sandbox::violationIfEnabled();
+
+  SmallString<256> Full;
+  if (std::error_code EC = nocturne::completePath(Path, Full)) {
+    Result = file_status(file_type::status_error);
+    return EC;
+  }
+  n_entry Entry;
+  return fillStatus(n_entry_info(Full.data(), &Entry), Entry, Result);
+}
+
+std::error_code status(int FD, file_status &Result) {
+  sandbox::violationIfEnabled();
+
+  n_entry Entry;
+  n_result Kind = n_handle_kind(FD);
+  if (Kind == N_KIND_DOCUMENT || Kind < 0)
+    return fillStatus(Kind < 0 ? Kind : n_document_info(FD, &Entry), Entry,
+                      Result);
+  // A channel carries an app's input or output, as a pipe does elsewhere.
+  file_type Type = Kind == N_KIND_CHANNEL  ? file_type::fifo_file
+                   : Kind == N_KIND_DEVICE ? file_type::character_file
+                   : Kind == N_KIND_FOLDER ? file_type::directory_file
+                                           : file_type::type_unknown;
+  Result = file_status(Type, all_all, 0, 0, 0, 0);
+  return std::error_code();
+}
+
+unsigned getUmask() { return 0; }
+
+// Everything may be read, written and run; the system's own entries refuse
+// changes whatever their permissions would say.
+std::error_code setPermissions(const Twine &Path, perms Permissions) {
+  return std::error_code();
+}
+
+std::error_code setPermissions(int FD, perms Permissions) {
+  return std::error_code();
+}
+
+std::error_code setLastAccessAndModificationTime(int FD, TimePoint<> AccessTime,
+                                                 TimePoint<> ModificationTime) {
+  // An entry's time is when it was last changed, and only the system sets it.
+  return make_error_code(errc::function_not_supported);
+}
+
+// A document cannot be mapped: a region holds a copy of its part, read when
+// it is made. Changes to that copy never reach the document, so a readwrite
+// region is not offered.
+std::error_code mapped_file_region::init(int FD, uint64_t Offset, mapmode Mode,
+                                         const char *Name) {
+  assert(Size != 0);
+
+  if (Mode == readwrite)
+    return make_error_code(errc::function_not_supported);
+  size_t Bytes = alignTo(Size, alignment());
+  void *Memory;
+  n_result R = n_memory_reserve(Bytes, N_MEMORY_READ_WRITE, &Memory);
+  if (R < 0)
+    return nocturne::errorCode(R);
+  // Past the document's end, the region reads as zero.
+  for (size_t Done = 0; Done < Size;) {
+    R = n_document_read_at(FD, Offset + Done,
+                           static_cast<char *>(Memory) + Done, Size - Done);
+    if (R <= 0)
+      break;
+    Done += R;
+  }
+  if (R >= 0 && Mode == readonly)
+    R = n_memory_protect(Memory, Bytes, N_MEMORY_READ);
+  if (R < 0) {
+    n_memory_release(Memory, Bytes);
+    return nocturne::errorCode(R);
+  }
+  Mapping = Memory;
+  return std::error_code();
+}
+
+mapped_file_region::mapped_file_region(int FD, mapmode Mode, size_t Length,
+                                       uint64_t Offset, std::error_code &EC,
+                                       const char *Name)
+    : Size(Length), Mode(Mode) {
+  sandbox::violationIfEnabled();
+
+  EC = init(FD, Offset, Mode, Name);
+  if (EC)
+    copyFrom(mapped_file_region());
+}
+
+void mapped_file_region::unmapImpl() {
+  if (Mapping)
+    n_memory_release(Mapping, alignTo(Size, alignment()));
+}
+
+std::error_code mapped_file_region::sync() const {
+  // Nothing of a region goes back to its document.
+  return std::error_code();
+}
