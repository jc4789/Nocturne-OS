+bool Process::ColorNeedsFlush() {
+  // No, colors are escape codes in the output.
+  return false;
+}
+
+const char *Process::OutputColor(char code, bool bold, bool bg) {
+  return colorcodes[bg ? 1 : 0][bold ? 1 : 0][code & 15];
+}
