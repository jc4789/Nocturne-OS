diff --git a/llvm/lib/Support/Nocturne/DynamicLibrary.inc b/llvm/lib/Support/Nocturne/DynamicLibrary.inc
new file mode 100644
index 00000000..2a45726d
--- /dev/null
+++ b/llvm/lib/Support/Nocturne/DynamicLibrary.inc
@@ -0,0 +1,48 @@
+//===- Nocturne/DynamicLibrary.inc - Nocturne DynamicLibrary ---*- C++ -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// A Nocturne program is linked whole: there are no libraries to load into a
+// running app, and its own symbols are not looked up by name. Only symbols
+// added with DynamicLibrary::AddSymbol and the C streams below are found.
+//
+//===----------------------------------------------------------------------===//
+
+#include <cstdio>
+#include <cstring>
+
+DynamicLibrary::HandleSet::~HandleSet() {
+  // llvm_shutdown called, Return to default
+  DynamicLibrary::SearchOrder = DynamicLibrary::SO_Linker;
+}
+
+void *DynamicLibrary::HandleSet::DLOpen(const char *File, std::string *Err) {
+  // The program itself (File is null) opens, as the set of handles like on
+  // Windows: the JIT asks for it before it looks a symbol up. Its own symbols
+  // are found only when they were added.
+  if (!File)
+    return &getGlobals().OpenedHandles;
+  if (Err)
+    *Err = "Nocturne loads no libraries into a running app";
+  return &Invalid;
+}
+
+void DynamicLibrary::HandleSet::DLClose(void *Handle) {}
+
+void *DynamicLibrary::HandleSet::DLSym(void *Handle, const char *Symbol) {
+  return nullptr;
+}
+
+static void *DoSearch(const char *SymbolName) {
+  if (!strcmp(SymbolName, "stdin"))
+    return &stdin;
+  if (!strcmp(SymbolName, "stdout"))
+    return &stdout;
+  if (!strcmp(SymbolName, "stderr"))
+    return &stderr;
+  return nullptr;
+}
diff --git a/llvm/lib/Support/Nocturne/Memory.inc b/llvm/lib/Support/Nocturne/Memory.inc
new file mode 100644
index 00000000..eeb0ffb1
--- /dev/null
+++ b/llvm/lib/Support/Nocturne/Memory.inc
@@ -0,0 +1,106 @@
+//===- Nocturne/Memory.inc - Nocturne Memory Implementation ----*- C++ -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// Nocturne's memory pages are zero-filled and readable, and either writable or
+// executable, never both. An app does not choose where they go.
+//
+//===----------------------------------------------------------------------===//
+
+#include "Nocturne.h"
+#include "llvm/Support/Alignment.h"
+#include "llvm/Support/Errc.h"
+#include "llvm/Support/MathExtras.h"
+#include "llvm/Support/Process.h"
+
+namespace llvm {
+namespace sys {
+
+// The access Nocturne gives for Flags, or 0 for none it gives.
+static int accessFor(unsigned Flags) {
+  switch (Flags & Memory::MF_RWE_MASK) {
+  case Memory::MF_READ:
+    return N_MEMORY_READ;
+  case Memory::MF_WRITE:
+  case Memory::MF_READ | Memory::MF_WRITE:
+    return N_MEMORY_READ_WRITE;
+  case Memory::MF_EXEC:
+  case Memory::MF_READ | Memory::MF_EXEC:
+    return N_MEMORY_READ_EXECUTE;
+  default:
+    return 0;
+  }
+}
+
+MemoryBlock Memory::allocateMappedMemory(size_t NumBytes,
+                                         const MemoryBlock *const NearBlock,
+                                         unsigned PFlags, std::error_code &EC) {
+  EC = std::error_code();
+  if (NumBytes == 0)
+    return MemoryBlock();
+  int Access = accessFor(PFlags);
+  if (!Access) {
+    EC = make_error_code(errc::permission_denied);
+    return MemoryBlock();
+  }
+
+  static const size_t PageSize = Process::getPageSizeEstimate();
+  size_t Bytes = alignTo(NumBytes, PageSize);
+  void *Address = nullptr;
+  n_result R = n_memory_reserve(Bytes, Access, &Address);
+  if (R < 0) {
+    EC = nocturne::errorCode(R);
+    return MemoryBlock();
+  }
+
+  MemoryBlock Result;
+  Result.Address = Address;
+  Result.AllocatedSize = Bytes;
+  Result.Flags = PFlags;
+  return Result;
+}
+
+std::error_code Memory::releaseMappedMemory(MemoryBlock &M) {
+  if (M.Address == nullptr || M.AllocatedSize == 0)
+    return std::error_code();
+
+  n_result R = n_memory_release(M.Address, M.AllocatedSize);
+  if (R < 0)
+    return nocturne::errorCode(R);
+
+  M.Address = nullptr;
+  M.AllocatedSize = 0;
+  return std::error_code();
+}
+
+std::error_code Memory::protectMappedMemory(const MemoryBlock &M,
+                                            unsigned Flags) {
+  if (M.Address == nullptr || M.AllocatedSize == 0)
+    return std::error_code();
+  if (!Flags)
+    return make_error_code(errc::invalid_argument);
+  int Access = accessFor(Flags);
+  if (!Access)
+    return make_error_code(errc::permission_denied);
+
+  static const Align PageSize = Align(Process::getPageSizeEstimate());
+  uintptr_t Start =
+      alignAddr((const uint8_t *)M.Address - PageSize.value() + 1, PageSize);
+  uintptr_t End =
+      alignAddr((const uint8_t *)M.Address + M.AllocatedSize, PageSize);
+  n_result R = n_memory_protect(reinterpret_cast<void *>(Start), End - Start,
+                                Access);
+  if (R < 0)
+    return nocturne::errorCode(R);
+  return std::error_code();
+}
+
+// x86-64 keeps instruction caches coherent with the writes.
+void Memory::InvalidateInstructionCache(const void *Addr, size_t Len) {}
+
+} // namespace sys
+} // namespace llvm
