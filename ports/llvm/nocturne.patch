diff --git a/llvm/lib/Support/Nocturne/Program.inc b/llvm/lib/Support/Nocturne/Program.inc
new file mode 100644
index 00000000..c9410c28
--- /dev/null
+++ b/llvm/lib/Support/Nocturne/Program.inc
@@ -0,0 +1,240 @@
+//===- Nocturne/Program.inc - Nocturne Program Implementation --*- C++ -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// An app is launched with n_app_launch from its program's complete path, with
+// its arguments, its settings and the handles it gets as 0, 1 and 2. Nothing
+// is inherited: the launcher passes its folder (FOLDER) and names the handles
+// that reach a terminal (TERMINAL). The app handle reports its end and result.
+//
+//===----------------------------------------------------------------------===//
+
+#include "Nocturne.h"
+#include "llvm/ADT/STLExtras.h"
+#include "llvm/ADT/ScopeExit.h"
+#include "llvm/ADT/SmallString.h"
+#include "llvm/Support/Errc.h"
+#include "llvm/Support/FileSystem.h"
+#include "llvm/Support/Path.h"
+#include "llvm/Support/raw_ostream.h"
+#include <string>
+#include <vector>
+
+using namespace llvm;
+using namespace sys;
+
+ProcessInfo::ProcessInfo() : Pid(0), Process(-1), ReturnCode(0) {}
+
+ErrorOr<std::string> sys::findProgramByName(StringRef Name,
+                                            ArrayRef<StringRef> Paths) {
+  assert(!Name.empty() && "Must have a name!");
+  // A name with a folder in it names the program itself.
+  if (Name.find_first_of("\\/:") != StringRef::npos)
+    return std::string(Name);
+
+  // There is no PATH: a program is in the system's folder or its app's.
+  if (Paths.empty()) {
+    std::string Program = nocturne::findProgram(Name);
+    if (Program.empty())
+      return errc::no_such_file_or_directory;
+    return Program;
+  }
+
+  for (StringRef Path : Paths) {
+    if (Path.empty())
+      continue;
+    SmallString<128> FilePath(Path);
+    path::append(FilePath, Name);
+    if (fs::can_execute(FilePath))
+      return std::string(FilePath);
+  }
+  return errc::no_such_file_or_directory;
+}
+
+// The handle the app gets as Index for a redirect: the document it names, or
+// none when it is empty. Output starts the document over; the app writes at
+// its end, so output and errors sent to one document follow each other.
+static Expected<fs::file_t> openRedirect(StringRef Path, int Index) {
+  if (Path.empty())
+    return fs::kInvalidFile;
+  if (Index == 0)
+    return fs::openNativeFileForRead(Path);
+  Expected<fs::file_t> H =
+      fs::openNativeFileForWrite(Path, fs::CD_OpenAlways, fs::OF_None);
+  if (!H)
+    return H;
+  if (std::error_code EC = fs::resize_file(*H, 0)) {
+    fs::closeFile(*H);
+    return errorCodeToError(EC);
+  }
+  return H;
+}
+
+static bool Execute(ProcessInfo &PI, StringRef Program,
+                    ArrayRef<StringRef> Args,
+                    std::optional<ArrayRef<StringRef>> Env,
+                    ArrayRef<std::optional<StringRef>> Redirects,
+                    unsigned MemoryLimit, std::string *ErrMsg,
+                    BitVector *AffinityMask, bool DetachProcess) {
+  assert(!AffinityMask && "Nocturne does not place an app on chosen CPUs");
+  // Nocturne has no memory limit to set for an app, so MemoryLimit is unused.
+
+  SmallString<256> Path;
+  if (std::error_code EC = nocturne::completePath(Program, Path)) {
+    nocturne::setErrMsg(ErrMsg, "cannot find '" + Program + "'", EC);
+    return false;
+  }
+
+  // This app's own handle, a document a redirect names, or none.
+  int32_t Handles[3];
+  fs::file_t Opened[3] = {fs::kInvalidFile, fs::kInvalidFile,
+                          fs::kInvalidFile};
+  scope_exit CloseOpened([&] {
+    for (fs::file_t H : Opened)
+      if (H != fs::kInvalidFile)
+        fs::closeFile(H);
+  });
+  std::string Terminal;
+  for (int I = 0; I < 3; ++I) {
+    if (!Redirects.empty() && Redirects[I]) {
+      Expected<fs::file_t> H = openRedirect(*Redirects[I], I);
+      if (!H) {
+        nocturne::setErrMsg(ErrMsg,
+                            "cannot open '" + *Redirects[I] + "' for " +
+                                (I ? "output" : "input"),
+                            errorToErrorCode(H.takeError()));
+        return false;
+      }
+      Handles[I] = Opened[I] = *H;
+      continue;
+    }
+    Handles[I] = n_handle_kind(I) >= 0 ? I : -1;
+    if (Handles[I] >= 0 && n_terminal(I))
+      Terminal += (Terminal.empty() ? "" : " ") + std::to_string(I);
+  }
+
+  std::vector<std::string> Settings;
+  if (Env)
+    for (StringRef Setting : *Env)
+      Settings.push_back(Setting.str());
+  auto Given = [&](StringRef Name) {
+    return any_of(Settings, [&](StringRef Setting) {
+      return Setting.size() > Name.size() && Setting.starts_with(Name) &&
+             Setting[Name.size()] == '=';
+    });
+  };
+  if (!Given("FOLDER")) {
+    SmallString<256> Folder;
+    if (!nocturne::completePath(".", Folder))
+      Settings.push_back(("FOLDER=" + Folder).str());
+  }
+  // A detached app is not part of this app's terminal session.
+  if (!DetachProcess && !Terminal.empty() && !Given("TERMINAL"))
+    Settings.push_back("TERMINAL=" + Terminal);
+
+  std::vector<std::string> ArgStrings(Args.begin(), Args.end());
+  std::vector<const char *> Arguments, SettingPointers;
+  for (const std::string &Arg : ArgStrings)
+    Arguments.push_back(Arg.c_str());
+  for (const std::string &Setting : Settings)
+    SettingPointers.push_back(Setting.c_str());
+
+  struct n_launch Launch = {};
+  Launch.arguments = Arguments.data();
+  Launch.settings = SettingPointers.data();
+  Launch.handles = Handles;
+  Launch.argument_count = static_cast<uint32_t>(Arguments.size());
+  Launch.setting_count = static_cast<uint32_t>(SettingPointers.size());
+  Launch.handle_count = 3;
+  n_handle App = n_app_launch(Path.c_str(), &Launch);
+  if (App < 0) {
+    nocturne::setErrMsg(ErrMsg, "cannot launch '" + Program + "'",
+                        nocturne::errorCode(App));
+    return false;
+  }
+
+  PI.Pid = n_app_id(App);
+  PI.Process = App;
+  return true;
+}
+
+ProcessInfo llvm::sys::Wait(const ProcessInfo &PI,
+                            std::optional<unsigned> SecondsToWait,
+                            std::string *ErrMsg,
+                            std::optional<ProcessStatistics> *ProcStat,
+                            bool Polling) {
+  assert(PI.Pid && "invalid pid to wait on, process not started?");
+  // Nocturne does not tell what an app took to run.
+  if (ProcStat)
+    ProcStat->reset();
+
+  int64_t TimeoutMs = SecondsToWait ? int64_t(*SecondsToWait) * 1000 : -1;
+  int Status = 0;
+  n_result R = n_app_result(PI.Process, TimeoutMs, &Status);
+  if (R == -N_ERR_NOT_READY || (R == -N_ERR_TIMEOUT && Polling))
+    return ProcessInfo(); // It is still running.
+
+  ProcessInfo WaitResult = PI;
+  if (R == -N_ERR_TIMEOUT) {
+    // Stop it and the apps it launched, and wait for its end.
+    n_app_stop(PI.Process, N_APP_STOP_TREE);
+    n_app_result(PI.Process, -1, &Status);
+    n_handle_close(PI.Process);
+    if (ErrMsg)
+      *ErrMsg = "Child timed out";
+    WaitResult.ReturnCode = -2;
+    return WaitResult;
+  }
+  n_handle_close(PI.Process);
+  if (R < 0) {
+    nocturne::setErrMsg(ErrMsg, "Error waiting for child process",
+                        nocturne::errorCode(R));
+    WaitResult.ReturnCode = -1;
+    return WaitResult;
+  }
+  // An app the system ended has a result like any other: 128 and the
+  // exception's number for a fault, 130 when it was stopped.
+  WaitResult.ReturnCode = Status;
+  return WaitResult;
+}
+
+std::error_code llvm::sys::ChangeStdinMode(fs::OpenFlags Flags) {
+  return std::error_code();
+}
+
+std::error_code llvm::sys::ChangeStdoutMode(fs::OpenFlags Flags) {
+  return std::error_code();
+}
+
+// Documents and channels carry bytes as they are; text is not translated.
+std::error_code llvm::sys::ChangeStdinToBinary() { return std::error_code(); }
+
+std::error_code llvm::sys::ChangeStdoutToBinary() { return std::error_code(); }
+
+std::error_code
+llvm::sys::writeFileWithEncoding(StringRef FileName, StringRef Contents,
+                                 WindowsEncodingMethod Encoding /*unused*/) {
+  std::error_code EC;
+  raw_fd_ostream OS(FileName, EC, fs::OF_None);
+  if (EC)
+    return EC;
+  OS << Contents;
+  OS.close();
+  EC = OS.error();
+  OS.clear_error();
+  return EC;
+}
+
+bool llvm::sys::commandLineFitsWithinSystemLimits(StringRef Program,
+                                                  ArrayRef<StringRef> Args) {
+  // The arguments take a string and a pointer each; leave the settings half
+  // of the room the launch has for both.
+  uint64_t Bytes = 8;
+  for (StringRef Arg : Args)
+    Bytes += Arg.size() + 1 + 8;
+  return Bytes <= N_LAUNCH_MAX_BYTES / 2;
+}
diff --git a/llvm/lib/Support/Nocturne/Signals.inc b/llvm/lib/Support/Nocturne/Signals.inc
new file mode 100644
index 00000000..7e7539f1
--- /dev/null
+++ b/llvm/lib/Support/Nocturne/Signals.inc
@@ -0,0 +1,146 @@
+//===- Nocturne/Signals.inc - Nocturne Signals Implementation --*- C++ -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// Nocturne has no signals. An app that faults ends, and the system reports
+// where; one that is stopped (Ctrl+C in a terminal) just ends. Neither runs
+// code of the app's, but neither leaves half of an output either: a document
+// an app replaces (fs::CD_CreateAlways) keeps its old content until the new one
+// is saved whole. What LLVM removes when it gives up (RunInterruptHandlers, as
+// report_fatal_error does) it removes here.
+//
+//===----------------------------------------------------------------------===//
+
+#include "Nocturne.h"
+#include "llvm/Support/ExitCodes.h"
+#include "llvm/Support/StringSaver.h"
+#include <atomic>
+#include <cstdlib>
+#include <mutex>
+#include <string>
+#include <vector>
+
+using namespace llvm;
+
+static StringRef Argv0;
+
+static std::atomic<void (*)()> OneShotPipeSignalFunction = nullptr;
+
+namespace {
+// The documents RemoveFileOnSignal named, by complete path: the app's folder
+// may change before they are removed.
+struct FilesToRemove {
+  std::mutex Lock;
+  std::vector<std::string> Paths;
+};
+} // namespace
+
+// Never destroyed: report_fatal_error may run while the app exits.
+static FilesToRemove &filesToRemove() {
+  static FilesToRemove *Files = new FilesToRemove();
+  return *Files;
+}
+
+static void removeFilesToRemove() {
+  FilesToRemove &Files = filesToRemove();
+  std::lock_guard<std::mutex> Guard(Files.Lock);
+  for (const std::string &Path : Files.Paths) {
+    // Only a document: never a folder that took its name since.
+    struct n_entry Entry;
+    if (n_entry_info(Path.c_str(), &Entry) >= 0 &&
+        Entry.kind == N_KIND_DOCUMENT)
+      n_entry_remove(Path.c_str());
+  }
+}
+
+static std::string completeName(StringRef Filename) {
+  SmallString<256> Path;
+  if (sys::nocturne::completePath(Filename, Path))
+    return Filename.str();
+  return std::string(Path);
+}
+
+void sys::unregisterHandlers() {}
+
+void sys::CleanupOnSignal(uintptr_t Context) {
+  removeFilesToRemove();
+  llvm::sys::RunSignalHandlers();
+}
+
+void sys::RunInterruptHandlers() { removeFilesToRemove(); }
+
+// There is no interrupt or information request for an app to answer.
+void llvm::sys::SetInterruptFunction(void (*IF)()) {}
+
+void llvm::sys::SetInfoSignalFunction(void (*Handler)()) {}
+
+void llvm::sys::SetOneShotPipeSignalFunction(void (*Handler)()) {
+  OneShotPipeSignalFunction.exchange(Handler);
+}
+
+void llvm::sys::DefaultOneShotPipeSignalHandler() { exit(EX_IOERR); }
+
+// A write found that no one reads the channel any more.
+void llvm::sys::CallOneShotPipeSignalHandler() {
+  if (auto Handler = OneShotPipeSignalFunction.exchange(nullptr))
+    Handler();
+}
+
+bool llvm::sys::RemoveFileOnSignal(StringRef Filename, std::string *ErrMsg) {
+  std::string Path = completeName(Filename);
+  FilesToRemove &Files = filesToRemove();
+  std::lock_guard<std::mutex> Guard(Files.Lock);
+  Files.Paths.push_back(std::move(Path));
+  return false;
+}
+
+void llvm::sys::DontRemoveFileOnSignal(StringRef Filename) {
+  std::string Path = completeName(Filename);
+  FilesToRemove &Files = filesToRemove();
+  std::lock_guard<std::mutex> Guard(Files.Lock);
+  llvm::erase(Files.Paths, Path);
+}
+
+void llvm::sys::AddSignalHandler(sys::SignalHandlerCallback FnPtr, void *Cookie,
+                                 bool NeedsPOSIXUtilitySignalHandling) {
+  insertSignalHandler(FnPtr, Cookie);
+}
+
+// A program is one image, linked where it runs: an address is its own offset.
+static bool findModulesAndOffsets(void **StackTrace, int Depth,
+                                  const char **Modules, intptr_t *Offsets,
+                                  const char *MainExecutableName,
+                                  StringSaver &StrPool) {
+  if (!MainExecutableName || !*MainExecutableName)
+    return false;
+  const char *Module = StrPool.save(MainExecutableName).data();
+  for (int I = 0; I < Depth; ++I) {
+    Modules[I] = Module;
+    Offsets[I] = reinterpret_cast<intptr_t>(StackTrace[I]);
+  }
+  return true;
+}
+
+static bool printMarkupContext(raw_ostream &OS,
+                               const char *MainExecutableName) {
+  return false;
+}
+
+// Nocturne does not yet give an app the frames of its stack.
+void llvm::sys::PrintStackTrace(raw_ostream &OS, int Depth) {}
+
+static void PrintStackTraceSignalHandler(void *) {
+  sys::PrintStackTrace(llvm::errs());
+}
+
+void llvm::sys::DisableSystemDialogsOnCrash() {}
+
+void llvm::sys::PrintStackTraceOnErrorSignal(StringRef Argv0,
+                                             bool DisableCrashReporting) {
+  ::Argv0 = Argv0;
+  AddSignalHandler(PrintStackTraceSignalHandler, nullptr);
+}
diff --git a/llvm/lib/Support/Nocturne/Threading.inc b/llvm/lib/Support/Nocturne/Threading.inc
new file mode 100644
index 00000000..4921d980
--- /dev/null
+++ b/llvm/lib/Support/Nocturne/Threading.inc
@@ -0,0 +1,83 @@
+//===- Nocturne/Threading.inc - Nocturne Threading Impl. -------*- C++ -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// Threads are Nocturne's native tasks: they share the process and are named by
+// the id thread_create gives them. The scheduler places them on its CPUs;
+// threads have no names, priorities or affinity to set.
+//
+//===----------------------------------------------------------------------===//
+
+#include "llvm/ADT/BitVector.h"
+#include "llvm/ADT/SmallVector.h"
+#include "llvm/ADT/Twine.h"
+#include "llvm/Support/ErrorHandling.h"
+#include "llvm/Support/thread.h"
+#include <nocturne.h>
+
+namespace llvm {
+
+thread::native_handle_type
+llvm_execute_on_thread_impl(thread::start_routine_type ThreadFunc, void *Arg,
+                            std::optional<unsigned> StackSizeInBytes) {
+  n_result Thread =
+      thread_create_sized(ThreadFunc, Arg, StackSizeInBytes.value_or(0));
+  if (Thread < 0)
+    report_fatal_error("thread_create failed: " + Twine(n_result_text(Thread)));
+  return static_cast<thread::native_handle_type>(Thread);
+}
+
+void llvm_thread_join_impl(thread::native_handle_type Thread) {
+  n_result R = thread_join(Thread);
+  if (R < 0)
+    report_fatal_error("thread_join failed: " + Twine(n_result_text(R)));
+}
+
+void llvm_thread_detach_impl(thread::native_handle_type Thread) {
+  n_result R = thread_detach(Thread);
+  if (R < 0)
+    report_fatal_error("thread_detach failed: " + Twine(n_result_text(R)));
+}
+
+thread::id llvm_thread_get_id_impl(thread::native_handle_type Thread) {
+  return Thread;
+}
+
+thread::id llvm_thread_get_current_id_impl() { return thread_id(); }
+
+} // namespace llvm
+
+uint64_t llvm::get_threadid() { return static_cast<uint64_t>(thread_id()); }
+
+uint32_t llvm::get_max_thread_name_length() { return 0; }
+
+void llvm::set_thread_name(const Twine &Name) {}
+
+void llvm::get_thread_name(SmallVectorImpl<char> &Name) { Name.clear(); }
+
+llvm::SetThreadPriorityResult
+llvm::set_thread_priority(ThreadPriority Priority) {
+  return SetThreadPriorityResult::FAILURE;
+}
+
+// The CPUs the scheduler runs threads on.
+static int computeHostNumHardwareThreads() {
+  struct n_cpuinfo Info = {};
+  if (cpu_info(&Info) < 0 || Info.scheduler_cpus == 0)
+    return 1;
+  return static_cast<int>(Info.scheduler_cpus);
+}
+
+void llvm::ThreadPoolStrategy::apply_thread_strategy(
+    unsigned ThreadPoolNum) const {}
+
+llvm::BitVector llvm::get_thread_affinity_mask() { return {}; }
+
+unsigned llvm::get_cpus() { return 1; }
+
+// Nocturne does not tell cores from hardware threads.
+int llvm::get_physical_cores() { return computeHostNumHardwareThreads(); }
