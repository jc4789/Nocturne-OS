diff --git a/clang/lib/Driver/ToolChains/Nocturne.cpp b/clang/lib/Driver/ToolChains/Nocturne.cpp
new file mode 100644
index 00000000..085a6143
--- /dev/null
+++ b/clang/lib/Driver/ToolChains/Nocturne.cpp
@@ -0,0 +1,153 @@
+//===--- Nocturne.cpp - Nocturne OS ToolChain Implementation ----*- C++ -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#include "Nocturne.h"
+#include "clang/Driver/CommonArgs.h"
+#include "clang/Driver/Compilation.h"
+#include "clang/Driver/Driver.h"
+#include "clang/Options/Options.h"
+#include "llvm/Option/ArgList.h"
+#include "llvm/Support/Path.h"
+
+using namespace clang::driver;
+using namespace clang::driver::toolchains;
+using namespace clang;
+using namespace llvm::opt;
+
+void tools::nocturne::Linker::ConstructJob(Compilation &C, const JobAction &JA,
+                                           const InputInfo &Output,
+                                           const InputInfoList &Inputs,
+                                           const ArgList &Args,
+                                           const char *LinkingOutput) const {
+  const ToolChain &TC = getToolChain();
+  const Driver &D = TC.getDriver();
+  ArgStringList CmdArgs;
+
+  // A program is one static executable at the address the SDK's linker script
+  // gives it; Nocturne loads no shared or position-independent objects.
+  for (Arg *A : Args.filtered(options::OPT_shared, options::OPT_pie,
+                              options::OPT_static_pie, options::OPT_rdynamic))
+    D.Diag(diag::err_drv_unsupported_opt_for_target)
+        << A->getAsString(Args) << TC.getTripleString();
+  Args.ClaimAllArgs(options::OPT_static);
+  Args.ClaimAllArgs(options::OPT_no_pie);
+
+  const bool Relocatable = Args.hasArg(options::OPT_r);
+  const bool NoStdLib = Relocatable || Args.hasArg(options::OPT_nostdlib);
+  const bool NoStartFiles = NoStdLib || Args.hasArg(options::OPT_nostartfiles);
+  const bool NoDefaultLibs = NoStdLib || Args.hasArg(options::OPT_nodefaultlibs);
+
+  if (!Relocatable) {
+    CmdArgs.push_back("-static");
+    CmdArgs.push_back("--no-dynamic-linker");
+    CmdArgs.push_back("-z");
+    CmdArgs.push_back("max-page-size=0x1000");
+    // The SDK's libraries have a section for each function and variable, and
+    // a static program needs only those it reaches (-Wl,--no-gc-sections keeps
+    // them all).
+    CmdArgs.push_back("--gc-sections");
+    // user.ld places the program at 0x400000 and gives the C library its
+    // init/fini arrays and the thread-local image.
+    if (!Args.hasArg(options::OPT_T)) {
+      CmdArgs.push_back("-T");
+      CmdArgs.push_back(Args.MakeArgString(TC.GetFilePath("user.ld")));
+    }
+    // libunwind finds the handler of a C++ exception through this index of
+    // the unwind tables, which user.ld names.
+    CmdArgs.push_back("--eh-frame-hdr");
+  }
+
+  assert((Output.isFilename() || Output.isNothing()) && "Invalid output.");
+  if (Output.isFilename()) {
+    CmdArgs.push_back("-o");
+    CmdArgs.push_back(Output.getFilename());
+  }
+
+  if (!NoStartFiles)
+    CmdArgs.push_back(Args.MakeArgString(TC.GetFilePath("crt1.o")));
+
+  Args.addAllArgs(CmdArgs, {options::OPT_L, options::OPT_u});
+  TC.AddFilePathLibArgs(Args, CmdArgs);
+
+  if (auto LTO = TC.getLTOMode(Args); LTO != LTOK_None)
+    addLTOOptions(TC, Args, CmdArgs, Output, Inputs, LTO == LTOK_Thin);
+
+  Args.addAllArgs(CmdArgs, {options::OPT_T_Group, options::OPT_s,
+                            options::OPT_t, options::OPT_r});
+  addLinkerCompressDebugSectionsOption(TC, Args, CmdArgs);
+  AddLinkerInputs(TC, Inputs, Args, CmdArgs, JA);
+
+  if (!NoDefaultLibs) {
+    if (TC.ShouldLinkCXXStdlib(Args))
+      TC.AddCXXStdlibLibArgs(Args, CmdArgs);
+    if (!Args.hasArg(options::OPT_nolibc))
+      CmdArgs.push_back("-lc");
+    // The compiler's own runtime comes last: the C library may call it too.
+    AddRunTimeLibs(TC, D, CmdArgs, Args);
+  }
+  Args.ClaimAllArgs(options::OPT_stdlib_EQ);
+
+  const char *Exec = Args.MakeArgString(TC.GetLinkerPath());
+  C.addCommand(std::make_unique<Command>(JA, *this,
+                                         ResponseFileSupport::AtFileCurCP(),
+                                         Exec, CmdArgs, Inputs, Output));
+}
+
+Nocturne::Nocturne(const Driver &D, const llvm::Triple &Triple,
+                   const ArgList &Args)
+    : ToolChain(D, Triple, Args) {
+  getProgramPaths().push_back(getDriver().Dir);
+  SmallString<128> Lib(computeSysRoot());
+  llvm::sys::path::append(Lib, "Lib");
+  getFilePaths().push_back(std::string(Lib));
+}
+
+std::string Nocturne::computeSysRoot() const {
+  if (!getDriver().SysRoot.empty())
+    return getDriver().SysRoot;
+  return "C:\\Nocturne\\SDK";
+}
+
+Tool *Nocturne::buildLinker() const { return new tools::nocturne::Linker(*this); }
+
+void Nocturne::AddClangSystemIncludeArgs(const ArgList &DriverArgs,
+                                         ArgStringList &CC1Args) const {
+  if (DriverArgs.hasArg(options::OPT_nostdinc))
+    return;
+
+  if (!DriverArgs.hasArg(options::OPT_nobuiltininc)) {
+    SmallString<128> P(getDriver().ResourceDir);
+    llvm::sys::path::append(P, "include");
+    addSystemInclude(DriverArgs, CC1Args, P);
+  }
+
+  if (DriverArgs.hasArg(options::OPT_nostdlibinc))
+    return;
+
+  SmallString<128> P(computeSysRoot());
+  llvm::sys::path::append(P, "Include");
+  addSystemInclude(DriverArgs, CC1Args, P);
+}
+
+void Nocturne::AddClangCXXStdlibIncludeArgs(const ArgList &DriverArgs,
+                                            ArgStringList &CC1Args) const {
+  if (DriverArgs.hasArg(options::OPT_nostdinc, options::OPT_nostdlibinc,
+                        options::OPT_nostdincxx))
+    return;
+
+  switch (GetCXXStdlibType(DriverArgs)) {
+  case ToolChain::CST_Libcxx: {
+    SmallString<128> P(computeSysRoot());
+    llvm::sys::path::append(P, "Include", "c++", "v1");
+    addSystemInclude(DriverArgs, CC1Args, P);
+    break;
+  }
+  default:
+    llvm_unreachable("invalid stdlib name");
+  }
+}
