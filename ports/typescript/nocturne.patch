@@ -0,0 +1,11 @@
+//go:build !nocturne
+
+package main
+
+import (
+	"os"
+	"syscall"
+)
+
+// stopSignals end a compilation or server early.
+var stopSignals = []os.Signal{os.Interrupt, syscall.SIGTERM}
diff -ruN a/tsc/cmd/tsc/stopsignals_nocturne.go b/tsc/cmd/tsc/stopsignals_nocturne.go
--- a/tsc/cmd/tsc/stopsignals_nocturne.go
+++ b/tsc/cmd/tsc/stopsignals_nocturne.go
@@ -0,0 +1,7 @@
+package main
+
+import "os"
+
+// stopSignals end a compilation or server early. Nocturne stops an app
+// outright (AppStop) and delivers no termination signal.
+var stopSignals = []os.Signal{os.Interrupt}
