{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/mokei.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/mokei.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/mokei.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
